+#define PCIE_REV1_2_AXI_CTRL_GLOBAL_PARITY_CALC_EN_SLV (1 << 18)
+#define PCIE_REV3_4_AXI_CTRL_GLOBAL_PARITY_CALC_EN_SLV (1 << 20)
