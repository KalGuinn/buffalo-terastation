+static al_mod_bool rx_valid(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	struct al_mod_srd_1lane_regs __iomem *lane_regs;
+
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	lane_regs = obj->regs_base;
+
+	return !!(obj->complex_obj->reg_read32(&lane_regs->gen.status) &
+		SRD_1LANE_GEN_STATUS_RX_RDY);
+}
+
+static int ical_start(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	al_mod_bool pcal_adaptive_is_en;
+	int err;
+
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	/* Stop pCal adaptive */
+	pcal_adaptive_is_en = pcal_adaptive_is_enabled(obj, AL_SRDS_LANE_0);
+
+	if (pcal_adaptive_is_en) {
+		err = pcal_adaptive_stop(obj, lane);
+		if (err)
+			return err;
+	}
+
+	/* DWELL bit setting (influence on calibration time) */
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_BIG_REG_SEL_REG_NUM,
+		BIG_REG_DFE_TUNING_DWELL_TIME_REG_NUM);
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_BIG_REG_WRITE_REG_NUM, 0x1999);
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_BIG_REG_WRITE_REG_NUM, 0x0);
+
+	/* Disable auto pCal */
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_SET_RX_EQ_REG_NUM,
+		CORE_INT_SET_RX_EQ_AUTO_PCAL_DIS);
+
+	/* Run iCal with fixed DC */
+	al_mod_dbg("%s: Running iCal with fixed DC...\n", __func__);
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_DFE_CTRL_REG_NUM,
+		CORE_INT_DFE_CTRL_RUN_ICAL | CORE_INT_DFE_CTRL_FIXED_DC);
+
+	return 0;
+}
+
+static void ical_restore_dwell(
+	struct al_mod_serdes_grp_obj	*obj)
+{
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_BIG_REG_SEL_REG_NUM,
+		BIG_REG_DFE_TUNING_DWELL_TIME_REG_NUM);
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_BIG_REG_WRITE_REG_NUM, 0x1);
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_BIG_REG_WRITE_REG_NUM, 0x1);
+}
+
+static al_mod_bool ical_is_done(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	unsigned int val;
+
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	val = al_mod_serdes_avg_core_interrupt(obj, CORE_INT_GET_DFE_REG_NUM,
+		CORE_INT_GET_DFE_VAL_DFE_STATUS);
+
+	if (val != CORE_INT_GET_DFE_VAL_DFE_STATUS_IOC_COMPLETE)
+		return AL_FALSE;
+
+	/* Restore DWELL bit setting */
+	ical_restore_dwell(obj);
+
+	al_mod_dbg("%s: iCal done\n", __func__);
+
+	/* Clear the signal loss sticky indication */
+	al_mod_serdes_avg_signal_loss_sticky_get(obj, AL_TRUE);
+
+	return AL_TRUE;
+}
+
+static int ical_wait_for_completion(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	unsigned int i;
+
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	/* Poll on iCal completion */
+	for (i = 0; i < ICAL_TRIES; ++i) {
+		if (ical_is_done(obj, lane))
+			break;
+
+		al_mod_msleep(ICAL_MDELAY);
+	}
+
+	/* Exit if iCal failed */
+	if (i >= ICAL_TRIES) {
+		/* Restore DWELL bit setting */
+		ical_restore_dwell(obj);
+
+		al_mod_err("%s: iCal Timeout!\n", __func__);
+		return -ETIMEDOUT;
+	}
+
+	return 0;
+}
+
+static int pcal_start(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	AL_INFO("%s: Running single pCal...\n", __func__);
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_DFE_CTRL_REG_NUM,
+		CORE_INT_DFE_CTRL_RUN_PCAL_SINGLE);
+
+	return 0;
+}
+
+static al_mod_bool pcal_is_done(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	unsigned int val;
+
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	val = al_mod_serdes_avg_core_interrupt(obj, CORE_INT_GET_DFE_REG_NUM,
+		CORE_INT_GET_DFE_VAL_DFE_STATUS);
+
+	if (val != CORE_INT_GET_DFE_VAL_DFE_STATUS_IOC_COMPLETE)
+		return AL_FALSE;
+
+	AL_INFO("%s: pCal done\n", __func__);
+
+	return AL_TRUE;
+}
+
+static int pcal_wait_for_completion(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	unsigned int i;
+
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	/* Poll on pCal completion */
+	for (i = 0; i < PCAL_TRIES; ++i) {
+		if (pcal_is_done(obj, lane))
+			break;
+
+		al_mod_msleep(PCAL_MDELAY);
+	}
+
+	/* Exit if pCal failed */
+	if (i >= PCAL_TRIES) {
+		al_mod_err("%s: pCal Timeout!\n", __func__);
+		return -ETIMEDOUT;
+	}
+
+	return 0;
+}
+
+static al_mod_bool pcal_adaptive_is_enabled(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	unsigned int val;
+	al_mod_bool pcal_adaptive_is_en;
+
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	val = al_mod_serdes_avg_core_interrupt(obj, CORE_INT_GET_DFE_REG_NUM,
+			CORE_INT_GET_DFE_VAL_DFE_STATUS);
+	pcal_adaptive_is_en = (val == CORE_INT_GET_DFE_VAL_DFE_STATUS_PCAL_ADAPTIVE_EN);
+
+	return pcal_adaptive_is_en;
+}
+
+static int pcal_adaptive_start(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	int i;
+
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	al_mod_dbg("%s: Initiating adaptive pCal...\n", __func__);
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_DFE_CTRL_REG_NUM,
+		CORE_INT_DFE_CTRL_RUN_PCAL_ADAPTIVE | CORE_INT_DFE_CTRL_FIXED_DC);
+	/* Poll on adaptive pCal enablement */
+	for (i = 0; i < PCAL_ADAPTIVE_TRIES; ++i) {
+		if (pcal_adaptive_is_enabled(obj, lane))
+			break;
+		al_mod_msleep(PCAL_ADAPTIVE_MDELAY);
+	}
+	/* Exit if pCal failed */
+	if (i >= PCAL_ADAPTIVE_TRIES) {
+		al_mod_err("%s: adaptive pCal enablement timeout!\n", __func__);
+		return -ETIMEDOUT;
+	}
+	al_mod_dbg("%s: adaptive pCal initiated\n", __func__);
+
+	return 0;
+}
+
+static int pcal_adaptive_stop(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	int i;
+
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	/* Disable adaptive pCal by running single pCal with fixed DC */
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_DFE_CTRL_REG_NUM,
+		CORE_INT_DFE_CTRL_RUN_PCAL_SINGLE | CORE_INT_DFE_CTRL_FIXED_DC);
+	/* Poll on pCal completion */
+	for (i = 0; i < PCAL_FIXED_DC_TRIES; ++i) {
+		unsigned int val = al_mod_serdes_avg_core_interrupt(obj,
+			CORE_INT_GET_DFE_REG_NUM, CORE_INT_GET_DFE_VAL_DFE_STATUS);
+
+		if (val == CORE_INT_GET_DFE_VAL_DFE_STATUS_IOC_COMPLETE)
+			break;
+		al_mod_msleep(PCAL_FIXED_DC_MDELAY);
+	}
+
+	/* Exit if pCal failed */
+	if (i >= PCAL_FIXED_DC_TRIES) {
+		al_mod_err("%s: pCal Timeout!\n", __func__);
+		return -ETIMEDOUT;
+	}
+
+	return 0;
+}
+
+static int rx_equalization(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	int err;
+
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	/* iCal with fixed DC */
+	err = ical_start(obj, lane);
+	if (err)
+		return err;
+
+	err = ical_wait_for_completion(obj, lane);
+	if (err)
+		return err;
+
+	/* Initiate adaptive pCal */
+	err = pcal_adaptive_start(obj, lane);
+	if (err)
+		return err;
+
+	return 0;
+}
+
+static al_mod_bool signal_is_detected(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	al_mod_bool sig_detected_final = AL_FALSE;
+	unsigned int sig_detected_cnt = 0;
+	unsigned int i;
+
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	/* Enable idle detector with specific threshold */
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_IDLE_DETECTOR_REG_NUM,
+		CORE_INT_IDLE_DETECTOR_RX_IDLE_DETECTOR_EN);
+
+	/* Check signal several times and consider detected if passed threshold */
+	for (i = 0; i < SIG_DETECT_NUM_READS; i++) {
+		if (!(al_mod_serdes_avg_core_interrupt(obj,
+			CORE_INT_ESB_REG_RD(ESB_REG_SIG_STAT_REG_NUM), 0) &
+			ESB_REG_SIG_STAT_SIG_DETECTED_N)) {
+			sig_detected_cnt++;
+			if (sig_detected_cnt >= SIG_DETECT_CNT_THR) {
+				sig_detected_final = AL_TRUE;
+				break;
+			}
+		}
+
+		al_mod_udelay(SIG_DETECT_READ_DELAY);
+	}
+
+	/* Disable idle detector */
+	al_mod_serdes_avg_core_interrupt(obj, CORE_INT_IDLE_DETECTOR_REG_NUM, 0);
+
+	return sig_detected_final;
+}
+
+static al_mod_bool cdr_is_locked(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+
+	return !al_mod_serdes_avg_signal_loss_sticky_get(obj, AL_TRUE);
+}
+
+/*
+ * Masks of interrupts groups
+ */
+/* group A */
+#define AL_SRDS_AVG_INT_GROUP_A_SUM \
+		AL_SRDS_AVG_INT_GROUP_A_DOUBLE_BIT_ERROR_INDICATION_IN_SERDES_MEMORY
+
+static void error_masks_get(struct al_mod_serdes_grp_obj *obj,
+		uint32_t *a, uint32_t *b, uint32_t *c, uint32_t *d)
+{
+	al_mod_assert(obj);
+	al_mod_assert(a);
+	al_mod_assert(b);
+	al_mod_assert(c);
+	al_mod_assert(d);
+
+	*a = AL_SRDS_AVG_INT_GROUP_A_SUM;
+	*b = 0;
+	*c = 0;
+	*d = 0;
+}
+
+static void error_ints_unmask(struct al_mod_serdes_grp_obj	*obj)
+{
+	uint32_t a, b, c, d;
+
+	obj->error_masks_get(obj, &a, &b, &c, &d);
+
+	al_mod_iofic_config(obj->int_mem_base,
+		AL_INT_GROUP_A,
+		INT_CONTROL_GRP_MASK_MSI_X);
+
+	al_mod_iofic_clear_cause(obj->int_mem_base,
+		AL_INT_GROUP_A,
+		a);
+
+	al_mod_iofic_unmask(obj->int_mem_base,
+		AL_INT_GROUP_A,
+		a);
+}
