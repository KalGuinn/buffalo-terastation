+{
+
+	al_mod_assert(idx < AL_ETH_RX_FSM_TABLE_SIZE); /*valid FSM index*/
+
+
+	al_mod_reg_write32(&adapter->ec_regs_base->rfw.fsm_table_addr, idx);
+	al_mod_reg_write32(&adapter->ec_regs_base->rfw.fsm_table_data, entry);
