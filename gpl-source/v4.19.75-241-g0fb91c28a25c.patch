+/**
+ * read 50G MAC registers (indirect access)
+ *
+ * @param mac_regs_base MAC register base
+ * @param reg_addr address in the an registers
+ *
+ * @return the register value
+ */
+
+static uint32_t al_mod_eth_50g_mac_reg_read(
+			struct al_mod_eth_mac_v4_regs *mac_regs_base,
+			uint32_t reg_addr)
+{
+	uint32_t val;
+
+	/* indirect access */
+	al_mod_reg_write32(&mac_regs_base->mtip.mac_50g_addr, reg_addr);
+	val = al_mod_reg_read32(&mac_regs_base->mtip.mac_50g_data);
+
+	al_mod_dbg("%s: reg %d. val 0x%x\n", __func__, reg_addr, val);
+
+	return val;
+}
