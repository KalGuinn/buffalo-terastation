+/*
+ * Initialize the udma engine
+ */
+int al_mod_udma_init(struct al_mod_udma *udma, struct al_mod_udma_params *udma_params)
+{
+	int ret;
+
+	al_mod_assert(udma);
+	al_mod_assert(udma_params);
+
+	ret = al_mod_udma_handle_init_aux(udma, udma_params, AL_FALSE);
+	if (ret)
+		return ret;
+
+	/* initialize configuration registers to correct values */
+	al_mod_udma_set_defaults(udma);
+
+	/* unmask error interrupts */
+	if (udma->type == UDMA_TX)
+		al_mod_udma_iofic_m2s_error_ints_unmask(udma);
+	else
+		al_mod_udma_iofic_s2m_error_ints_unmask(udma	);
+
+	al_mod_dbg("udma [%s] initialized. base %p\n", udma->name,
+		udma->udma_regs);
+	return 0;
+}
+
+/* Reset (and disable) all UDMA queues */
+int al_mod_udma_q_reset_all(struct al_mod_udma *udma)
+{
+	unsigned int i;
+	int err;
+
+	al_mod_assert(udma);
+
+	for (i = 0; i < udma->num_of_queues; i++) {
+		struct al_mod_udma_q *q = NULL;
+
+		err = al_mod_udma_q_handle_get(udma, i, &q);
+		if (err) {
+			al_mod_err("%s: al_mod_udma_q_handle_get failed(%u)!\n", __func__, i);
+			return err;
+		}
+
+		if (!al_mod_udma_q_is_enabled(q))
+			continue;
+
+		err = al_mod_udma_q_reset(q);
+		if (err) {
+			al_mod_err("%s: al_mod_udma_q_reset failed(%u)!\n", __func__, i);
+			return err;
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * Initialize the udma queue data structure
+ */
+int al_mod_udma_q_init(struct al_mod_udma *udma, uint32_t qid,
+					struct al_mod_udma_q_params *q_params)
+{
+	struct al_mod_udma_q *udma_q;
+
+	al_mod_assert(udma);
+	al_mod_assert(q_params);
+
+	if (qid >= udma->num_of_queues) {
+		al_mod_err("udma: invalid queue id (%d)\n", qid);
+		return -EINVAL;
+	}
+
+	if (udma->udma_q[qid].status == AL_QUEUE_ENABLED) {
+		al_mod_err("udma: queue (%d) already enabled!\n", qid);
+		return -EIO;
+	}
+
+	if (q_params->size < AL_UDMA_MIN_Q_SIZE) {
+		al_mod_err("udma: queue (%d) size (%d) too small\n",
+			qid, q_params->size);
+		return -EINVAL;
+	}
+
+	if (q_params->size > AL_UDMA_MAX_Q_SIZE) {
+		al_mod_err("udma: queue (%d) size (%d) too large\n",
+			qid, q_params->size);
+		return -EINVAL;
+	}
+
+	if (q_params->size & (q_params->size - 1)) {
+		al_mod_err("udma: queue (%d) size (%d) must be power of 2\n",
+			 qid, q_params->size);
+		return -EINVAL;
+	}
+
+	udma_q = &udma->udma_q[qid];
+	udma_q->adapter_rev_id = q_params->adapter_rev_id;
+	udma_q->size = q_params->size;
+	udma_q->size_mask = q_params->size - 1;
+	udma_q->desc_base_ptr = q_params->desc_base;
+	udma_q->desc_phy_base = q_params->desc_phy_base;
+	udma_q->cdesc_base_ptr = q_params->cdesc_base;
+	udma_q->cdesc_phy_base = q_params->cdesc_phy_base;
+	udma_q->cdesc_size = q_params->cdesc_size;
+
+	udma_q->next_desc_idx = 0;
+	udma_q->next_cdesc_idx = 0;
+	udma_q->end_cdesc_ptr = (uint8_t *) udma_q->cdesc_base_ptr +
+	    (udma_q->size - 1) * udma_q->cdesc_size;
+	udma_q->comp_head_idx = 0;
+	udma_q->comp_head_ptr = (union al_mod_udma_cdesc *)udma_q->cdesc_base_ptr;
+	udma_q->desc_ring_id = AL_UDMA_INITIAL_RING_ID;
+	udma_q->comp_ring_id = AL_UDMA_INITIAL_RING_ID;
+#if 0
+	udma_q->desc_ctrl_bits = AL_UDMA_INITIAL_RING_ID <<
+						AL_M2S_DESC_RING_ID_SHIFT;
+#endif
+	udma_q->pkt_crnt_descs = 0;
+	udma_q->flags = 0;
+	udma_q->status = AL_QUEUE_DISABLED;
+	udma_q->udma = udma;
+	udma_q->qid = qid;
+
+	/* start hardware configuration: */
+	al_mod_udma_q_config(udma_q);
+	/* reset the queue pointers */
+	al_mod_udma_q_set_pointers(udma_q);
+
+	/* enable the q */
+	al_mod_udma_q_enable(udma_q, 1);
+
+	al_mod_dbg("udma [%s %d]: %s q init. size 0x%x\n"
+			"  desc ring info: phys base 0x%" PRIx64 " virt base %p\n",
+			udma_q->udma->name, udma_q->qid,
+			udma->type == UDMA_TX ? "Tx" : "Rx",
+			q_params->size,
+			q_params->desc_phy_base,
+			q_params->desc_base);
+	al_mod_dbg("  cdesc ring info: phys base 0x%" PRIx64 " virt base %p entry size 0x%x\n",
+			q_params->cdesc_phy_base,
+			q_params->cdesc_base,
+			q_params->cdesc_size);
+
+	return 0;
+}
+
+al_mod_bool al_mod_udma_q_is_enabled(struct al_mod_udma_q *udma_q)
+{
+	uint32_t reg;
+
+	al_mod_assert(udma_q);
+
+	reg = al_mod_reg_read32(&udma_q->q_regs->rings.cfg);
+	if (reg & (UDMA_M2S_Q_CFG_EN_PREF | UDMA_M2S_Q_CFG_EN_SCHEDULING))
+		return AL_TRUE;
+
+	return AL_FALSE;
+}
+
+/*
+ * pause a udma queue
+ */
+int al_mod_udma_q_pause(struct al_mod_udma_q *udma_q)
+{
+	unsigned int remaining_time = AL_UDMA_Q_QUIESCE_TOUT;
+	uint32_t *status_reg;
+	uint32_t *dcp_reg;
+	uint32_t *crhp_reg;
+
+	al_mod_assert(udma_q);
+
+	/* De-assert scheduling and prefetch */
+	al_mod_udma_q_enable(udma_q, 0);
+
+	/* Wait for scheduling and prefetch to stop */
+	status_reg = &udma_q->q_regs->rings.status;
+
+	while (remaining_time) {
+		uint32_t status = al_mod_reg_read32(status_reg);
+
+		if (!(status & (UDMA_M2S_Q_STATUS_PREFETCH |
+						UDMA_M2S_Q_STATUS_SCHEDULER)))
+			break;
+
+		remaining_time--;
+		al_mod_udelay(1);
+	}
+
+	if (!remaining_time) {
+		al_mod_err("udma [%s %d]: %s timeout waiting for prefetch and "
+			"scheduler disable\n", udma_q->udma->name, udma_q->qid,
+			__func__);
+		return -ETIME;
+	}
+
+	/* Wait for the completion queue to reach to the same pointer as the
+	 * prefetch stopped at ([TR]DCP == [TR]CRHP) */
+	dcp_reg = &udma_q->q_regs->rings.dcp;
+	crhp_reg = &udma_q->q_regs->rings.crhp;
+
+	while (remaining_time) {
+		uint32_t dcp = al_mod_reg_read32(dcp_reg);
+		uint32_t crhp = al_mod_reg_read32(crhp_reg);
+
+		if (dcp == crhp)
+			break;
+
+		remaining_time--;
+		al_mod_udelay(1);
+	};
+
+	if (!remaining_time) {
+		al_mod_err("udma [%s %d]: %s timeout waiting for dcp==crhp\n",
+			udma_q->udma->name, udma_q->qid, __func__);
+		return -ETIME;
+	}
+
+	return 0;
+}
+
+int al_mod_udma_q_resume(struct al_mod_udma_q *udma_q)
+{
+	al_mod_assert(udma_q);
+
+	al_mod_udma_q_enable(udma_q, 1);
+
+	return 0;
+}
+
+/*
+ * Reset a udma queue
+ */
+int al_mod_udma_q_reset(struct al_mod_udma_q *udma_q)
+{
+	uint32_t *q_sw_ctrl_reg;
+	int rc;
+
+	al_mod_assert(udma_q);
+
+	rc = al_mod_udma_q_pause(udma_q);
+
+	if (rc)
+		return rc;
+
+	/* Assert the queue reset */
+	if (udma_q->udma->type == UDMA_TX)
+		q_sw_ctrl_reg = &udma_q->q_regs->m2s_q.q_sw_ctrl;
+	else
+		q_sw_ctrl_reg = &udma_q->q_regs->s2m_q.q_sw_ctrl;
+
+	al_mod_reg_write32(q_sw_ctrl_reg, UDMA_M2S_Q_SW_CTRL_RST_Q);
+
+	return 0;
+}
+
+/*
+ * return (by reference) a pointer to a specific queue date structure.
+ */
+int al_mod_udma_q_handle_get(struct al_mod_udma *udma, uint32_t qid,
+						struct al_mod_udma_q **q_handle)
+{
+
+	al_mod_assert(udma);
+	al_mod_assert(q_handle);
+
+	if (unlikely(qid >= udma->num_of_queues)) {
+		al_mod_err("udma [%s]: invalid queue id (%d)\n", udma->name, qid);
+		return -EINVAL;
+	}
+	*q_handle = &udma->udma_q[qid];
+	return 0;
+}
+
+/*
+ * Change the UDMA's state
+ */
+int al_mod_udma_state_set(struct al_mod_udma *udma, enum al_mod_udma_state state)
+{
+	uint32_t reg;
+
+	al_mod_assert(udma != NULL);
+	if (state == udma->state)
+		al_mod_dbg("udma [%s]: requested state identical to "
+			"current state (%d)\n", udma->name, state);
+
+	al_mod_dbg("udma [%s]: change state from (%s) to (%s)\n",
+		 udma->name, al_mod_udma_states_name[udma->state],
+		 al_mod_udma_states_name[state]);
+
+	reg = 0;
+	switch (state) {
+	case UDMA_DISABLE:
+		reg |= UDMA_M2S_CHANGE_STATE_DIS;
+		break;
+	case UDMA_NORMAL:
+		reg |= UDMA_M2S_CHANGE_STATE_NORMAL;
+		break;
+	case UDMA_ABORT:
+		reg |= UDMA_M2S_CHANGE_STATE_ABORT;
+		break;
+	default:
+		al_mod_err("udma: invalid state (%d)\n", state);
+		return -EINVAL;
+	}
+
+	if (udma->type == UDMA_TX)
+		al_mod_reg_write32(&udma->udma_regs->m2s.m2s.change_state, reg);
+	else
+		al_mod_reg_write32(&udma->udma_regs->s2m.s2m.change_state, reg);
+
+	udma->state = state;
+	return 0;
+}
+
+static void al_mod_udma_s2m_fifos_flush(struct al_mod_udma *udma)
+{
+	al_mod_assert(udma);
+	al_mod_assert(udma->type == UDMA_RX);
+
+	/** FIFO reset - toggle enable bit*/
+	al_mod_reg_write32(&udma->udma_regs->s2m.s2m.fifo_en, 0);
+	/** restart udma control state machines */
+	al_mod_reg_write32(&udma->udma_regs->s2m.s2m.clear_ctrl, 0xFFFFFFFF);
+	al_mod_udelay(1);
+
+	/** Re enable fifo's */
+	al_mod_reg_write32(&udma->udma_regs->s2m.s2m.fifo_en, 0xFFFFFFFF);
+	/** restart udma state machines */
+	al_mod_reg_write32(&udma->udma_regs->s2m.s2m.clear_ctrl, 0xFFFFFFFF);
+	al_mod_udelay(1);
+}
+
+#define AL_UDMA_S2M_STREAM_FLUSH \
+				(UDMA_S2M_STREAM_CFG_DISABLE	| \
+				UDMA_S2M_STREAM_CFG_FLUSH	| \
+				UDMA_S2M_STREAM_CFG_STOP_PREFETCH)
+
+static void udma_s2m_stream_set_mode(struct al_mod_udma *udma, al_mod_bool state)
+{
+	uint32_t stream_dis = AL_UDMA_S2M_STREAM_FLUSH;
+
+	al_mod_reg_write32_masked(&udma->udma_regs->s2m.s2m.stream_cfg,
+		stream_dis,
+		state ? 0 : stream_dis);
+}
+
+static void udma_s2m_stream_queues_set_mode(struct al_mod_udma *udma, al_mod_bool state)
+{
+	int i = 0;
+	int rc;
+
+	for (i = 0; i < udma->num_of_queues; i++) {
+		struct al_mod_udma_q *dma_q = NULL;
+		uint32_t *reg_addr;
+		rc = al_mod_udma_q_handle_get(udma, i, &dma_q);
+		if (rc != 0) {
+			al_mod_assert_msg(!rc, "%s : Failed at al_mod_udma_q_handle_get (rc = %d)\n",
+				__func__, rc);
+			return;
+		}
+
+		reg_addr = &dma_q->q_regs->s2m_q.cfg;
+		al_mod_reg_write32_masked(reg_addr, UDMA_S2M_Q_CFG_EN_STREAM,
+						state ? UDMA_S2M_Q_CFG_EN_STREAM : 0);
+	}
+}
+
+static void al_mod_udma_s2m_stream_configure(struct al_mod_udma *udma, al_mod_bool state)
+{
+	al_mod_assert(udma);
+	al_mod_assert(udma->type == UDMA_RX);
+
+	if (state == AL_TRUE) {
+		udma_s2m_stream_queues_set_mode(udma, state);
+		udma_s2m_stream_set_mode(udma, state);
+	} else {
+		udma_s2m_stream_set_mode(udma, state);
+		udma_s2m_stream_queues_set_mode(udma, state);
+	}
+}
+
+/**
+ * Determine if stream is enabled or disbled (flushing new packets)
+ */
+static al_mod_bool al_mod_udma_s2m_stream_status_get(struct al_mod_udma *udma)
+{
+	unsigned int i;
+	uint32_t stream_cfg = 0;
+	int rc = 0;
+	al_mod_bool queue_stream_status;
+	al_mod_bool queue_stream_status_valid = AL_FALSE;
+	al_mod_bool stream_status = AL_TRUE;
+
+	al_mod_assert(udma);
+	al_mod_assert(udma->type == UDMA_RX);
+
+	stream_cfg = al_mod_reg_read32(&udma->udma_regs->s2m.s2m.stream_cfg);
+	stream_cfg &= AL_UDMA_S2M_STREAM_FLUSH;
+
+	if (stream_cfg == AL_UDMA_S2M_STREAM_FLUSH)
+		stream_status = AL_FALSE; /** stream is disabled */
+
+	queue_stream_status = AL_FALSE;
+	for (i = 0; i < udma->num_of_queues; i++) {
+		struct al_mod_udma_q *dma_q = NULL;
+		uint32_t *reg_addr;
+		uint32_t reg_val;
+
+		rc = al_mod_udma_q_handle_get(udma, i, &dma_q);
+		if (rc != 0)
+			al_mod_err("%s : Failed at al_mod_udma_q_handle_get (rc = %d)\n", __func__, rc);
+
+		if (!al_mod_udma_q_is_enabled(dma_q))
+			continue;
+
+		queue_stream_status_valid = AL_TRUE;
+
+		reg_addr = &dma_q->q_regs->s2m_q.cfg;
+		reg_val = al_mod_reg_read32(reg_addr);
+
+		/** Need all queues stream interface disabled */
+		if (reg_val & UDMA_S2M_Q_CFG_EN_STREAM) {
+			queue_stream_status = AL_TRUE;
+			break;
+		}
+	}
+
+	if (queue_stream_status_valid && (queue_stream_status != stream_status)) {
+		al_mod_warn("%s: Bad configurations, stream & queue stream interface status are"
+			" different! assuming strem is enabled\n",
+			__func__);
+		/** Need both interfaces disabled to stop stream */
+		return AL_TRUE;
+	}
+
+	return stream_status;
+}
+
+/*
+ * return the current UDMA hardware state
+ */
+enum al_mod_udma_state al_mod_udma_state_get(struct al_mod_udma *udma)
+{
+	uint32_t state_reg;
+	uint32_t comp_ctrl;
+	uint32_t stream_if;
+	uint32_t data_rd;
+	uint32_t desc_pref;
+	al_mod_bool stream_enabled;
+
+	if (udma->type == UDMA_TX) {
+		state_reg = al_mod_reg_read32(&udma->udma_regs->m2s.m2s.state);
+		stream_enabled = AL_TRUE;
+	} else {
+		state_reg = al_mod_reg_read32(&udma->udma_regs->s2m.s2m.state);
+		stream_enabled = al_mod_udma_s2m_stream_status_get(udma);
+	}
+
+	comp_ctrl = AL_REG_FIELD_GET(state_reg,
+				     UDMA_M2S_STATE_COMP_CTRL_MASK,
+				     UDMA_M2S_STATE_COMP_CTRL_SHIFT);
+	stream_if = AL_REG_FIELD_GET(state_reg,
+				     UDMA_M2S_STATE_STREAM_IF_MASK,
+				     UDMA_M2S_STATE_STREAM_IF_SHIFT);
+	data_rd = AL_REG_FIELD_GET(state_reg,
+				   UDMA_M2S_STATE_DATA_RD_CTRL_MASK,
+				   UDMA_M2S_STATE_DATA_RD_CTRL_SHIFT);
+	desc_pref = AL_REG_FIELD_GET(state_reg,
+				     UDMA_M2S_STATE_DESC_PREF_MASK,
+				     UDMA_M2S_STATE_DESC_PREF_SHIFT);
+
+	al_mod_assert(comp_ctrl != UDMA_STATE_RESERVED);
+	al_mod_assert(stream_if != UDMA_STATE_RESERVED);
+	al_mod_assert(data_rd != UDMA_STATE_RESERVED);
+	al_mod_assert(desc_pref != UDMA_STATE_RESERVED);
+
+	/**
+	 * Due to a HW bug, in case stream is disabled but there are packets waiting to enter
+	 * the UDMA, the stream_if might be "stuck" at "1"
+	 *
+	 * We can ignore the stream_if indication if :
+	 * 1. The stream is disabled for UDMA and for each queue -
+	 *    new packets cannot enter the UDMA or its queues.
+	 * 3. We waited at least 1us for the FIFO's to be emptied
+	 */
+
+	/* if any of the states is abort then return abort */
+	if (stream_enabled) {
+		if ((comp_ctrl == UDMA_STATE_ABORT) || (stream_if == UDMA_STATE_ABORT)
+			|| (data_rd == UDMA_STATE_ABORT) || (desc_pref == UDMA_STATE_ABORT))
+				return UDMA_ABORT;
+	} else {
+		if ((comp_ctrl == UDMA_STATE_ABORT) || (desc_pref == UDMA_STATE_ABORT) ||
+			(data_rd == UDMA_STATE_ABORT))
+				return UDMA_ABORT;
+	}
+
+	if (stream_enabled) {
+		/* if any of the states is normal then return normal */
+		if ((comp_ctrl == UDMA_STATE_NORMAL) || (stream_if == UDMA_STATE_NORMAL)
+			|| (data_rd == UDMA_STATE_NORMAL) || (desc_pref == UDMA_STATE_NORMAL))
+				return UDMA_NORMAL;
+	} else {
+		if ((comp_ctrl == UDMA_STATE_NORMAL) || (desc_pref == UDMA_STATE_NORMAL) ||
+			(data_rd == UDMA_STATE_NORMAL))
+				return UDMA_NORMAL;
+	}
+
+	return UDMA_IDLE;
+}
+
+int al_mod_udma_state_set_wait(struct al_mod_udma *dma, enum al_mod_udma_state new_state, al_mod_bool flush_stream)
+{
+	enum al_mod_udma_state state;
+	enum al_mod_udma_state expected_state = new_state;
+	int count = 1000;
+	int rc;
+
+	/**
+	 * When we wish to move to DISABLE or NORMAL state & the UDMA can receive traffic,
+	 * we might never change state & the UDMA will be busy processing new requests.
+	 * Therefore we perform the following operations :
+	 * 1. disable the stream of the UDMA & stream enable of each queue
+	 * 2. wait untill all FIFO's are emptied - 1us is enough.
+	 * 3. Issue FIFO's flush for "stuck" packets - This can occur if there are "garbage" packets
+	 *    For example : if the EC hasn't been initialized but transferred traffic
+	 */
+	if (flush_stream) {
+		al_mod_assert(dma->type == UDMA_RX);
+		al_mod_assert((new_state == UDMA_DISABLE) || (new_state == UDMA_NORMAL));
+
+		al_mod_udma_s2m_stream_configure(dma, AL_FALSE);	/** stop stream */
+		al_mod_udelay(1);					/** wait until empty */
+		al_mod_udma_s2m_fifos_flush(dma);			/** flush remaining packets */
+	}
+
+	rc = al_mod_udma_state_set(dma, new_state);
+	if (rc != 0) {
+		al_mod_warn("[%s] warn: failed to change state, error %d\n", dma->name, rc);
+		return rc;
+	}
+
+	if ((new_state == UDMA_NORMAL) || (new_state == UDMA_DISABLE))
+		expected_state = UDMA_IDLE;
+
+	do {
+		state = al_mod_udma_state_get(dma);
+		if (state == expected_state)
+			break;
+		al_mod_udelay(1);
+		if (count-- == 0) {
+			al_mod_warn("[%s] warn: dma state didn't change to %s\n",
+				 dma->name, al_mod_udma_states_name[new_state]);
+			return -ETIMEDOUT;
+		}
+	} while (1);
+
+	if (flush_stream) {
+		if ((new_state == UDMA_NORMAL) && (dma->rev_id >= AL_UDMA_REV_ID_4)) {
+			al_mod_udma_ttt_default_config(dma); /** Configure TTT table */
+#ifdef AL_ETH_EX
+			al_mod_udma_ex_ttt_default_config(dma);
+#endif
+		}
+		al_mod_udma_s2m_stream_configure(dma, AL_TRUE); /** Enable the stream */
+	}
+
+	return 0;
+}
+
+/*
+ * Action handling
+ */
+
+/*
+ * get next completed packet from completion ring of the queue
+ *
+ * This implementation assumes that udma drop mode is set - if it is removed we should remove
+ * the marked code segment as its not needed.
+ */
+uint32_t al_mod_udma_cdesc_packet_get(
+	struct al_mod_udma_q		*udma_q,
+	volatile union al_mod_udma_cdesc	**cdesc)
+{
+	uint32_t count;
+	volatile union al_mod_udma_cdesc *curr;
+	uint32_t comp_flags;
+
+	/* this function requires the completion ring update */
+	al_mod_assert(!(udma_q->flags & AL_UDMA_Q_FLAGS_NO_COMP_UPDATE));
+
+	/* comp_head points to the last comp desc that was processed */
+	curr = udma_q->comp_head_ptr;
+	comp_flags = swap32_from_le(curr->al_mod_desc_comp_tx.ctrl_meta);
+
+	/* check if the completion descriptor is new */
+	if (unlikely(al_mod_udma_new_cdesc(udma_q, comp_flags) == AL_FALSE))
+		return 0;
+
+	/**
+	 * If continue to process a packet, check it was not "trimmed" by udma drop
+	 * i.e, making sure processed desc is not a "first" desc
+	 */
+	if (unlikely(udma_q->pkt_crnt_descs && cdesc_is_first(comp_flags))) {
+		uint32_t last_desc =
+			(udma_q->next_cdesc_idx + udma_q->pkt_crnt_descs - 1) & (udma_q->size_mask);
+		curr = al_mod_udma_cdesc_idx_to_ptr(udma_q, last_desc);
+		curr->al_mod_desc_comp_rx.ctrl_meta |=
+			swap32_to_le(AL_S2M_DESC_ERR | AL_UDMA_CDESC_LAST);
+		count = udma_q->pkt_crnt_descs;
+		goto done;
+	}
+
+	/* if new desc found, increment the current packets descriptors */
+	count = udma_q->pkt_crnt_descs + 1;
+
+	/**
+	 * Stopping condition is end of packet - indication of last descriptor
+	 */
+	while (!cdesc_is_last(comp_flags)) {
+		curr = al_mod_cdesc_next_update(udma_q, curr);
+		comp_flags = swap32_from_le(curr->al_mod_desc_comp_tx.ctrl_meta);
+		if (unlikely(al_mod_udma_new_cdesc(udma_q, comp_flags)
+								== AL_FALSE)) {
+			/* the current packet here doesn't have all  */
+			/* descriptors completed. log the current desc */
+			/* location and number of completed descriptors so */
+			/*  far. then return */
+			udma_q->pkt_crnt_descs = count;
+			udma_q->comp_head_ptr = curr;
+			return 0;
+		}
+
+		/**
+		 * If udma drop mode is on (call to al_mod_udma_s2m_no_desc_cfg_set())
+		 * "middle/last" descs can be dropped.
+		 * A possible error scenarios is :
+		 * F, M, M, F, L : In that case we will pass on 2 packets as one.
+		 * F, F , F, FL     : Pass 4 packets as one.
+		 *
+		 * Therefore we should make sure we are not processing a new "F/FL" desc.
+		 */
+		if (unlikely(cdesc_is_first(comp_flags))) {
+			/*
+			 * Return to actual last desc and mark it as last with L2 err, then stop
+			 * F, M, M, F => last desc is at : first + 2 => first + (count - 1)
+			 * F, F       => last desc is at : first + 0
+			 * count >= 1
+			 */
+			uint32_t last_desc =
+				(udma_q->next_cdesc_idx + count - 1) & (udma_q->size_mask);
+			curr = al_mod_udma_cdesc_idx_to_ptr(udma_q, last_desc);
+			curr->al_mod_desc_comp_rx.ctrl_meta |= swap32_to_le(
+				AL_S2M_DESC_ERR | AL_UDMA_CDESC_LAST);
+			break;
+		}
+
+		count++;
+		/* check against max descs per packet. */
+		al_mod_assert(count <= udma_q->size);
+	}
+
+done:
+	/* return back the first descriptor of the packet */
+	*cdesc = al_mod_udma_cdesc_idx_to_ptr(udma_q, udma_q->next_cdesc_idx);
+	udma_q->pkt_crnt_descs = 0;
+	udma_q->comp_head_ptr = al_mod_cdesc_next_update(udma_q, curr);
+
+	al_mod_dbg("udma [%s %d]: packet completed. first desc %p (ixd 0x%x)"
+		 " descs %d\n", udma_q->udma->name, udma_q->qid, *cdesc,
+		 udma_q->next_cdesc_idx, count);
+
+	return count;
+}
+
+void al_mod_udma_mailbox_read(struct al_mod_udma *udma, unsigned int mailbox_id, uint32_t *val)
+{
+	uint32_t *reg;
+
+	if (udma->rev_id < AL_UDMA_REV_ID_4) {
+		struct udma_gen_regs_v3 *udma_gen_regs = udma->gen_regs;
+
+		al_mod_assert(mailbox_id < AL_ARR_SIZE(udma_gen_regs->mailbox));
+
+		reg = &udma_gen_regs->mailbox[mailbox_id].msg_in;
+	} else {
+		struct udma_gen_regs_v4 *udma_gen_regs = udma->gen_regs;
+
+		al_mod_assert(mailbox_id < AL_ARR_SIZE(udma_gen_regs->mailbox));
+
+		reg = &udma_gen_regs->mailbox[mailbox_id].msg_in;
+	}
+
+	*val = al_mod_reg_read32(reg);
+}
+
+void al_mod_udma_mailbox_write(struct al_mod_udma *udma, unsigned int mailbox_id, uint32_t val)
+{
+	uint32_t *reg;
+
+	if (udma->rev_id < AL_UDMA_REV_ID_4) {
+		struct udma_gen_regs_v3 *udma_gen_regs = udma->gen_regs;
+
+		al_mod_assert(mailbox_id < AL_ARR_SIZE(udma_gen_regs->mailbox));
+
+		reg = &udma_gen_regs->mailbox[mailbox_id].msg_out;
+	} else {
+		struct udma_gen_regs_v4 *udma_gen_regs = udma->gen_regs;
+
+		al_mod_assert(mailbox_id < AL_ARR_SIZE(udma_gen_regs->mailbox));
+
+		reg = &udma_gen_regs->mailbox[mailbox_id].msg_out;
+	}
+
+	al_mod_reg_write32(reg, val);
+}
+
+
+/** @} end of UDMA group */
