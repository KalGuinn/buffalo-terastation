+
+	al_reg_write32_masked(
+		&ctrl_regs->init0,
+		(DWC_DDR_UMCTL2_REGS_INIT0_PRE_CKE_X1024_MASK |
+		DWC_DDR_UMCTL2_REGS_INIT0_POST_CKE_X1024_MASK),
