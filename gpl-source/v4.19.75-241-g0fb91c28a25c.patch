+/*******************************************************************************
+ ******************************************************************************/
+DDR_STATIC int _al_ddr_ecc_uncorr_int_clear(
+	struct al_ddr_cfg		*ddr_cfg)
+{
+	union al_ddr_ctrl_regs __iomem *ctrl_regs =
+		(union al_ddr_ctrl_regs __iomem *)
+		ddr_cfg->ddr_ctrl_regs_base;
+
+	al_reg_write32(CTRL_REG(eccclr),
+			DWC_DDR_UMCTL2_REGS_ECCCLR_ECC_CLR_UNCORR_ERR);
+
+	if (ddr_cfg->ddrc_regs_base) {
+		struct al_ddrc_regs __iomem *ddrc_regs;
+
+		al_data_memory_barrier();
+
+		ddrc_regs = (struct al_ddrc_regs __iomem *)ddr_cfg->ddrc_regs_base;
+
+		al_reg_write32(&ddrc_regs->channel.int_cause,
+			~DDRC_CHANNEL_INT_CAUSE_ECC_UNCORRECTED_ERR);
+	}
+
+	if (ddr_cfg->nb_regs_base) {
+		struct al_sys_fabric_handle handle;
+		void __iomem *nmi_sfic_base;
+		void __iomem *err_sfic_base;
+		uint32_t ch_errs;
+
+		al_sys_fabric_handle_init(&handle, ddr_cfg->nb_regs_base);
+
+		nmi_sfic_base = al_sys_fabric_nmi_sfic_regs_base_get(&handle);
+		ch_errs = (ddr_cfg->ch == 0) ?
+			AL_SYS_FABRIC_SFIC_NMI_GROUP_A_DDR_CHANNEL_0_UNCORRECTABLE_ECC :
+			AL_SYS_FABRIC_SFIC_NMI_GROUP_A_DDR_CHANNEL_1_UNCORRECTABLE_ECC;
+		al_iofic_clear_cause(nmi_sfic_base, AL_INT_GROUP_A, ch_errs);
+		al_iofic_clear_cause(nmi_sfic_base, AL_INT_GROUP_B, ch_errs);
+
+		err_sfic_base = al_sys_fabric_err_sfic_regs_base_get(&handle);
+		ch_errs = (ddr_cfg->ch == 0) ?
+			AL_SYS_FABRIC_SFIC_ERR_GROUP_A_DDR_CAUSE_SUM_0 :
+			AL_SYS_FABRIC_SFIC_ERR_GROUP_A_DDR_CAUSE_SUM_1;
+		al_iofic_clear_cause(err_sfic_base, AL_INT_GROUP_A, ch_errs);
+	}
+
+	return 0;
+}
