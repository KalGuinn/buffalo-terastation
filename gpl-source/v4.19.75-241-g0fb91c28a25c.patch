+/******************************************************************************/
+/******************************************************************************/
+static void al_mod_serdes_group_pm_set(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_pm		pm)
+{
+	uint8_t pm_val;
+
+	switch (pm) {
+	case AL_SRDS_PM_PD:
+		pm_val = SERDES_IREG_FLD_CMNPCSPSTATE_SYNTH_VAL_PD;
+		break;
+	case AL_SRDS_PM_P2:
+		pm_val = SERDES_IREG_FLD_CMNPCSPSTATE_SYNTH_VAL_P2;
+		break;
+	case AL_SRDS_PM_P1:
+		pm_val = SERDES_IREG_FLD_CMNPCSPSTATE_SYNTH_VAL_P1;
+		break;
+	case AL_SRDS_PM_P0S:
+		pm_val = SERDES_IREG_FLD_CMNPCSPSTATE_SYNTH_VAL_P0S;
+		break;
+	case AL_SRDS_PM_P0:
+		pm_val = SERDES_IREG_FLD_CMNPCSPSTATE_SYNTH_VAL_P0;
+		break;
+	default:
+		al_mod_err("%s: invalid power mode (%d)\n",  __func__, pm);
+		al_mod_assert(0);
+		pm_val = SERDES_IREG_FLD_CMNPCSPSTATE_SYNTH_VAL_P0;
+	}
+
+	if (pm == AL_SRDS_PM_PD)
+		al_mod_serdes_group_rx_rate_change_sw_flow_dis(obj);
+
+	al_mod_serdes_grp_reg_masked_write(
+		obj,
+		AL_SRDS_REG_PAGE_4_COMMON,
+		AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_CMNPCSPSTATE_SYNTH_REG_NUM,
+		SERDES_IREG_FLD_CMNPCSPSTATE_SYNTH_MASK,
+		pm_val);
+
+	if (pm != AL_SRDS_PM_PD)
+		al_mod_serdes_group_rx_rate_change_sw_flow_en_cond(obj);
+}
+
+static void al_mod_serdes_lane_rx_soft_reset(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane	lane)
+{
+	uint8_t locwren_reg, rstlane_rx_reg;
+
+	al_mod_serdes_reg_read(obj, (enum al_mod_serdes_reg_page)lane, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RSTLANEPCSSOFT_LOCWREN_REG_NUM, &locwren_reg);
+	al_mod_serdes_reg_write(obj, (enum al_mod_serdes_reg_page)lane, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RSTLANEPCSSOFT_LOCWREN_REG_NUM,
+			locwren_reg & ~SERDES_IREG_FLD_RSTLANEPCSSOFT_LOCWREN);
+
+	al_mod_serdes_reg_read(obj, (enum al_mod_serdes_reg_page)lane, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RSTLANEPCSSOFT_RX_REG_NUM, &rstlane_rx_reg);
+	al_mod_serdes_reg_write(obj, (enum al_mod_serdes_reg_page)lane, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RSTLANEPCSSOFT_RX_REG_NUM,
+			rstlane_rx_reg & ~SERDES_IREG_FLD_RSTLANEPCSSOFT_RX);
+
+	al_mod_serdes_reg_write(obj, (enum al_mod_serdes_reg_page)lane, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RSTLANEPCSSOFT_RX_REG_NUM, rstlane_rx_reg);
+	al_mod_serdes_reg_write(obj, (enum al_mod_serdes_reg_page)lane, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RSTLANEPCSSOFT_LOCWREN_REG_NUM, locwren_reg);
+}
