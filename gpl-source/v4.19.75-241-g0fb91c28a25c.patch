+		if (obj->serdes_lane == 1)
+			al_reg_write32(&mac_regs_base->gen.los_sel, 0x101);
+
+		break;
+	case AL_ETH_MAC_MODE_XLG_LL_50G:
+		/* configure and enable the ASYNC FIFO between the MACs and the EC */
+		/* TX min packet size */
+		al_reg_write32(&mac_regs_base->gen_v3.tx_afifo_cfg_1, 0x00000010);
+		/* TX max packet size */
+		al_reg_write32(&mac_regs_base->gen_v3.tx_afifo_cfg_2, 0x00002800);
+		/* TX input bus configuration */
+		al_reg_write32(&mac_regs_base->gen_v3.tx_afifo_cfg_3, 0x00000080);
+		/* TX output bus configuration */
+		al_reg_write32(&mac_regs_base->gen_v3.tx_afifo_cfg_4, 0x00010040);
+		/* TX Valid/ready configuration */
+		al_reg_write32(&mac_regs_base->gen_v3.tx_afifo_cfg_5, 0x00000023);
+		/* RX input bus configuration */
+		al_reg_write32(&mac_regs_base->gen_v3.rx_afifo_cfg_3, 0x00010040);
+		/* RX output bus configuration */
+		al_reg_write32(&mac_regs_base->gen_v3.rx_afifo_cfg_4, 0x00000080);
+		/* RX Valid/ready configuration */
+		al_reg_write32(&mac_regs_base->gen_v3.rx_afifo_cfg_5, 0x00000112);
+
+		/* V3 additional MAC selection */
+		al_reg_write32(&mac_regs_base->gen_v3.mac_sel, 0x00000010);
+		al_reg_write32(&mac_regs_base->gen_v3.mac_10g_ll_cfg, 0x00000000);
+		al_reg_write32(&mac_regs_base->gen_v3.mac_10g_ll_ctrl, 0x00000000);
+		al_reg_write32(&mac_regs_base->gen_v3.pcs_10g_ll_cfg, 0x00000000);
+		/* ASYNC FIFO ENABLE */
+		al_reg_write32(&mac_regs_base->gen_v3.afifo_ctrl, 0x00003333);
+
+		/* cmd_cfg */
+		al_reg_write32(&mac_regs_base->gen_v3.mac_40g_ll_addr, 0x00000008);
+		al_reg_write32(&mac_regs_base->gen_v3.mac_40g_ll_data, 0x01022810);
+
+		/* select the 25G serdes for lanes 0/1 */
+		al_reg_write32(&mac_regs_base->gen_v3.ext_serdes_ctrl, 0x0382110F);
+		/* configure the PCS to work with 2 lanes */
+		/* configure which two of the 4 PCS Lanes (VL) are combined to one RXLAUI lane */
+		/* use VL 0-2 for RXLAUI lane 0, use VL 1-3 for RXLAUI lane 1 */
+		al_eth_40g_pcs_reg_write(mac_regs_base, 0x00010008, 0x0d81);
+		/* configure the PCS to work 32 bit interface */
+		al_reg_write32(&mac_regs_base->gen_v3.pcs_40g_ll_cfg, 0x00440000);
+
+
+#if (defined(AL_ETH_FAST_AN)) && (AL_ETH_FAST_AN == 1)
+		al_eth_40g_pcs_reg_write(mac_regs_base, 0x00010004, 1023);
+		al_eth_40g_pcs_reg_write(mac_regs_base, 0x00000000, 0xA04c);
+		al_eth_40g_pcs_reg_write(mac_regs_base, 0x00000000, 0x204c);
+#endif
+
+		/* XAUI MAC control register */
+		al_reg_write32_masked(&mac_regs_base->gen.mux_sel,
+			~ETH_MAC_GEN_MUX_SEL_KR_IN_MASK, 0x06883910);
+		al_reg_write32(&mac_regs_base->gen.sd_fifo_ctrl, 0x0000040f);
+
+		/* MAC register file */
+		/* XAUI MAC control register */
+		al_reg_write32(&mac_regs_base->gen.cfg, 0x00000005);
+		/* RXAUI MAC control register */
+		al_reg_write32(&mac_regs_base->gen.rxaui_cfg, 0x00000007);
+		al_reg_write32(&mac_regs_base->gen.sd_cfg, 0x000001F1);
+		al_reg_write32(&mac_regs_base->gen.xgmii_dfifo_32_64, 0x00000401);
+		al_reg_write32(&mac_regs_base->gen.xgmii_dfifo_64_32, 0x00000401);
+		al_reg_write32(&mac_regs_base->gen.clk_cfg, 0x10001010);
+
+		al_reg_write32_masked(&mac_regs_base->gen.led_cfg,
+				      ETH_MAC_GEN_LED_CFG_SEL_MASK,
+				      ETH_MAC_GEN_LED_CFG_SEL_DEFAULT_REG);
+		break;
+
+
+	default:
+		return -EPERM;
+	}
+
+	mac_mode_set(obj, mode);
+
+	return 0;
+}
+
+static int mac_start_stop_adv(struct al_eth_mac_obj *obj,
+			      al_bool tx,
+			      al_bool rx,
+			      al_bool tx_start,
+			      al_bool rx_start)
+{
+	struct al_eth_mac_regs *mac_regs_base = obj->mac_regs_base;
+	uint32_t cmd_cfg = 0;
+	uint32_t mask = 0;
+	uint32_t data = 0;
+
+	al_dbg("%s: mac_mode:%s, tx_modify:%d, tx_start:%d, rx_modify:%d, rx_start:%d\n",
+	       __func__,
+	       al_eth_mac_mode_str(obj->mac_mode),
+	       tx,
+	       tx_start,
+	       rx,
+	       rx_start);
+
+	switch (obj->mac_mode) {
+	case AL_ETH_MAC_MODE_SGMII:
+		if (tx) {
+			mask |= ETH_1G_MAC_CMD_CFG_TX_ENA;
+			if (tx_start)
+				cmd_cfg |= ETH_1G_MAC_CMD_CFG_TX_ENA;
+		}
+
+		if (rx) {
+			mask |= ETH_1G_MAC_CMD_CFG_RX_ENA;
+			if (rx_start)
+				cmd_cfg |= ETH_1G_MAC_CMD_CFG_RX_ENA;
+		}
+		/* 1G MAC control register */
+		al_reg_write32_masked(&mac_regs_base->mac_1g.cmd_cfg,
+				      mask,
+				      cmd_cfg);
+		break;
+	case AL_ETH_MAC_MODE_SGMII_2_5G:
+	case AL_ETH_MAC_MODE_10GbE_Serial:
+	case AL_ETH_MAC_MODE_KR_LL_25G:
+		if (tx) {
+			mask |= ETH_10G_MAC_CMD_CFG_TX_ENA;
+			if (tx_start)
+				cmd_cfg |= ETH_10G_MAC_CMD_CFG_TX_ENA;
+		}
+
+		if (rx) {
+			mask |= ETH_10G_MAC_CMD_CFG_RX_ENA;
+			if (rx_start)
+				cmd_cfg |= ETH_10G_MAC_CMD_CFG_RX_ENA;
+		}
+		/* 10G MAC control register  */
+		al_reg_write32_masked(&mac_regs_base->mac_10g.cmd_cfg,
+				      mask,
+				      cmd_cfg);
+		break;
+	case AL_ETH_MAC_MODE_XLG_LL_40G:
+	case AL_ETH_MAC_MODE_XLG_LL_50G:
+	case AL_ETH_MAC_MODE_XLG_LL_25G:
+		cmd_cfg = al_eth_40g_mac_reg_read(mac_regs_base,
+				ETH_MAC_GEN_V3_MAC_40G_COMMAND_CONFIG_ADDR);
+
+		if (tx) {
+			mask |= ETH_MAC_GEN_V3_MAC_40G_COMMAND_CONFIG_TX_ENA;
+			if (tx_start)
+				data |= ETH_MAC_GEN_V3_MAC_40G_COMMAND_CONFIG_TX_ENA;
+		}
+
+		if (rx) {
+			mask |= ETH_MAC_GEN_V3_MAC_40G_COMMAND_CONFIG_RX_ENA;
+			if (rx_start)
+				data |= ETH_MAC_GEN_V3_MAC_40G_COMMAND_CONFIG_RX_ENA;
+		}
+
+		cmd_cfg = AL_MASK_VAL(mask, data, cmd_cfg);
+
+		al_eth_40g_mac_reg_write(mac_regs_base,
+				ETH_MAC_GEN_V3_MAC_40G_COMMAND_CONFIG_ADDR,
+				cmd_cfg);
+		break;
+	default:
+		al_err("%s@%s: Unsupported mac_mode: %s\n",
+		       __func__, __FILE__,
+		       al_eth_mac_mode_str(obj->mac_mode));
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int mac_loopback_config(struct al_eth_mac_obj *obj, al_bool enable)
+{
+	struct al_eth_mac_regs *mac_regs_base = obj->mac_regs_base;
+
+	switch (obj->mac_mode) {
+	case AL_ETH_MAC_MODE_SGMII:
+		al_reg_write32_masked(&mac_regs_base->mac_1g.cmd_cfg, AL_BIT(15),
+			(enable ? AL_BIT(15) : 0));
+		break;
+	case AL_ETH_MAC_MODE_SGMII_2_5G:
+	case AL_ETH_MAC_MODE_10GbE_Serial:
+	case AL_ETH_MAC_MODE_KR_LL_25G:
+		al_eth_kr_pcs_reg_write_masked(mac_regs_base, ETH_MAC_KR_PCS_CONTROL_1_ADDR,
+			AL_BIT(14), (enable ? AL_BIT(14) : 0));
+		break;
+	case AL_ETH_MAC_MODE_XLG_LL_40G:
+	case AL_ETH_MAC_MODE_XLG_LL_50G:
+	case AL_ETH_MAC_MODE_XLG_LL_25G:
+		al_eth_40g_pcs_reg_write_masked(mac_regs_base,
+			ETH_MAC_GEN_V3_PCS_40G_CONTROL_STATUS_ADDR,
+			AL_BIT(14), (enable ? AL_BIT(14) : 0));
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static al_bool mac_loopback_get(struct al_eth_mac_obj *obj)
+{
+	struct al_eth_mac_regs *mac_regs_base = obj->mac_regs_base;
+	uint32_t reg;
+
+	switch (obj->mac_mode) {
+	case AL_ETH_MAC_MODE_SGMII:
+		reg = al_reg_read32(&mac_regs_base->mac_1g.cmd_cfg);
+		return !!(reg & AL_BIT(15));
+	case AL_ETH_MAC_MODE_SGMII_2_5G:
+	case AL_ETH_MAC_MODE_10GbE_Serial:
+	case AL_ETH_MAC_MODE_KR_LL_25G:
+		reg = al_eth_kr_pcs_reg_read(mac_regs_base, ETH_MAC_KR_PCS_CONTROL_1_ADDR);
+		return !!(reg & AL_BIT(14));
+	case AL_ETH_MAC_MODE_XLG_LL_40G:
+	case AL_ETH_MAC_MODE_XLG_LL_50G:
+	case AL_ETH_MAC_MODE_XLG_LL_25G:
+		reg = al_eth_40g_pcs_reg_read(mac_regs_base,
+			ETH_MAC_GEN_V3_PCS_40G_CONTROL_STATUS_ADDR);
+		return !!(reg & AL_BIT(14));
+	default:
+		break;
+	}
+
+	return AL_FALSE;
+}
+
+static int mac_stats_get(struct al_eth_mac_obj *obj, struct al_eth_mac_stats *stats)
+{
+	struct al_eth_mac_regs *mac_regs_base = obj->mac_regs_base;
+	struct al_eth_mac_1g_stats __iomem *stats_1g = &mac_regs_base->mac_1g.stats;
+	struct al_eth_mac_10g_stats_v3_rx __iomem *stats_10g_rx =
+		&mac_regs_base->mac_10g.stats.v3.rx;
+	struct al_eth_mac_10g_stats_v3_tx __iomem *stats_10g_tx =
+		&mac_regs_base->mac_10g.stats.v3.tx;
+	uint64_t octets;
+
+	al_assert(stats);
+
+	al_memset(stats, 0, sizeof(struct al_eth_mac_stats));
+
+	switch (obj->mac_mode) {
+	case AL_ETH_MAC_MODE_SGMII:
+		stats->if_in_ucast_pkts = al_reg_read32(&stats_1g->if_in_ucast_pkts);
+		stats->if_in_mcast_pkts = al_reg_read32(&stats_1g->if_in_mcast_pkts);
+		stats->if_in_bcast_pkts = al_reg_read32(&stats_1g->if_in_bcast_pkts);
+		stats->pkts = al_reg_read32(&stats_1g->pkts);
+		stats->if_out_ucast_pkts = al_reg_read32(&stats_1g->if_out_ucast_pkts);
+		stats->if_out_mcast_pkts = al_reg_read32(&stats_1g->if_out_mcast_pkts);
+		stats->if_out_bcast_pkts = al_reg_read32(&stats_1g->if_out_bcast_pkts);
+		stats->if_in_errors = al_reg_read32(&stats_1g->if_in_errors);
+		stats->if_out_errors = al_reg_read32(&stats_1g->if_out_errors);
+		stats->frames_rxed_ok = al_reg_read32(&stats_1g->frames_rxed_ok);
+		stats->frames_txed_ok = al_reg_read32(&stats_1g->frames_txed_ok);
+		stats->octets_rxed_ok = al_reg_read32(&stats_1g->octets_rxed_ok);
+		stats->octets_txed_ok = al_reg_read32(&stats_1g->octets_txed_ok);
+		stats->undersize_pkts = al_reg_read32(&stats_1g->undersize_pkts);
+		stats->fragments = al_reg_read32(&stats_1g->fragments);
+		stats->jabbers = al_reg_read32(&stats_1g->jabbers);
+		stats->oversize_pkts = al_reg_read32(&stats_1g->oversize_pkts);
+		stats->fcs_errors =
+			al_reg_read32(&stats_1g->fcs_errors);
+		stats->alignment_errors = al_reg_read32(&stats_1g->alignment_errors);
+		stats->drop_events = al_reg_read32(&stats_1g->drop_events);
+		stats->pause_mac_ctrl_frames_txed =
+			al_reg_read32(&stats_1g->pause_mac_ctrl_frames_txed);
+		stats->pause_mac_ctrl_frames_rxed =
+			al_reg_read32(&stats_1g->pause_mac_ctrl_frames_rxed);
+		stats->frame_too_long_errs = 0; /* N/A */
+		stats->in_range_length_errs = 0; /* N/A */
+		stats->vlan_txed_ok = 0; /* N/A */
+		stats->vlan_rxed_ok = 0; /* N/A */
+		stats->octets = al_reg_read32(&stats_1g->octets);
+		stats->pkts_64_octets = al_reg_read32(&stats_1g->pkts_64_octets);
+		stats->pkts_65_to_127_octets =
+			al_reg_read32(&stats_1g->pkts_65_to_127_octets);
+		stats->pkts_128_to_255_octets =
+			al_reg_read32(&stats_1g->pkts_128_to_255_octets);
+		stats->pkts_256_to_511_octets =
+			al_reg_read32(&stats_1g->pkts_256_to_511_octets);
+		stats->pkts_512_to_1023_octets =
+			al_reg_read32(&stats_1g->pkts_512_to_1023_octets);
+		stats->pkts_1024_to_1518_octets =
+			al_reg_read32(&stats_1g->pkts_1024_to_1518_octets);
+		stats->pkts_1519_to_x = al_reg_read32(&stats_1g->pkts_1519_to_x);
+		break;
+	case AL_ETH_MAC_MODE_SGMII_2_5G:
+	case AL_ETH_MAC_MODE_10GbE_Serial:
+	case AL_ETH_MAC_MODE_KR_LL_25G:
+		stats->if_in_ucast_pkts = al_reg_read32(&stats_10g_rx->if_in_ucast_pkts);
+		stats->if_in_mcast_pkts = al_reg_read32(&stats_10g_rx->if_in_mcast_pkts);
+		stats->if_in_bcast_pkts = al_reg_read32(&stats_10g_rx->if_in_bcast_pkts);
+		stats->pkts = al_reg_read32(&stats_10g_rx->pkts);
+		stats->if_out_ucast_pkts = al_reg_read32(&stats_10g_tx->if_ucast_pkts);
+		stats->if_out_mcast_pkts = al_reg_read32(&stats_10g_tx->if_multicast_pkts);
+		stats->if_out_bcast_pkts = al_reg_read32(&stats_10g_tx->if_broadcast_pkts);
+		stats->if_in_errors = al_reg_read32(&stats_10g_rx->if_in_errors);
+		stats->if_out_errors = al_reg_read32(&stats_10g_tx->if_out_errors);
+		stats->frames_rxed_ok = al_reg_read32(&stats_10g_rx->frames_ok);
+		stats->frames_txed_ok = al_reg_read32(&stats_10g_tx->frames_ok);
+
+		/* octets_rxed_ok = if_in_octets - 18 * frames_rxed_ok - 4 * vlan_rxed_ok */
+		octets = al_reg_read32(&stats_10g_rx->if_octets_l);
+		octets |= (uint64_t)(al_reg_read32(&stats_10g_rx->if_octets_h)) << 32;
+		octets -= 18 * stats->frames_rxed_ok;
+		octets -= 4 * al_reg_read32(&stats_10g_rx->vlan_ok);
+		stats->octets_rxed_ok = octets;
+
+		/* octets_txed_ok = if_out_octets - 18 * frames_txed_ok
+		 * - 4 * vlan_txed_ok */
+		octets = al_reg_read32(&stats_10g_tx->if_octets_l);
+		octets |= (uint64_t)(al_reg_read32(&stats_10g_tx->if_octets_h)) << 32;
+		octets -= 18 * stats->frames_txed_ok;
+		octets -= 4 * al_reg_read32(&stats_10g_tx->vlan_ok);
+		stats->octets_txed_ok = octets;
+
+		stats->undersize_pkts =
+			al_reg_read32(&stats_10g_rx->undersize_pkts);
+		stats->fragments = al_reg_read32(&stats_10g_rx->fragments);
+		stats->jabbers = al_reg_read32(&stats_10g_rx->jabbers);
+		stats->oversize_pkts =
+			al_reg_read32(&stats_10g_rx->oversize_pkts);
+		stats->fcs_errors = al_reg_read32(&stats_10g_rx->crc_errs);
+		stats->alignment_errors = al_reg_read32(&stats_10g_rx->alignment_errors);
+		stats->drop_events = al_reg_read32(&stats_10g_rx->drop_events);
+		stats->pause_mac_ctrl_frames_txed =
+			al_reg_read32(&stats_10g_tx->pause_mac_ctrl_frames);
+		stats->pause_mac_ctrl_frames_rxed =
+			al_reg_read32(&stats_10g_rx->pause_mac_ctrl_frames);
+		stats->frame_too_long_errs = al_reg_read32(&stats_10g_rx->aFrameTooLong);
+		stats->in_range_length_errs = al_reg_read32(&stats_10g_rx->in_range_length_errs);
+		stats->vlan_txed_ok = al_reg_read32(&stats_10g_tx->vlan_ok);
+		stats->vlan_rxed_ok = al_reg_read32(&stats_10g_rx->vlan_ok);
+		stats->octets = al_reg_read32(&stats_10g_rx->octets);
+		stats->pkts_64_octets =
+			al_reg_read32(&stats_10g_rx->pkts_64_octets);
+		stats->pkts_65_to_127_octets =
+			al_reg_read32(&stats_10g_rx->pkts_65_to_127_octets);
+		stats->pkts_128_to_255_octets =
+			al_reg_read32(&stats_10g_rx->pkts_128_to_255_octets);
+		stats->pkts_256_to_511_octets =
+			al_reg_read32(&stats_10g_rx->pkts_256_to_511_octets);
+		stats->pkts_512_to_1023_octets =
+			al_reg_read32(&stats_10g_rx->pkts_512_to_1023_octets);
+		stats->pkts_1024_to_1518_octets =
+			al_reg_read32(&stats_10g_rx->pkts_1024_to_1518_octets);
+		stats->pkts_1519_to_x =
+			al_reg_read32(&stats_10g_rx->pkts1519toMax);
+		break;
+	case AL_ETH_MAC_MODE_XLG_LL_40G:
+	case AL_ETH_MAC_MODE_XLG_LL_50G:
+	case AL_ETH_MAC_MODE_XLG_LL_25G:
+		/* 40G MAC statistics registers are the same, only read indirectly */
+		#define _40g_mac_reg_read32(field)	al_eth_40g_mac_reg_read(mac_regs_base,	\
+			((uint8_t *)(field)) - ((uint8_t *)&mac_regs_base->mac_10g))
+
+		stats->if_in_ucast_pkts = _40g_mac_reg_read32(&stats_10g_rx->if_in_ucast_pkts);
+		stats->if_in_mcast_pkts = _40g_mac_reg_read32(&stats_10g_rx->if_in_mcast_pkts);
+		stats->if_in_bcast_pkts = _40g_mac_reg_read32(&stats_10g_rx->if_in_bcast_pkts);
+		stats->pkts = _40g_mac_reg_read32(&stats_10g_rx->pkts);
+		stats->if_out_ucast_pkts = _40g_mac_reg_read32(&stats_10g_tx->if_ucast_pkts);
+		stats->if_out_mcast_pkts = _40g_mac_reg_read32(&stats_10g_tx->if_multicast_pkts);
+		stats->if_out_bcast_pkts = _40g_mac_reg_read32(&stats_10g_tx->if_broadcast_pkts);
+		stats->if_in_errors = _40g_mac_reg_read32(&stats_10g_rx->if_in_errors);
+		stats->if_out_errors = _40g_mac_reg_read32(&stats_10g_tx->if_out_errors);
+		stats->frames_rxed_ok = _40g_mac_reg_read32(&stats_10g_rx->frames_ok);
+		stats->frames_txed_ok = _40g_mac_reg_read32(&stats_10g_tx->frames_ok);
+
+		/* octets_rxed_ok = if_in_octets - 18 * frames_rxed_ok - 4 * vlan_rxed_ok */
+		octets = _40g_mac_reg_read32(&stats_10g_rx->if_octets_l);
+		octets |= (uint64_t)(_40g_mac_reg_read32(&stats_10g_rx->if_octets_h)) << 32;
+		octets -= 18 * stats->frames_rxed_ok;
+		octets -= 4 * _40g_mac_reg_read32(&stats_10g_rx->vlan_ok);
+		stats->octets_rxed_ok = octets;
+
+		/* octets_txed_ok = if_out_octets - 18 * frames_txed_ok
+		 * - 4 * vlan_txed_ok */
+		octets = _40g_mac_reg_read32(&stats_10g_tx->if_octets_l);
+		octets |= (uint64_t)(_40g_mac_reg_read32(&stats_10g_tx->if_octets_h)) << 32;
+		octets -= 18 * stats->frames_txed_ok;
+		octets -= 4 * _40g_mac_reg_read32(&stats_10g_tx->vlan_ok);
+		stats->octets_txed_ok = octets;
+
+		stats->undersize_pkts =
+			_40g_mac_reg_read32(&stats_10g_rx->undersize_pkts);
+		stats->fragments =
+			_40g_mac_reg_read32(&stats_10g_rx->fragments);
+		stats->jabbers = _40g_mac_reg_read32(&stats_10g_rx->jabbers);
+		stats->oversize_pkts =
+			_40g_mac_reg_read32(&stats_10g_rx->oversize_pkts);
+		stats->fcs_errors = _40g_mac_reg_read32(&stats_10g_rx->crc_errs);
+		stats->alignment_errors = _40g_mac_reg_read32(&stats_10g_rx->alignment_errors);
+		stats->drop_events =
+			_40g_mac_reg_read32(&stats_10g_rx->drop_events);
+		stats->pause_mac_ctrl_frames_txed =
+			_40g_mac_reg_read32(&stats_10g_tx->pause_mac_ctrl_frames);
+		stats->pause_mac_ctrl_frames_rxed =
+			_40g_mac_reg_read32(&stats_10g_rx->pause_mac_ctrl_frames);
+		stats->frame_too_long_errs = _40g_mac_reg_read32(&stats_10g_rx->aFrameTooLong);
+		stats->in_range_length_errs =
+			_40g_mac_reg_read32(&stats_10g_rx->in_range_length_errs);
+		stats->vlan_txed_ok = _40g_mac_reg_read32(&stats_10g_tx->vlan_ok);
+		stats->vlan_rxed_ok = _40g_mac_reg_read32(&stats_10g_rx->vlan_ok);
+		stats->octets = _40g_mac_reg_read32(&stats_10g_rx->octets);
+		stats->pkts_64_octets =
+			_40g_mac_reg_read32(&stats_10g_rx->pkts_64_octets);
+		stats->pkts_65_to_127_octets =
+			_40g_mac_reg_read32(&stats_10g_rx->pkts_65_to_127_octets);
+		stats->pkts_128_to_255_octets =
+			_40g_mac_reg_read32(&stats_10g_rx->pkts_128_to_255_octets);
+		stats->pkts_256_to_511_octets =
+			_40g_mac_reg_read32(&stats_10g_rx->pkts_256_to_511_octets);
+		stats->pkts_512_to_1023_octets =
+			_40g_mac_reg_read32(&stats_10g_rx->pkts_512_to_1023_octets);
+		stats->pkts_1024_to_1518_octets =
+			_40g_mac_reg_read32(&stats_10g_rx->pkts_1024_to_1518_octets);
+		stats->pkts_1519_to_x =
+			_40g_mac_reg_read32(&stats_10g_rx->pkts1519toMax);
+
+		break;
+	default:
+		return -EPERM;
+	}
+
+	stats->eee_in = al_reg_read32(&mac_regs_base->stat.eee_in);
+	stats->eee_out = al_reg_read32(&mac_regs_base->stat.eee_out);
+
+	return 0;
+}
