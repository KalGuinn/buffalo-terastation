+/******************************************************************************
+ ******************************************************************************/
+void al_mod_unit_adapter_err_attr_print(struct al_mod_unit_adapter *unit_adapter, al_mod_bool is_read)
+{
+	struct al_mod_unit_adapter_err_attr err_attr;
+	uint64_t error_address;
+
+	al_mod_assert(unit_adapter);
+
+	if (is_read)
+		al_mod_unit_adapter_axi_master_rd_err_attr_get_and_clear(unit_adapter, &err_attr);
+	else
+		al_mod_unit_adapter_axi_master_wr_err_attr_get_and_clear(unit_adapter, &err_attr);
+
+	al_mod_print("Error Attributes Type: %s\n", is_read ? "READ" : "WRITE");
+	if (is_read)
+		al_mod_print("- read_parity_error = %s\n",
+			 err_attr.read_parity_error ? "True" : "False");
+	al_mod_print("- error_blocked = %s\n", err_attr.error_blocked  ? "True" : "False");
+	al_mod_print("- completion_timeout = %s\n", err_attr.completion_timeout ? "True" : "False");
+	al_mod_print("- completion_error = %s\n", err_attr.completion_error ? "True" : "False");
+	al_mod_print("- address_timeout = %s\n", err_attr.address_timeout ? "True" : "False");
+	al_mod_print("- error_master_id = 0x%x\n", err_attr.error_master_id);
+	al_mod_print("- error_completion_status = 0x%x\n",  err_attr.error_completion_status);
+
+	/* Address latching is not available on Alpine V3 - will print 0 */
+	error_address = (((uint64_t)err_attr.error_address_latch_hi << 32) |
+			 err_attr.error_address_latch_lo);
+	al_mod_print("-  (Not valid on Alpine V3) error_address = 0x%016" PRIx64 "\n", error_address);
+}
+/** @} */
