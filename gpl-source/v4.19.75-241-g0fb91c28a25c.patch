+static uint16_t al_nand_onfi_crc16(
+	uint8_t *buff,
+	unsigned int buff_size)
+{
+	uint16_t crc;
+	int i;
+
+	crc = 0x4f4e;
+	for (; buff_size; buff++, buff_size--) {
+		crc = crc ^ ((uint16_t)(*buff) << 8);
+		for (i = 0; i < 8; i++)
+			if (crc & 0x8000)
+				crc = (crc << 1) ^ 0x8005;
+			else
+				crc = crc << 1;
+	}
+
+	return crc;
+}
