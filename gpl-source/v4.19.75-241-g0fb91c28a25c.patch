+#define NB_V1_V2_SRIOV_CPU2_TGTID_VAL_SHIFT     0
+
+/**** cpu3_tgtid register ****/
+/* Target TGTID */
+#define NB_V1_V2_SRIOV_CPU3_TGTID_VAL_MASK      0x000000FF
+#define NB_V1_V2_SRIOV_CPU3_TGTID_VAL_SHIFT     0
+
+/**** DRAM_0_Control register ****/
+/*
+ * Controller Idle
+ * Indicates to the DDR PHY, if set, that the memory controller is idle
+ */
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_CONTROL_DDR_PHY_CTL_IDLE (1 << 0)
+/*
+ * Disable clear exclusive monitor request from DDR controller to CPU
+ * Clear request is triggered whenever an exlusive monitor inside the DDR controller is being
+ * invalidated.
+ */
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_CONTROL_DDR_EXMON_REQ_DIS (1 << 1)
+
+/**** DRAM_0_Status register ****/
+/* Bypass Mode: Indicates if set that the PHY is in PLL bypass mod */
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_STATUS_DDR_PHY_BYP_MODE (1 << 0)
+/* Number of available AXI transactions (used positions) in the DDR controller read address FIFO. */
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_STATUS_RAQ_WCOUNT_MASK 0x00000030
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_STATUS_RAQ_WCOUNT_SHIFT 4
+/* Number of available AXI transactions (used positions) in the DDR controller write address FIFO */
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_STATUS_WAQ_WCOUNT_0_MASK 0x000000C0
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_STATUS_WAQ_WCOUNT_0_SHIFT 6
+/*
+ * Number of available Low priority read CAM slots (free positions) in  the DDR controller.
+ * Each slots holds a DRAM burst
+ */
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_STATUS_LPR_CREDIT_CNT_MASK 0x00007F00
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_STATUS_LPR_CREDIT_CNT_SHIFT 8
+/*
+ * Number of available High priority read CAM slots (free positions) in  the DDR controller.
+ * Each slots holds a DRAM burst
+ */
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_STATUS_HPR_CREDIT_CNT_MASK 0x003F8000
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_STATUS_HPR_CREDIT_CNT_SHIFT 15
+/*
+ * Number of available write CAM slots (free positions) in  the DDR controller.
+ * Each slots holds a DRAM burst
+ */
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_STATUS_WR_CREDIT_CNT_MASK 0x1FC00000
+#define NB_V1_V2_DRAM_CHANNELS_DRAM_0_STATUS_WR_CREDIT_CNT_SHIFT 22
+
+/**** DDR_Int_Cause register ****/
+/* This interrupt is asserted when a correctable ECC error is detected */
+#define NB_V1_V2_DRAM_CHANNELS_DDR_INT_CAUSE_ECC_CORRECTED_ERR (1 << 0)
+/* This interrupt is asserted when a uncorrectable ECC error is detected */
+#define NB_V1_V2_DRAM_CHANNELS_DDR_INT_CAUSE_ECC_UNCORRECTED_ERR (1 << 1)
+/* This interrupt is asserted when a parity or CRC error is detected on the DFI interface */
+#define NB_V1_V2_DRAM_CHANNELS_DDR_INT_CAUSE_DFI_ALERT_ERR (1 << 2)
+/* On-Chip Write data parity error interrupt on output */
+#define NB_V1_V2_DRAM_CHANNELS_DDR_INT_CAUSE_PAR_WDATA_OUT_ERR (1 << 3)
+/* This interrupt is asserted when a parity error due to MRS is detected on the DFI interface */
+#define NB_V1_V2_DRAM_CHANNELS_DDR_INT_CAUSE_DFI_ALERT_ERR_FATL (1 << 4)
+/* This interrupt is asserted when the CRC/parity retry counter reaches it maximum value */
+#define NB_V1_V2_DRAM_CHANNELS_DDR_INT_CAUSE_DFI_ALERT_ERR_MAX_REACHED (1 << 5)
+/*
+ * AXI Read address parity error interrupt.
+ * This interrupt is asserted when an on-chip parity error occurred on the DDR controller AXI read
+ * address.
+ */
+#define NB_V1_V2_DRAM_CHANNELS_DDR_INT_CAUSE_PAR_RADDR_ERR (1 << 6)
+/*
+ * AXI Read data parity error interrupt.
+ * This interrupt is asserted when an on-chip parity error occurred on the DDR controller AXI read
+ * data
+ */
+#define NB_V1_V2_DRAM_CHANNELS_DDR_INT_CAUSE_PAR_RDATA_ERR (1 << 7)
+/*
+ * AXI Write address parity error interrupt.
+ * This interrupt is asserted when an on-chip parity error occurred on the DDR controller AXI write
+ * address.
+ */
+#define NB_V1_V2_DRAM_CHANNELS_DDR_INT_CAUSE_PAR_WADDR_ERR (1 << 8)
+/*
+ * AXI Write data parity error interrupt on input.
+ * This interrupt is asserted when an on-chip parity error occurred on the DDR controller AXI write
+ * data
+ */
+#define NB_V1_V2_DRAM_CHANNELS_DDR_INT_CAUSE_PAR_WDATA_IN_ERR (1 << 9)
+
+/**** Address_Map register ****/
+/*
+ * Controls which system address bit will be mapped to DDR row bit 2.
+ * This field is only used when addrmap_part_en == 1
+ */
+#define NB_V1_V2_DRAM_CHANNELS_ADDRESS_MAP_ADDRMAP_ROW_B2_MASK 0x0000000F
+#define NB_V1_V2_DRAM_CHANNELS_ADDRESS_MAP_ADDRMAP_ROW_B2_SHIFT 0
+/*
+ * Controls which system address bit will be mapped to DDR row bit 3.
+ * This field is only used when addrmap_part_en == 1
+ */
+#define NB_V1_V2_DRAM_CHANNELS_ADDRESS_MAP_ADDRMAP_ROW_B3_MASK 0x000003C0
+#define NB_V1_V2_DRAM_CHANNELS_ADDRESS_MAP_ADDRMAP_ROW_B3_SHIFT 6
+/*
+ * Controls which system address bit will be mapped to DDR row bit 4.
+ * This field is only used when addrmap_part_en == 1
+ */
+#define NB_V1_V2_DRAM_CHANNELS_ADDRESS_MAP_ADDRMAP_ROW_B4_MASK 0x0000F000
+#define NB_V1_V2_DRAM_CHANNELS_ADDRESS_MAP_ADDRMAP_ROW_B4_SHIFT 12
+/*
+ * Controls which system address bit will be mapped to DDR row bit 5.
+ * This field is only used when addrmap_part_en == 1
+ */
+#define NB_V1_V2_DRAM_CHANNELS_ADDRESS_MAP_ADDRMAP_ROW_B5_MASK 0x003C0000
+#define NB_V1_V2_DRAM_CHANNELS_ADDRESS_MAP_ADDRMAP_ROW_B5_SHIFT 18
+/*
+ * Enables partitioning of the address mapping control.
+ * When set, addrmap_row_b2-5 are used inside DDR controler instead of the built in address mapping
+ * registers
+ */
+#define NB_V1_V2_DRAM_CHANNELS_ADDRESS_MAP_ADDRMAP_PART_EN (1 << 31)
+
+/**** Reorder_ID_Mask_0 register ****/
+/*
+ * DDR Read Reorder buffer ID mask.
+ * If incoming read transaction ID ANDed with mask is equal Reorder_ID_Value, then the transaction
+ * is mapped to the DDR controller bypass channel.
+ * Setting this register to 0 will disable the check
+ */
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_MASK_0_MASK_MASK 0x003FFFFF
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_MASK_0_MASK_SHIFT 0
+
+/**** Reorder_ID_Value_0 register ****/
+/*
+ * DDR Read Reorder buffer ID value
+ * If incoming read transaction ID ANDed with Reorder_ID_Mask is equal to this register, then the
+ * transaction is mapped to the DDR controller bypass channel
+ */
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_VALUE_0_VALUE_MASK 0x003FFFFF
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_VALUE_0_VALUE_SHIFT 0
+
+/**** Reorder_ID_Mask_1 register ****/
+/*
+ * DDR Read Reorder buffer ID mask.
+ * If incoming read transaction ID ANDed with mask is equal Reorder_ID_Value, then the transaction
+ * is mapped to the DDR controller bypass channel.
+ * Setting this register to 0 will disable the check
+ */
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_MASK_1_MASK_MASK 0x003FFFFF
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_MASK_1_MASK_SHIFT 0
+
+/**** Reorder_ID_Value_1 register ****/
+/*
+ * DDR Read Reorder buffer ID value
+ * If incoming read transaction ID ANDed with Reorder_ID_Mask is equal to this register, then the
+ * transaction is mapped to the DDR controller bypass channel
+ */
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_VALUE_1_VALUE_MASK 0x003FFFFF
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_VALUE_1_VALUE_SHIFT 0
+
+/**** Reorder_ID_Mask_2 register ****/
+/*
+ * DDR Read Reorder buffer ID mask.
+ * If incoming read transaction ID ANDed with mask is equal Reorder_ID_Value, then the transaction
+ * is mapped to the DDR controller bypass channel.
+ * Setting this register to 0 will disable the check
+ */
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_MASK_2_MASK_MASK 0x003FFFFF
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_MASK_2_MASK_SHIFT 0
+
+/**** Reorder_ID_Value_2 register ****/
+/*
+ * DDR Read Reorder buffer ID value
+ * If incoming read transaction ID ANDed with Reorder_ID_Mask is equal to this register, then the
+ * transaction is mapped to the DDR controller bypass channel
+ */
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_VALUE_2_VALUE_MASK 0x003FFFFF
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_VALUE_2_VALUE_SHIFT 0
+
+/**** Reorder_ID_Mask_3 register ****/
+/*
+ * DDR Read Reorder buffer ID mask.
+ * If incoming read transaction ID ANDed with mask is equal Reorder_ID_Value, then the transaction
+ * is mapped to the DDR controller bypass channel.
+ * Setting this register to 0 will disable the check
+ */
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_MASK_3_MASK_MASK 0x003FFFFF
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_MASK_3_MASK_SHIFT 0
+
+/**** Reorder_ID_Value_3 register ****/
+/*
+ * DDR Read Reorder buffer ID value
+ * If incoming read transaction ID ANDed with Reorder_ID_Mask is equal to this register, then the
+ * transaction is mapped to the DDR controller bypass channel
+ */
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_VALUE_3_VALUE_MASK 0x003FFFFF
+#define NB_V1_V2_DRAM_CHANNELS_REORDER_ID_VALUE_3_VALUE_SHIFT 0
+
+/**** MRR_Control_Status register ****/
+/* DDR4 Mode Register Read Data Valid */
+#define NB_V1_V2_DRAM_CHANNELS_MRR_CONTROL_STATUS_MRR_VLD (1 << 0)
+/*
+ * MRR Ack, when asserted it clears the mrr_val indication and ready to load new MRR data. Write 1
+ * to clear and then 0
+ */
+#define NB_V1_V2_DRAM_CHANNELS_MRR_CONTROL_STATUS_MRR_ACK (1 << 16)
+
+/**** pp_config register ****/
+/* Bypass PP module (formality equivalent) */
+#define NB_V1_V2_PUSH_PACKET_PP_CONFIG_FM_BYPASS (1 << 0)
+/* Bypass PP module */
+#define NB_V1_V2_PUSH_PACKET_PP_CONFIG_BYPASS  (1 << 1)
+/* Force Cleanup of entries */
+#define NB_V1_V2_PUSH_PACKET_PP_CONFIG_CLEAR   (1 << 2)
+/* Enable forwarding DECERR response */
+#define NB_V1_V2_PUSH_PACKET_PP_CONFIG_DECERR_EN (1 << 3)
+/* Enable forwarding SLVERR response */
+#define NB_V1_V2_PUSH_PACKET_PP_CONFIG_SLVERR_EN (1 << 4)
+/* Enable forwarding of data parity generation */
+#define NB_V1_V2_PUSH_PACKET_PP_CONFIG_PAR_GEN_EN (1 << 5)
+/* Select channel on 8K boundaries ([15:13]) instead of 64k boundaries ([18:16]). */
+#define NB_V1_V2_PUSH_PACKET_PP_CONFIG_SEL_8K  (1 << 6)
+/*
+ * Forces awuser to be as configured in ext_awuser register.
+ * Not functional
+ */
+#define NB_V1_V2_PUSH_PACKET_PP_CONFIG_SEL_EXT_AWUSER (1 << 7)
+/*
+ * Enables PP channel.
+ * 1 bit per channel
+ */
+#define NB_V1_V2_PUSH_PACKET_PP_CONFIG_CHANNEL_ENABLE_MASK 0x00030000
+#define NB_V1_V2_PUSH_PACKET_PP_CONFIG_CHANNEL_ENABLE_SHIFT 16
+
+/**** pp_ext_awuser register ****/
+/*
+ * Awuser to use on PP transactions
+ * Only applicable if config.sel_ext_awuser is set to 1'b1
+ * Parity bits are still generated per transaction
+ */
+#define NB_V1_V2_PUSH_PACKET_PP_EXT_AWUSER_AWUSER_MASK 0x03FFFFFF
+#define NB_V1_V2_PUSH_PACKET_PP_EXT_AWUSER_AWUSER_SHIFT 0
+
+/**** pp_sel_awuser register ****/
+/*
+ * Select whether to use addr[63:48] or PP awmisc as tgtid.
+ * Each bit if set to 1 selects the corresponding address bit. Otherwise, selects the corersponding
+ * awmis bit.
+ */
+#define NB_V1_V2_PUSH_PACKET_PP_SEL_AWUSER_SEL_MASK 0x0000FFFF
+#define NB_V1_V2_PUSH_PACKET_PP_SEL_AWUSER_SEL_SHIFT 0
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
+
+/** @} */
+
+
