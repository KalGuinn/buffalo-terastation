+struct al_mod_serdes_mode_rx_tx_inv_state {
+	al_mod_bool		restore;
+	uint32_t	pipe_rst;
+	uint32_t	ipd_multi[AL_SRDS_NUM_LANES];
+	uint8_t		inv_value[AL_SRDS_NUM_LANES];
+};
+
+static void al_mod_serdes_mode_rx_tx_inv_state_save(
+	struct al_mod_serdes_grp_obj		*obj,
+	struct al_mod_serdes_mode_rx_tx_inv_state	*state)
+{
+	struct al_mod_serdes_regs __iomem	*regs_base = obj->regs_base;
+	al_mod_memset(state, 0, sizeof(struct al_mod_serdes_mode_rx_tx_inv_state));
+
+	if (al_mod_reg_read32(&regs_base->gen.irst) & SERDES_GEN_IRST_POR_B_A) {
+		int i;
+
+		state->restore = AL_TRUE;
+		state->pipe_rst = al_mod_reg_read32(&regs_base->gen.irst);
+
+		for (i = 0; i < AL_SRDS_NUM_LANES; i++) {
+			state->inv_value[i] = al_mod_serdes_grp_reg_read(
+				obj,
+				i,
+				AL_SRDS_REG_TYPE_PMA,
+				SERDES_IREG_FLD_POLARITY_RX_REG_NUM);
+			state->ipd_multi[i] =
+				al_mod_reg_read32(&regs_base->lane[i].ipd_multi);
+		}
+	} else {
+		state->restore = AL_FALSE;
+	}
+}
+
+static void al_mod_serdes_mode_rx_tx_inv_state_restore(
+	struct al_mod_serdes_grp_obj		*obj,
+	struct al_mod_serdes_mode_rx_tx_inv_state	*state)
+{
+	struct al_mod_serdes_regs __iomem	*regs_base = obj->regs_base;
+
+	if (state->restore) {
+		int i;
+
+		for (i = 0; i < AL_SRDS_NUM_LANES; i++) {
+			al_mod_serdes_grp_reg_write(
+				obj,
+				i,
+				AL_SRDS_REG_TYPE_PMA,
+				SERDES_IREG_FLD_POLARITY_RX_REG_NUM,
+				state->inv_value[i]);
+			al_mod_reg_write32(
+				&regs_base->lane[i].ipd_multi, state->ipd_multi[i]);
+			al_mod_reg_write32_masked(
+				&regs_base->gen.irst,
+				(SERDES_GEN_IRST_PIPE_RST_L0_B_A_SEL >> i) |
+				(SERDES_GEN_IRST_PIPE_RST_L0_B_A >> i),
+				state->pipe_rst);
+		}
+	}
+}
