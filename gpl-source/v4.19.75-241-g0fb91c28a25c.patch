+/******************************************************************************
+ ******************************************************************************/
+void al_mod_unit_adapter_init(
+		struct al_mod_unit_adapter	*unit_adapter)
+{
+	int func_num;
+
+	al_mod_assert(unit_adapter);
+
+	for (func_num = 0; func_num < AL_ADAPTER_SMCC_BUNDLE_NUM; func_num++) {
+		/* i/o cache coherency enablement */
+		al_mod_unit_adapter_snoop_enable(unit_adapter,
+				func_num, AL_TRUE);
+	}
+	/* Error tracking disable */
+	al_mod_unit_adapter_error_track_enable(unit_adapter,
+			0, AL_FALSE);
+	/* ROB/WOB enable */
+	al_mod_unit_adapter_rob_cfg(unit_adapter,
+		AL_TRUE, AL_FALSE, AL_TRUE, AL_FALSE);
+}
