+/* TODO: check if this function needed */
+int al_pcie_link_change_width(struct al_pcie_port *pcie_port,
+			      uint8_t width __attribute__((__unused__)))
+{
+	al_err("PCIe %d: link change width not implemented\n",
+		pcie_port->port_id);
+
+	return -ENOSYS;
+}
