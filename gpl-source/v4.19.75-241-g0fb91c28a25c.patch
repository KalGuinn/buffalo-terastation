+#define AL_I2C_STATUS_MST_ACTIVITY_SHIFT	0x5
+#define AL_I2C_STATUS_MST_ACTIVITY_MASK		(0x1<< \
+		AL_I2C_STATUS_MST_ACTIVITY_SHIFT)
+#define AL_I2C_STATUS_MST_ACTIVITY_NOT_ACTIVE	(0x0<< \
+		AL_I2C_STATUS_MST_ACTIVITY_SHIFT)
