+#define AL_ETH_SHARED_RESOURCE_PMDT_BASE	0
+#define AL_ETH_SHARED_CACHE_PMDT_BASE		0
+#define AL_ETH_EC_PMDT_BASE(i)		0
+#define AL_DDRC_PMDT_BASE(i)		0
