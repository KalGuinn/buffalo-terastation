+/******************************************************************************/
+/******************************************************************************/
+#define SERDES_25G_GEN_CTRL_SPEED_10G	9
+#define SERDES_25G_GEN_CTRL_SPEED_25G	2
+
+static void al_serdes_25g_mode_class_get(__attribute__ ((unused)) struct al_serdes_grp_obj *obj,
+				enum al_serdes_group_mode_class *serdes_group_mode_class)
+{
+	/* Currently Serdes Group E is used only for ETH mode_class*/
+	*serdes_group_mode_class = AL_SRDS_MODE_CLASS_ETH;
+}
+
+static int al_serdes_25g_mode_get(struct al_serdes_grp_obj *obj,
+				enum al_serdes_group_mode *serdes_group_mode)
+{
+	struct al_serdes_c_regs __iomem *regs_base = obj->regs_base;
+	uint32_t reg;
+	unsigned int serdes_25g_speed;
+
+	reg = al_reg_read32(&regs_base->gen.ctrl);
+	serdes_25g_speed = AL_REG_FIELD_GET(reg,
+					SERDES_C_GEN_CTRL_PHY_CTRL_CFG_MASK,
+					SERDES_C_GEN_CTRL_PHY_CTRL_CFG_SHIFT);
+
+	switch (serdes_25g_speed) {
+	case SERDES_25G_GEN_CTRL_SPEED_25G:
+		*serdes_group_mode = AL_SRDS_CFG_ETH_25G;
+		break;
+	case SERDES_25G_GEN_CTRL_SPEED_10G:
+		*serdes_group_mode = AL_SRDS_CFG_KR;
+		break;
+	default:
+		al_err("%s: Unable to determine the serdes_group_mode (read 0x%x)\n", __func__,
+			serdes_25g_speed);
+		return -EIO;
+	}
+
+	al_dbg("%s: serdes_group_mode is %d\n", __func__, *serdes_group_mode);
+
+	return 0;
+}
+
+/******************************************************************************/
+/******************************************************************************/
+int al_serdes_25g_handle_init(
+	void __iomem			*serdes_regs_base,
+	struct al_serdes_grp_obj	*obj)
+{
+	al_dbg(
+		"%s(%p, %p)\n",
+		__func__,
+		serdes_regs_base,
+		obj);
+
+	al_memset(obj, 0, sizeof(struct al_serdes_grp_obj));
+
+	obj->regs_base = (struct al_serdes_regs *)serdes_regs_base;
+	obj->type_get = al_serdes_25g_type_get;
+	obj->reg_read = al_serdes_25g_reg_read;
+	obj->reg_write = al_serdes_25g_reg_write;
+	obj->bist_pattern_select = AL_SRDS_ADV_SRVC(al_serdes_25g_bist_pattern_select);
+	obj->bist_tx_enable = AL_SRDS_ADV_SRVC(al_serdes_25g_bist_tx_enable);
+	obj->bist_rx_enable = AL_SRDS_ADV_SRVC(al_serdes_25g_bist_rx_enable);
+	obj->bist_rx_status = AL_SRDS_ADV_SRVC(al_serdes_25g_bist_rx_status);
