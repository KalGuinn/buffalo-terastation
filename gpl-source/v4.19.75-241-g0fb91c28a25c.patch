+static int fec_enable(struct al_eth_mac_obj *obj, enum al_eth_fec_type type, al_bool enable)
+{
+	struct al_eth_mac_regs *mac_regs_base = obj->mac_regs_base;
+
+	switch (type) {
+	case AL_ETH_FEC_TYPE_CLAUSE_74:
+		al_reg_write32_masked(&mac_regs_base->gen_v3.pcs_10g_ll_cfg,
+			(ETH_MAC_GEN_V3_PCS_10G_LL_CFG_FEC_EN_RX |
+				ETH_MAC_GEN_V3_PCS_10G_LL_CFG_FEC_EN_TX),
+				(enable ? (ETH_MAC_GEN_V3_PCS_10G_LL_CFG_FEC_EN_RX |
+					ETH_MAC_GEN_V3_PCS_10G_LL_CFG_FEC_EN_TX) : 0));
+		break;
+	default:
+		return -EPERM;
+	}
+
+	return 0;
+}
+
+static al_bool fec_is_enabled(struct al_eth_mac_obj *obj)
+{
+	struct al_eth_mac_regs *mac_regs_base = obj->mac_regs_base;
+	uint32_t reg;
+
+	reg = al_reg_read32(&mac_regs_base->gen_v3.pcs_10g_ll_cfg);
+	if (!(reg & ETH_MAC_GEN_V3_PCS_10G_LL_CFG_FEC_EN_RX) ||
+	    !(reg & ETH_MAC_GEN_V3_PCS_10G_LL_CFG_FEC_EN_TX))
+		return AL_FALSE;
+
+	return AL_TRUE;
+}
