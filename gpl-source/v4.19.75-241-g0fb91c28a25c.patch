+/* trigger speed change */
+int al_mod_pcie_link_change_speed(struct al_mod_pcie_port *pcie_port,
+			      enum al_mod_pcie_link_speed new_speed)
+{
+	struct al_mod_pcie_regs *regs = pcie_port->regs;
