+extern "C" {
+#endif
+/* *INDENT-ON* */
+
+/* UDMA register print helper macros */
+#define AL_UDMA_PRINT_REG(UDMA, PREFIX, POSTFIX, TYPE, GROUP, REG) \
+	al_mod_dbg(PREFIX #REG " = 0x%08x" POSTFIX, al_mod_reg_read32( \
+		&(UDMA->udma_regs->TYPE.GROUP.REG)))
+
+#define AL_UDMA_PRINT_REG_FIELD( \
+		UDMA, PREFIX, POSTFIX, FMT, TYPE, GROUP, REG, LBL, FIELD) \
+	al_mod_dbg(PREFIX #LBL " = " FMT POSTFIX, (al_mod_reg_read32( \
+			&(UDMA->udma_regs->TYPE.GROUP.REG)) \
+			& FIELD ## _MASK) >> FIELD ## _SHIFT)
+
+#define AL_UDMA_PRINT_REG_BIT( \
+		UDMA, PREFIX, POSTFIX, TYPE, GROUP, REG, LBL, FIELD) \
+	al_mod_dbg(PREFIX #LBL " = %d" POSTFIX, ((al_mod_reg_read32( \
+			&(UDMA->udma_regs->TYPE.GROUP.REG)) \
+			& FIELD) != 0))
+
+/* UDMA register print mask definitions */
+#define AL_UDMA_DEBUG_QUEUE(n)			AL_BIT(n)
+#define AL_UDMA_DEBUG_AXI			AL_BIT(DMA_MAX_Q_MAX)
+#define AL_UDMA_DEBUG_GENERAL			AL_BIT(DMA_MAX_Q_MAX + 1)
+#define AL_UDMA_DEBUG_READ			AL_BIT(DMA_MAX_Q_MAX + 2)
+#define AL_UDMA_DEBUG_WRITE			AL_BIT(DMA_MAX_Q_MAX + 3)
+#define AL_UDMA_DEBUG_DWRR			AL_BIT(DMA_MAX_Q_MAX + 4)
+#define AL_UDMA_DEBUG_RATE_LIMITER		AL_BIT(DMA_MAX_Q_MAX + 5)
+#define AL_UDMA_DEBUG_STREAM_RATE_LIMITER	AL_BIT(DMA_MAX_Q_MAX + 6)
+#define AL_UDMA_DEBUG_COMP			AL_BIT(DMA_MAX_Q_MAX + 7)
+#define AL_UDMA_DEBUG_STAT			AL_BIT(DMA_MAX_Q_MAX + 8)
+#define AL_UDMA_DEBUG_FEATURE			AL_BIT(DMA_MAX_Q_MAX + 9)
+#define AL_UDMA_DEBUG_ALL			0xFFFFFFFF
+
+/* Debug functions */
+
+/**
+ * Print udma registers according to the provided mask
+ *
+ * @param udma udma data structure
+ * @param mask mask that specifies which registers groups to print
+ * e.g. AL_UDMA_DEBUG_AXI prints AXI registers, AL_UDMA_DEBUG_ALL prints all
+ * registers
+ */
+void al_mod_udma_regs_print(struct al_mod_udma *udma, unsigned int mask);
+
+/**
+ * Print udma queue software structure
+ *
+ * @param udma udma data structure
+ * @param qid queue index
+ */
+void al_mod_udma_q_struct_print(struct al_mod_udma *udma, uint32_t qid);
+
+/** UDMA ring type */
+enum al_mod_udma_ring_type {
+	AL_RING_SUBMISSION,
+	AL_RING_COMPLETION
+};
+
+/**
+ * Print the ring entries for the specified queue index and ring type
+ * (submission/completion)
+ *
+ * @param udma udma data structure
+ * @param qid queue index
+ * @param rtype udma ring type
+ */
+void al_mod_udma_ring_print(struct al_mod_udma *udma, uint32_t qid,
+		enum al_mod_udma_ring_type rtype);
+
+/**
+ * Print the ring entries around the current completion head pointer for the specified queue index
+ * and ring type (submission/completion). This prints MIN(num_of_descs_pre_comp_head descriptors,
+ * ring size - 1) descs before the completion head pointer and till the descriptor tail pointer
+ * (for submission) or until the completion head (for completion)
+ *
+ * @param udma udma data structure
+ * @param qid queue index
+ * @param rtype udma ring type
+ * @param num_of_descs_pre_comp_head num of descs to print before the completion head pointer
+ */
+void al_mod_udma_ring_descs_around_comp_print(struct al_mod_udma *udma, uint32_t qid,
+					  enum al_mod_udma_ring_type rtype,
+					  unsigned int num_of_descs_pre_comp_head);
+
+
+/* *INDENT-OFF* */
+#ifdef __cplusplus
+}
+#endif
+/* *INDENT-ON* */
+#endif /* __AL_HAL_UDMA_DEBUG_H__ */
