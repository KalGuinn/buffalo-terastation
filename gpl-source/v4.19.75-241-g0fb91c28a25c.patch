+/**
+ * Snooping enable/disable
+ *
+ * @param	unit_adapter
+ *		The unit_adapter instance
+ * @param	func_num
+ *		Function number
+ * @param	snoop_en
+ *		Snooping enabled
+ */
+void al_unit_adapter_snoop_enable(
+	struct al_unit_adapter	*unit_adapter,
+	unsigned int	func_num,
