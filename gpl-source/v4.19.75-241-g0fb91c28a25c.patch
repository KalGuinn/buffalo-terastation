+#define PCIE_REV1_2_AXI_CTRL_GLOBAL_PARITY_CALC_EN_MSTR (1 << 16)
+#define PCIE_REV3_4_AXI_CTRL_GLOBAL_PARITY_CALC_EN_MSTR (1 << 18)
