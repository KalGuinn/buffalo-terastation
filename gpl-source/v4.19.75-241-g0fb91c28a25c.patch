+int al_mod_eth_switching_default_bitmap_set(struct al_mod_hal_eth_adapter *adapter, uint8_t udma_id, uint8_t udma_uc_bitmask,
+						uint8_t udma_mc_bitmask,uint8_t udma_bc_bitmask)
