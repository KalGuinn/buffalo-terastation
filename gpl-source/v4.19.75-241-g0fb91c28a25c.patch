+static int al_eth_lm_retimer_i2c_write(void *i2c_context,
+	enum al_i2c_master_t i2c_master __attribute__((unused)),
+	unsigned int i2c_bus, unsigned int i2c_addr,
+	unsigned int reg_addr, uint8_t val)
