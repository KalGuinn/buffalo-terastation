+ * 2T timing, all command signals (except chip select) are held for 2
+ * clocks on the SDRAM bus. Chip select is asserted on the second cycle
+ * of the command
+ *
+ * Required value: 1
+ */
+static const unsigned int en_2t_timing_mode = 1;
+
+/**
