+#define sa_init_field(dest, val, mask, shift, str)\
+	do {\
+		al_assert(!((val << shift) & ~(mask)));\
+		al_debug(" SA %s - %x\n", str, val); \
+		dest |= (val << shift) & mask;\
+	} while (0);
