+#define PCIE_REV1_2_AXI_CTRL_GLOBAL_PARITY_ERR_EN_RD (1 << 17)
+#define PCIE_REV3_4_AXI_CTRL_GLOBAL_PARITY_ERR_EN_RD (1 << 19)
