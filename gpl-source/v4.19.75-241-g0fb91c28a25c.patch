+		0);
+
+	al_reg_write32_masked(
+		&ctrl_regs->mstr,
+		(DWC_DDR_UMCTL2_REGS_MSTR_ACTIVE_RANKS_MASK |
+		DWC_DDR_UMCTL2_REGS_MSTR_DATA_BUS_WIDTH_MASK |
+		DWC_DDR_UMCTL2_REGS_MSTR_EN_2T_TIMING_MODE |
