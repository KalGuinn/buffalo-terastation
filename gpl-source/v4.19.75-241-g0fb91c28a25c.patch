+int al_sbus_read(
+	const struct al_sbus_obj	*obj,
+	unsigned int			receiver_addr,
+	unsigned int			data_addr,
+	unsigned int			*data)
+{
+	unsigned int mutex_user_idx = al_sbus_slave_addr_to_mutex_user_idx(receiver_addr);
