+		data[i] = al_mod_reg_read32(&adapter->ec_regs_base->tso.cache_table_data_1 + i);
+		al_mod_dbg("%s: cache_table_data_%d:0x%08x\n", __func__, i, data[i]);
+
+		if (arr)
+			arr[i] = data[i];
+	}
+}
