+ * 001 = 688 ohms
+ * 010 = 611 ohms
+ * 011 = 550 ohms
+ * 100 = 500 ohms
+ * 101 = 458 ohms
+ * 110 = 393 ohms
+ * 111 = 344 ohms
+ */
+#define DWC_DDR_PHY_REGS_DXCCR_DQSRES_MASK			0x000001e0
+#define DWC_DDR_PHY_REGS_DXCCR_DQSRES_SHIFT			5
