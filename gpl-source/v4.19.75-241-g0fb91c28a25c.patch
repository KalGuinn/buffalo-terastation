+/******************************************************************************/
+/******************************************************************************/
+#define SERDES_LANE_ICTL_MULTI_SATA_CONFIG 0x30990034
+
+#define SERDES_HSSP_SPEED_MASK		(SERDES_LANE_ICTL_MULTI_RXRATE_L_MASK | \
+					SERDES_LANE_ICTL_MULTI_TXRATE_L_MASK)
+#define SERDES_HSSP_SPEED(c)					\
+	(((c) << SERDES_LANE_ICTL_MULTI_RXRATE_L_SHIFT) |	\
+	 ((c) << SERDES_LANE_ICTL_MULTI_TXRATE_L_SHIFT))
+#define SERDES_HSSP_SPEED_1G		SERDES_HSSP_SPEED(1)
+#define SERDES_HSSP_SPEED_2_5G		SERDES_HSSP_SPEED(2)
+#define SERDES_HSSP_SPEED_10G		SERDES_HSSP_SPEED(3)
+
+static void al_serdes_hssp_mode_class_get(struct al_serdes_grp_obj *obj,
+					enum al_serdes_group_mode_class *serdes_group_mode_class)
+{
+	struct al_serdes_regs __iomem	*regs_base = obj->regs_base;
+	enum al_serdes_group_mode_class lane_mode_class[AL_SRDS_NUM_LANES] = {0};
+	int i;
+	uint32_t reg;
+
+	reg = al_reg_read32(&regs_base->gen.ictl_pcs);
+	if (reg == 0x1) {
+		*serdes_group_mode_class = AL_SRDS_MODE_CLASS_PCIE;
+	} else {
+		for (i = 0; i < AL_SRDS_NUM_LANES; i++) {
+			reg = al_reg_read32(&regs_base->lane[i].ictl_multi);
+			if (reg == SERDES_LANE_ICTL_MULTI_SATA_CONFIG)
+				lane_mode_class[i] = AL_SRDS_MODE_CLASS_SATA;
+			else if (((reg & SERDES_HSSP_SPEED_MASK) == SERDES_HSSP_SPEED_10G) ||
+				 ((reg & SERDES_HSSP_SPEED_MASK) == SERDES_HSSP_SPEED_1G) ||
+				 ((reg & SERDES_HSSP_SPEED_MASK) == SERDES_HSSP_SPEED_2_5G))
+				lane_mode_class[i] = AL_SRDS_MODE_CLASS_ETH;
+			else
+				lane_mode_class[i] = AL_SRDS_MODE_CLASS_UNKNOWN;
+
+			if ((i > 0) && (lane_mode_class[i] != lane_mode_class[i-1])) {
+				al_err("%s: Inconsistent mode_class configuration between different lanes of the serdes\n",
+				__func__);
+				*serdes_group_mode_class = AL_SRDS_MODE_CLASS_UNKNOWN;
+				break;
+			}
+		}
+
+		*serdes_group_mode_class = lane_mode_class[0];
+	}
+
+	al_dbg("%s: serdes_group_mode_class is %d\n", __func__, *serdes_group_mode_class);
+}
+
+static int al_serdes_hssp_serdes_mode_get(struct al_serdes_grp_obj *obj,
+					enum al_serdes_group_mode *serdes_group_mode)
+{
+	struct al_serdes_regs __iomem	*regs_base = obj->regs_base;
+	enum al_serdes_group_mode lane_mode[AL_SRDS_NUM_LANES];
+	uint32_t reg;
+	unsigned int serdes_10g_speed;
+	int i;
+
+	for (i = 0; i < AL_SRDS_NUM_LANES; i++) {
+		reg = al_reg_read32(&regs_base->lane[i].ictl_multi);
+		serdes_10g_speed = reg & SERDES_HSSP_SPEED_MASK;
+
+		switch (serdes_10g_speed) {
+		case SERDES_HSSP_SPEED_10G:
+			lane_mode[i] = AL_SRDS_CFG_KR;
+			break;
+		case SERDES_HSSP_SPEED_1G:
+			lane_mode[i] = AL_SRDS_CFG_SGMII;
+			break;
+		case SERDES_HSSP_SPEED_2_5G:
+			lane_mode[i] = AL_SRDS_CFG_SGMII_2_5G;
+			break;
+		default:
+			al_err("%s: Unable to determine the serdes_group_mode of lane %d (read 0x%x)\n",
+				__func__, i, serdes_10g_speed);
+			return -EIO;
+		}
+
+		if ((i > 0) && (lane_mode[i] != lane_mode[i-1])) {
+			al_err("%s: Inconsistent speed configuration between different lanes of the serdes\n",
+				__func__);
+			return -EIO;
+		}
+	}
+
+	*serdes_group_mode = lane_mode[0];
+	al_dbg("%s: serdes_group_mode is %d\n", __func__, *serdes_group_mode);
+
+
+	return 0;
+}
