+/**
+ *  @{
+ * @file   al_mod_hal_iofic.c
+ *
+ * @brief  interrupt controller hal
+ *
+ */
+
+#include "al_mod_hal_iofic.h"
+#include "al_mod_hal_iofic_regs.h"
+
+/*
+ * configure the interrupt registers, interrupts will are kept masked
+ */
+int al_mod_iofic_config(void __iomem *regs_base, int group, uint32_t flags)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	al_mod_reg_write32(&regs->ctrl[group].int_control_grp, flags);
+
+	return 0;
+}
+
+/*
+ * configure the interrupt registers, interrupts will are kept masked
+ */
+uint32_t al_mod_iofic_control_flags_get(void __iomem *regs_base, int group)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	return al_mod_reg_read32(&regs->ctrl[group].int_control_grp);
+}
+
+/*
+ * configure the moderation timer resolution for a given group
+ */
+int al_mod_iofic_moder_res_config(void __iomem *regs_base, int group,
+			     uint8_t resolution)
+
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+	uint32_t reg;
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	reg = al_mod_reg_read32(&regs->ctrl[group].int_control_grp);
+	AL_REG_FIELD_SET(reg,
+			 INT_CONTROL_GRP_MOD_RES_MASK,
+			 INT_CONTROL_GRP_MOD_RES_SHIFT,
+			 resolution);
+	al_mod_reg_write32(&regs->ctrl[group].int_control_grp, reg);
+
+	return 0;
+}
+
+/*
+ * configure the moderation timer interval for a given legacy interrupt group
+ */
+int al_mod_iofic_legacy_moder_interval_config(void __iomem *regs_base, int group,
+				     uint8_t interval)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+	uint32_t reg;
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	reg = al_mod_reg_read32(&regs->ctrl[group].int_control_grp);
+	AL_REG_FIELD_SET(reg,
+			 INT_CONTROL_GRP_MOD_INTV_MASK,
+			 INT_CONTROL_GRP_MOD_INTV_SHIFT,
+			 interval);
+	al_mod_reg_write32(&regs->ctrl[group].int_control_grp, reg);
+
+	return 0;
+}
+
+
+/*
+ * configure the moderation timer interval for a given msix vector.
+ */
+int al_mod_iofic_msix_moder_interval_config(void __iomem *regs_base, int group,
+				       uint8_t vector, uint8_t interval)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+	uint32_t reg;
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	reg = al_mod_reg_read32(&regs->grp_int_mod[group][vector].grp_int_mod_reg);
+	AL_REG_FIELD_SET(reg,
+			 INT_MOD_INTV_MASK,
+			 INT_MOD_INTV_SHIFT,
+			 interval);
+	al_mod_reg_write32(&regs->grp_int_mod[group][vector].grp_int_mod_reg, reg);
+
+	return 0;
+}
+
+/*
+ * configure the target-id attributes for a given msix vector.
+ */
+int al_mod_iofic_msix_tgtid_attributes_config(void __iomem *regs_base, int group,
+				       uint8_t vector, uint32_t tgtid, uint8_t tgtid_en)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+	uint32_t reg = 0;
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	AL_REG_FIELD_SET(reg,
+			 INT_MSIX_TGTID_MASK,
+			 INT_MSIX_TGTID_SHIFT,
+			 tgtid);
+	AL_REG_BIT_VAL_SET(reg,
+			 INT_MSIX_TGTID_EN_SHIFT,
+			 tgtid_en);
+
+	al_mod_reg_write32(&regs->grp_int_mod[group][vector].grp_int_tgtid_reg, reg);
+
+	return 0;
+}
+
+/*
+ * return the offset of the unmask register for a given group
+ */
+uint32_t __iomem * al_mod_iofic_unmask_offset_get(void __iomem *regs_base, int group)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	return &regs->ctrl[group].int_mask_clear_grp;
+}
+
+
+/*
+ * unmask specific interrupts for a given group
+ */
+void al_mod_iofic_unmask(void __iomem *regs_base, int group, uint32_t mask)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	/*
+	 * use the mask clear register, no need to read the mask register
+	 * itself. write 0 to unmask, 1 has no effect
+	 */
+	al_mod_reg_write32_relaxed(&regs->ctrl[group].int_mask_clear_grp, ~mask);
+}
+
+/*
+ * mask specific interrupts for a given group
+ */
+void al_mod_iofic_mask(void __iomem *regs_base, int group, uint32_t mask)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+	uint32_t reg;
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	reg = al_mod_reg_read32(&regs->ctrl[group].int_mask_grp);
+
+	al_mod_reg_write32(&regs->ctrl[group].int_mask_grp, reg | mask);
+}
+
+/*
+ * read the mask for a given group
+ */
+uint32_t al_mod_iofic_read_mask(void __iomem *regs_base, int group)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	return al_mod_reg_read32(&regs->ctrl[group].int_mask_grp);
+}
+
+/*
+ * read interrupt cause register for a given group
+ */
+uint32_t al_mod_iofic_read_cause(void __iomem *regs_base, int group)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	return al_mod_reg_read32(&regs->ctrl[group].int_cause_grp);
+}
+
+/*
+ * clear bits in the interrupt cause register for a given group
+ */
+void al_mod_iofic_clear_cause(void __iomem *regs_base, int group, uint32_t mask)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	/* inverse mask, writing 1 has no effect */
+	al_mod_reg_write32(&regs->ctrl[group].int_cause_grp, ~mask);
+}
+
+/*
+ * read interrupt cause register and clear it for a given group
+ */
+uint32_t al_mod_iofic_read_and_clear_cause(void __iomem *regs_base, int group, uint32_t mask)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+	uint32_t cause;
+	uint32_t flags;
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	cause = al_mod_iofic_read_cause(regs_base, group);
+
+	flags = al_mod_reg_read32(&regs->ctrl[group].int_control_grp);
+	if (!(flags & INT_CONTROL_GRP_CLEAR_ON_READ))
+		al_mod_iofic_clear_cause(regs_base, group, cause & mask);
+
+	return cause;
+}
+
+/*
+ * Set the cause register for a given group
+ */
+void al_mod_iofic_set_cause(void __iomem *regs_base, int group, uint32_t mask)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	al_mod_reg_write32(&regs->ctrl[group].int_cause_set_grp, mask);
+}
+
+/*
+ * unmask specific interrupts from aborting the udma a given group
+ */
+void al_mod_iofic_abort_mask(void __iomem *regs_base, int group, uint32_t mask)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	al_mod_reg_write32(&regs->ctrl[group].int_abort_msk_grp, mask);
+}
+
+/**
+ * read iofic abort mask for a given group
+ */
+uint32_t al_mod_iofic_abort_mask_read(void __iomem *regs_base, int group)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	return al_mod_reg_read32(&regs->ctrl[group].int_abort_msk_grp);
+}
+
+/*
+ * set specific interrupts in the abort mask for a given group
+ * this will disable UDMA/Application from aborting on specific interrupts
+ */
+void al_mod_iofic_abort_mask_set(void __iomem *regs_base, int group, uint32_t mask)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	al_mod_reg_write32_masked(&regs->ctrl[group].int_abort_msk_grp, mask, mask);
+}
+
+/*
+ * clear specific interrupts in the abort mask for a given group
+ * this will result in UDMA and/or Application aborting on the specific interrupts
+ * and stop any mechanism from going on
+ */
+void al_mod_iofic_abort_mask_clear(void __iomem *regs_base, int group, uint32_t mask)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	al_mod_reg_write32_masked(&regs->ctrl[group].int_abort_msk_grp, mask, ~mask);
+}
+
+/*
+ * trigger all interrupts that are waiting for moderation timers to expire
+ */
+void al_mod_iofic_interrupt_moderation_reset(void __iomem *regs_base, int group)
+{
+	struct al_mod_iofic_regs __iomem *regs = (struct al_mod_iofic_regs __iomem *)(regs_base);
+	uint32_t reg = 0;
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	al_mod_assert(regs_base);
+	al_mod_assert(group < AL_IOFIC_MAX_GROUPS);
+
+	reg = al_mod_reg_read32(&regs->ctrl[group].int_control_grp);
+	reg |= INT_CONTROL_GRP_MOD_RST;
+
+	al_mod_reg_write32(&regs->ctrl[group].int_control_grp, reg);
+}
+
+/** @} end of interrupt controller group */
