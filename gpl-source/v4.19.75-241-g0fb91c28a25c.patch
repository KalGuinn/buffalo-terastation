+int al_tpm_get_version(
+	struct al_tpm		*tpm,
+	enum al_tpm_result	*result,
+	struct tpm_cap_version_info *version_info);
+
+/**
+ * TPM 2.0 get specific capability
+ * We always request only 1 property because TPM 2.0 spec guarantees
