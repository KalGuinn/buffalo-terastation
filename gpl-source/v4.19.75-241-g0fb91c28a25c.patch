+#define AL_ETH_LINK_STATUS_MESSAGE_DATA_SHIFT	1
+#define AL_ETH_LINK_STATUS_MESSAGE_DATA_BIT	(1 << AL_ETH_LINK_STATUS_MESSAGE_DATA_SHIFT)
