+ * NOTICE: For each direction, all tables have the same number of used entries
+ */
+#define AL_ETH_TX_GENERIC_CRC_ENTRIES_NUM 0
+#define AL_ETH_RX_PROTOCOL_DETECT_ENTRIES_NUM 12
