+	obj->eye_diag_pre_sample = AL_SRDS_ADV_SRVC(al_serdes_eye_diag_pre_sample);
+	obj->eye_diag_start_sample = AL_SRDS_ADV_SRVC(al_serdes_eye_diag_start_sample);
