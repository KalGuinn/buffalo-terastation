+/**
+ * @file   al_mod_hal_m2m_udma.c
+ *
+ * @brief  HAL driver for DMA that is a compound of M2S and S2M UDMAs.
+ *
+ */
+
+#include "al_mod_hal_m2m_udma.h"
+#include "al_mod_hal_udma_config.h"
+
+/* Init M2M UDMA */
+
+static int al_mod_m2m_udma_init_aux(struct al_mod_m2m_udma *m2m_udma,
+				struct al_mod_m2m_udma_params *params,
+				al_mod_bool init_device)
+{
+	struct al_mod_udma_params dma_params;
+	int rc;
+
+	m2m_udma->name = params->name;
+	m2m_udma->udma_regs_base = params->udma_regs_base;
+	m2m_udma->num_of_queues = params->num_of_queues;
+
+	/* initialize tx udma component */
+	dma_params.udma_regs_base = (struct unit_regs __iomem *)m2m_udma->udma_regs_base;
+	dma_params.type = UDMA_TX;
+	dma_params.num_of_queues = m2m_udma->num_of_queues;
+	dma_params.name = "tx dma";
+
+	if (init_device) {
+		rc = al_mod_udma_init(&m2m_udma->tx_udma, &dma_params);
+		if (rc != 0) {
+			al_mod_err("failed to initialize %s, error %d\n",
+			       dma_params.name, rc);
+			return rc;
+		}
+		al_mod_udma_m2s_max_descs_set(&m2m_udma->tx_udma, params->max_m2s_descs_per_pkt);
+	} else {
+		rc = al_mod_udma_handle_init(&m2m_udma->tx_udma, &dma_params);
+		if (rc != 0) {
+			al_mod_err("failed to initialize handle for %s, error %d\n",
+			       dma_params.name, rc);
+			return rc;
+		}
+	}
+
+	/* initialize rx udma component */
+	dma_params.udma_regs_base = (struct unit_regs __iomem *)m2m_udma->udma_regs_base;
+	dma_params.type = UDMA_RX;
+	dma_params.num_of_queues = m2m_udma->num_of_queues;
+	dma_params.name = "rx dma";
+
+	if (init_device) {
+		rc = al_mod_udma_init(&m2m_udma->rx_udma, &dma_params);
+		if (rc != 0) {
+			al_mod_err("failed to initialize %s, error %d\n",
+			       dma_params.name, rc);
+			return rc;
+		}
+		al_mod_udma_s2m_max_descs_set(&m2m_udma->rx_udma, params->max_s2m_descs_per_pkt);
+	} else {
+		rc = al_mod_udma_handle_init(&m2m_udma->rx_udma, &dma_params);
+		if (rc != 0) {
+			al_mod_err("failed to initialize handle for %s, error %d\n",
+			       dma_params.name, rc);
+			return rc;
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * initialize M2M UDMA
+ */
+int al_mod_m2m_udma_init(struct al_mod_m2m_udma *m2m_udma,
+		     struct al_mod_m2m_udma_params *params)
+{
+	al_mod_dbg("raid [%s]: Initialize unit\n", params->name);
+
+	return al_mod_m2m_udma_init_aux(m2m_udma, params, AL_TRUE);
+}
+
+/*
+ * initialize M2M UDMA handle
+ */
+int al_mod_m2m_udma_handle_init(struct al_mod_m2m_udma *m2m_udma,
+			    struct al_mod_m2m_udma_params *params)
+{
+	al_mod_dbg("raid [%s]: Initialize unit handle\n", params->name);
+
+	return al_mod_m2m_udma_init_aux(m2m_udma, params, AL_FALSE);
+}
+
+/*
+ * initialize the m2s(tx) and s2m(tx) udmas of the queue
+ */
+int al_mod_m2m_udma_q_init(struct al_mod_m2m_udma *m2m_udma, uint32_t qid,
+			   struct al_mod_udma_q_params *tx_params,
+			   struct al_mod_udma_q_params *rx_params)
+{
+	int rc;
+
+	al_mod_dbg("udma [%s]: Initialize queue %d\n", m2m_udma->name,
+		 qid);
+
+	rc = al_mod_udma_q_init(&m2m_udma->tx_udma, qid, tx_params);
+	if (rc != 0) {
+		al_mod_err("[%s]: failed to initialize tx q %d, error %d\n",
+			 m2m_udma->name, qid, rc);
+		return rc;
+	}
+
+	rc = al_mod_udma_q_init(&m2m_udma->rx_udma, qid, rx_params);
+	if (rc != 0) {
+		al_mod_err("[%s]: failed to initialize rx q %d, error %d\n",
+			 m2m_udma->name, qid, rc);
+		return rc;
+	}
+	return 0;
+
+}
+
+/*
+ * Change the M2M UDMA state
+ */
+int al_mod_m2m_udma_state_set(struct al_mod_m2m_udma *m2m_udma,
+					enum al_mod_udma_state udma_state)
+{
+	int rc;
+
+	rc = al_mod_udma_state_set(&m2m_udma->tx_udma, udma_state);
+	if (rc != 0) {
+		al_mod_err("[%s]: failed to change state, error %d\n",
+			 m2m_udma->name, rc);
+		return rc;
+	}
+
+	rc = al_mod_udma_state_set(&m2m_udma->rx_udma, udma_state);
+	if (rc != 0) {
+		al_mod_err("[%s]: failed to change state, error %d\n",
+			 m2m_udma->name, rc);
+		return rc;
+	}
+
+	return 0;
+}
+
+/*
+ * Get udma handle of the tx or rx udma, this handle can be used to call misc
+ * configuration functions defined at al_mod_udma_config.h
+ */
+int al_mod_m2m_udma_handle_get(struct al_mod_m2m_udma *m2m_udma,
+						enum al_mod_udma_type type,
+						struct al_mod_udma **udma)
+{
+	if (type == UDMA_TX)
+		*udma = &m2m_udma->tx_udma;
+	else
+		*udma = &m2m_udma->rx_udma;
+	return 0;
+}
