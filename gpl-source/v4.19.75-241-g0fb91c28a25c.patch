+	unsigned int num = 3; /* At least 3 column bits */
+	unsigned int i;
+
+	al_ddr_address_map_get(ddr_cfg, &addrmap);
+
+	for (i = 0; i < AL_ARR_SIZE(addrmap.col_b3_9_b11_13); i++) {
+		if (addrmap.col_b3_9_b11_13[i] != AL_DDR_ADDRMAP_NC)
+			num++;
+	}
+
+	return 1 << num;
+}
