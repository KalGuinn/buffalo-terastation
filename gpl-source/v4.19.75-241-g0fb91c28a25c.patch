+#define EPE_CTRL_DATA_CMD_OFFSET_MAX_V4(cmd_idx)	((cmd_idx) < 2 ? \
+		EPE_CTRL_DATA_CMD_OFFSET_MAX_V3(cmd_idx) : EPE_CTRL_RESULT_VECTOR_SIZE_V4 - 1)
+#define EPE_CTRL_DATA_CMD_OFFSET_MAX_BY_REV(rev_id, cmd_idx)	\
