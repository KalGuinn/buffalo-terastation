+/**
+ * read KR PCS registers (indirect access)
+ *
+ * @param mac_regs_base MAC register base
+ * @param reg_addr address in the an registers
+ *
+ * @return the register value
+ */
+static uint32_t al_eth_kr_pcs_reg_read(
+			struct al_eth_mac_regs *mac_regs_base,
+			uint32_t reg_addr)
+{
+	uint32_t val;
+
+	/* indirect access */
+	al_reg_write32(&mac_regs_base->kr.pcs_addr, reg_addr);
+	val = al_reg_read32(&mac_regs_base->kr.pcs_data);
+
+	al_dbg("%s: reg %d. val 0x%x\n", __func__, reg_addr, val);
+
+	return val;
+}
+
+/**
+ * write KR PCS registers (indirect access)
+ *
+ * @param mac_regs_base MAC register base
+ * @param reg_addr address in the an registers
+ * @param reg_data value to write to the register
+ *
+ */
+static void al_eth_kr_pcs_reg_write(
+			struct al_eth_mac_regs *mac_regs_base,
+			uint32_t reg_addr,
+			uint32_t reg_data)
+{
+	al_reg_write32(&mac_regs_base->kr.pcs_addr, reg_addr);
+	al_reg_write32(&mac_regs_base->kr.pcs_data, reg_data);
+
+	al_dbg("%s: reg %d. val 0x%x\n", __func__, reg_addr, reg_data);
+}
+
+/**
+ * write masked KR PCS registers (indirect access)
+ *
+ * @param mac_regs_base MAC register base
+ * @param reg_addr address in the an registers
+ * @param reg_mask mask of value to write to the register
+ * @param reg_data value to write to the register
+ *
+ */
+static void al_eth_kr_pcs_reg_write_masked(
+			struct al_eth_mac_regs *mac_regs_base,
+			uint32_t reg_addr,
+			uint32_t reg_mask,
+			uint32_t reg_data)
+{
+	uint32_t temp;
+
+	temp = al_eth_kr_pcs_reg_read(mac_regs_base, reg_addr);
+	al_eth_kr_pcs_reg_write(mac_regs_base, reg_addr, AL_MASK_VAL(reg_mask, reg_data, temp));
+
+	al_dbg("%s: reg %d. val 0x%x\n", __func__, reg_addr, reg_data);
+}
+
+/**
+ * read 40G MAC registers (indirect access)
+ *
+ * @param mac_regs_base MAC register base
+ * @param reg_addr address in the an registers
