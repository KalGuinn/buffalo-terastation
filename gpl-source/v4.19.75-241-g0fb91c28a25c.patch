+
+/* enum definitions */
+
+/* Address map physical address slave windows */
+enum al_addr_map_pasw {
+	AL_ADDR_MAP_PASW_NB_DRAM0, /**< DRAM (system fabric) */
+	AL_ADDR_MAP_PASW_NB_DRAM1, /**< DRAM (system fabric) */
