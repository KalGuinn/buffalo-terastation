+#define AL_I2C_INTR_MASK_GEN_CALL_SHIFT		0xB
+#define AL_I2C_INTR_MASK_GEN_CALL_MASK		(0x1<< \
+		AL_I2C_INTR_MASK_GEN_CALL_SHIFT)
+
+#endif
