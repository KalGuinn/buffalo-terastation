+	*mac_b_mask = AL_ETH_V4_MAC_IOFIC_GROUP_B_NON_FATAL;
+	*mac_c_mask = AL_ETH_V4_MAC_IOFIC_GROUP_C_NON_FATAL;
+	*mac_d_mask = AL_ETH_V4_MAC_IOFIC_GROUP_D_NON_FATAL;
+}
