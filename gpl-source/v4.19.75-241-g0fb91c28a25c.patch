+static const unsigned int dfi_phyupd_type1 = 0x640;
+
+/**
+ * Cycles to hold ODT for a read command. When 0x0, ODT signal is ON
+ * for 1 cycle. When 0x1, it is ON for 2 cycles, and so on.
