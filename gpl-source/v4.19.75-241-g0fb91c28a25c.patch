+ */
+void al_nand_int_enable(
+		struct al_nand_ctrl_obj	*obj,
+		uint32_t int_mask);
+
+/**
+ * Disable interrupts for the mask status
+ *
+ * @param  obj
+ *             The object context
+ *
+ * @param  int_mask
+ *             the interrupt's status mask to disable
+ *
+ */
+void al_nand_int_disable(
+		struct al_nand_ctrl_obj	*obj,
+		uint32_t int_mask);
+
