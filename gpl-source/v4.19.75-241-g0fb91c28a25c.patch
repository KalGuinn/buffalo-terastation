+/*******************************************************************************
+ ******************************************************************************/
+static void _al_ddr_phy_training_results_octet_get(
+	struct al_ddr_cfg				*ddr_cfg,
+	int						octet,
+	struct al_ddr_phy_training_results_per_octet	*results)
+{
+	int rank;
+	uint32_t reg_val;
+	STRUCT_PHY_REGS __iomem *phy_regs = PHY_REGS(ddr_cfg->ddr_phy_regs_base);
+
+	uint32_t gtr;
+	uint32_t vtdr;
+
+	reg_val = al_reg_read32(&phy_regs->datx8[octet].mdlr[0]);
+	results->dll_num_taps_init =
+		(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNMDLR0_IPRD_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DXNMDLR0_IPRD_SHIFT;
+	results->dll_num_taps_curr =
+		(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNMDLR0_TPRD_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DXNMDLR0_TPRD_SHIFT;
+	for (rank = 0; rank < AL_DDR_NUM_RANKS; rank++) {
+		/* Select rank */
+		al_reg_write32(
+			&phy_regs->rankidr,
+			(rank << ALPINE_V3_DWC_DDR_PHY_REGS_RANKIDR_RANKWID_SHIFT) |
+			(rank << ALPINE_V3_DWC_DDR_PHY_REGS_RANKIDR_RANKRID_SHIFT));
+		al_reg_write32_masked(
+			&phy_regs->dtcr[0],
+			ALPINE_V3_DWC_DDR_PHY_REGS_DTCR0_DTDRS_MASK,
+			(rank << ALPINE_V3_DWC_DDR_PHY_REGS_DTCR0_DTDRS_SHIFT));
+
+		gtr = al_reg_read32(&phy_regs->datx8[octet].gtr);
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].lcdlr[0]);
+		results->wld[rank] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR0_WLD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR0_WLD_SHIFT;
+		results->x4wld[rank] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR0_X4WLD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR0_X4WLD_SHIFT;
+
+		results->wld_extra[rank] =
+			(gtr & ALPINE_V3_DWC_DDR_PHY_REGS_DXNGTR0_WLSL_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNGTR0_WLSL_SHIFT;
+		results->x4wld_extra[rank] =
+			(gtr & ALPINE_V3_DWC_DDR_PHY_REGS_DXNGTR0_X4WLSL_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNGTR0_X4WLSL_SHIFT;
+
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].lcdlr[2]);
+		results->rdqsgd[rank] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR2_DQSGD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR2_DQSGD_SHIFT;
+		results->x4rdqsgd[rank] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR2_X4DQSGD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR2_X4DQSGD_SHIFT;
+
+		results->rdqsgd_extra[rank] =
+			(gtr & ALPINE_V3_DWC_DDR_PHY_REGS_DXNGTR0_DGSL_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNGTR0_DGSL_SHIFT;
+		results->x4rdqsgd_extra[rank] =
+			(gtr & ALPINE_V3_DWC_DDR_PHY_REGS_DXNGTR0_X4DGSL_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNGTR0_X4DGSL_SHIFT;
+
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].lcdlr[1]);
+		results->wdqd[rank] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR1_WDQD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR1_WDQD_SHIFT;
+		results->x4wdqd[rank] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR1_X4WDQD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR1_X4WDQD_SHIFT;
+
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].lcdlr[3]);
+		results->rdqsd[rank] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR3_RDQSD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR3_RDQSD_SHIFT;
+		results->x4rdqsd[rank] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR3_X4RDQSD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR3_X4RDQSD_SHIFT;
+
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].lcdlr[4]);
+		results->rdqsnd[rank] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR4_RDQSND_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR4_RDQSND_SHIFT;
+		results->x4rdqsnd[rank] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR4_X4RDQSND_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR4_X4RDQSND_SHIFT;
+
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].bdlr0_2[0]);
+		results->dqwbd[0] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR0_DQ0WBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR0_DQ0WBD_SHIFT;
+		results->dqwbd[1] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR0_DQ1WBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR0_DQ1WBD_SHIFT;
+		results->dqwbd[2] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR0_DQ2WBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR0_DQ2WBD_SHIFT;
+		results->dqwbd[3] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR0_DQ3WBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR0_DQ3WBD_SHIFT;
+
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].bdlr0_2[1]);
+		results->dqwbd[4] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR1_DQ4WBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR1_DQ4WBD_SHIFT;
+		results->dqwbd[5] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR1_DQ5WBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR1_DQ5WBD_SHIFT;
+		results->dqwbd[6] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR1_DQ6WBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR1_DQ6WBD_SHIFT;
+		results->dqwbd[7] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR1_DQ7WBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR1_DQ7WBD_SHIFT;
+
+		/* DM is muxed on DQS[1] pad */
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].bdlr6_9[1]);
+		results->dmwbd =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR7_X4DSWBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR7_X4DSWBD_SHIFT;
+
+
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].bdlr3_5[0]);
+		results->dqrbd[0] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR3_DQ0RBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR3_DQ0RBD_SHIFT;
+		results->dqrbd[1] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR3_DQ1RBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR3_DQ1RBD_SHIFT;
+		results->dqrbd[2] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR3_DQ2RBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR3_DQ2RBD_SHIFT;
+		results->dqrbd[3] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR3_DQ3RBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR3_DQ3RBD_SHIFT;
+
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].bdlr3_5[1]);
+		results->dqrbd[4] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR4_DQ4RBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR4_DQ4RBD_SHIFT;
+		results->dqrbd[5] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR4_DQ5RBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR4_DQ5RBD_SHIFT;
+		results->dqrbd[6] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR4_DQ6RBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR4_DQ6RBD_SHIFT;
+		results->dqrbd[7] =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR4_DQ7RBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR4_DQ7RBD_SHIFT;
+
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].bdlr3_5[2]);
+		results->dmrbd =
+			(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR5_DMRBD_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNBDLR5_DMRBD_SHIFT;
+
+		/* Select lower Nibble */
+		al_reg_write32_masked(
+			&phy_regs->dtcr[0],
+			ALPINE_V3_DWC_DDR_PHY_REGS_DTCR0_DTDBS_MASK,
+			ALPINE_V3_DWC_DDR_PHY_REGS_DTCR0_DTDBS(2*octet));
+		vtdr = al_reg_read32(&phy_regs->vtdr);
+		results->dvrefmn[rank] =
+			(vtdr & ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_DVREFMN_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_DVREFMN_SHIFT;
+		results->dvrefmx[rank] =
+			(vtdr & ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_DVREFMX_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_DVREFMX_SHIFT;
+		results->hvrefmn[rank] =
+			(vtdr & ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_HVREFMN_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_HVREFMN_SHIFT;
+		results->hvrefmx[rank] =
+			(vtdr & ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_HVREFMX_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_HVREFMX_SHIFT;
+
+		/* Select upper Nibble */
+		al_reg_write32_masked(
+			&phy_regs->dtcr[0],
+			ALPINE_V3_DWC_DDR_PHY_REGS_DTCR0_DTDBS_MASK,
+			ALPINE_V3_DWC_DDR_PHY_REGS_DTCR0_DTDBS(2*octet + 1));
+		vtdr = al_reg_read32(&phy_regs->vtdr);
+		results->x4dvrefmn[rank] =
+			(vtdr & ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_DVREFMN_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_DVREFMN_SHIFT;
+		results->x4dvrefmx[rank] =
+			(vtdr & ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_DVREFMX_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_DVREFMX_SHIFT;
+		results->x4hvrefmn[rank] =
+			(vtdr & ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_HVREFMN_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_HVREFMN_SHIFT;
+		results->x4hvrefmx[rank] =
+			(vtdr & ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_HVREFMX_MASK) >>
+			ALPINE_V3_DWC_DDR_PHY_REGS_VTDR_HVREFMX_SHIFT;
+
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].gcr[5]);
+		results->dxrefisel[rank] = ((reg_val >>
+			(8*rank)) &
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNGCR5_DXREFISELR0_MASK) >>
+			0;
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].gcr[8]);
+		results->x4dxrefisel[rank] = ((reg_val >>
+			(8*rank)) &
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNGCR8_X4DXREFISELR0_MASK) >>
+			0;
+
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].gcr[6]);
+		results->dxdqvrefr[rank] = ((reg_val >>
+			(8*rank)) &
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNGCR6_DXDQVREFR0_MASK) >>
+			0;
+		reg_val = al_reg_read32(
+			&phy_regs->datx8[octet].gcr[9]);
+		results->x4dxdqvrefr[rank] = ((reg_val >>
+			(8*rank)) &
+			ALPINE_V3_DWC_DDR_PHY_REGS_DXNGCR9_X4DXDQVREFR0_MASK) >>
+			0;
+	}
+
+	reg_val = al_reg_read32(
+		&phy_regs->datx8[octet].lcdlr[5]);
+	results->dqsgsd =
+		(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR5_DQSGSD_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR5_DQSGSD_SHIFT;
+	results->x4dqsgsd =
+		(reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR5_X4DQSGSD_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DXNLCDLR5_X4DQSGSD_SHIFT;
+
+	reg_val = al_reg_read32(&phy_regs->datx8[octet].gcr[0]);
+	results->rddly = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNGCR0_RDDLY_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DXNGCR0_RDDLY_SHIFT;
+	reg_val = al_reg_read32(&phy_regs->datx8[octet].gcr[7]);
+	results->x4rddly = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DXNGCR7_X4RDDLY_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DXNGCR7_X4RDDLY_SHIFT;
+
+	/* Select lower Nibble */
+	al_reg_write32_masked(
+		&phy_regs->dtcr[0],
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTCR0_DTDBS_MASK,
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTCR0_DTDBS(2*octet));
+
+	reg_val = al_reg_read32(&phy_regs->dtedr[0]);
+	results->dtwlmn = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWLMN_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWLMN_SHIFT;
+	results->dtwlmx = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWLMX_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWLMX_SHIFT;
+	results->dtwbmn = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWBMN_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWBMN_SHIFT;
+	results->dtwbmx = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWBMX_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWBMX_SHIFT;
+
+	reg_val = al_reg_read32(&phy_regs->dtedr[1]);
+	results->dtrlmn = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRLMN_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRLMN_SHIFT;
+	results->dtrlmx = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRLMX_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRLMX_SHIFT;
+	results->dtrbmn = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRBMN_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRBMN_SHIFT;
+	results->dtrbmx = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRBMX_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRBMX_SHIFT;
+
+	/* Select upper Nibble */
+	al_reg_write32_masked(
+		&phy_regs->dtcr[0],
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTCR0_DTDBS_MASK,
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTCR0_DTDBS(2*octet + 1));
+
+	reg_val = al_reg_read32(&phy_regs->dtedr[0]);
+	results->x4dtwlmn = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWLMN_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWLMN_SHIFT;
+	results->x4dtwlmx = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWLMX_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWLMX_SHIFT;
+	results->x4dtwbmn = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWBMN_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWBMN_SHIFT;
+	results->x4dtwbmx = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWBMX_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR0_DTWBMX_SHIFT;
+
+	reg_val = al_reg_read32(&phy_regs->dtedr[1]);
+	results->x4dtrlmn = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRLMN_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRLMN_SHIFT;
+	results->x4dtrlmx = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRLMX_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRLMX_SHIFT;
+	results->x4dtrbmn = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRBMN_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRBMN_SHIFT;
+	results->x4dtrbmx = (reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRBMX_MASK) >>
+		ALPINE_V3_DWC_DDR_PHY_REGS_DTEDR1_DTRBMX_SHIFT;
+}
