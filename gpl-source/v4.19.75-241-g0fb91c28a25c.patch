+#define AL_SSM_UDMA_NUM(idx)			4
+#define AL_SSM_UDMA_PMDT_OFFSET(udma_idx)	(AL_SSM_UDMA_OFFSET(udma_idx) +	AL_UDMA_PMDT_OFFSET)
