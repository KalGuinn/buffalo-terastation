+/*******************************************************************************
+ ******************************************************************************/
+DDR_STATIC void _al_ddr_phy_vt_calc_enable(
+	struct al_ddr_cfg	*ddr_cfg)
+{
+	STRUCT_PHY_REGS __iomem *phy_regs = PHY_REGS(ddr_cfg->ddr_phy_regs_base);
+
+	al_reg_write32_masked(
+		&phy_regs->pgcr[6],
+		ALPINE_V3_DWC_DDR_PHY_REGS_PGCR6_INHVT,
+		0);
+}
+
+/*******************************************************************************
+ ******************************************************************************/
+DDR_STATIC void _al_ddr_axi_termination_cfg_set(
+	void __iomem				*ddrc_regs_base,
+	const struct al_ddr_axi_termination_cfg	*cfg)
+{
+	struct  al_ddrc_regs __iomem *ddrc_regs;
+
+	al_assert(ddrc_regs_base);
+
+	ddrc_regs = (struct al_ddrc_regs __iomem *)ddrc_regs_base;
+
+	al_reg_write32_masked(
+		&ddrc_regs->global.termination,
+		DDRC_GLOBAL_TERMINATION_WR_POISON |
+		DDRC_GLOBAL_TERMINATION_ACTIVATE |
+		DDRC_GLOBAL_TERMINATION_PARITY_RESP,
+		(cfg->wr_poison ? DDRC_GLOBAL_TERMINATION_WR_POISON : 0) |
+		(cfg->activate ? DDRC_GLOBAL_TERMINATION_ACTIVATE : 0) |
+		(cfg->parity_resp ? DDRC_GLOBAL_TERMINATION_PARITY_RESP : 0));
+}
+
+/*******************************************************************************
+ ******************************************************************************/
+DDR_STATIC unsigned int _al_ddr_vpw_cfg_get(
+	struct al_ddr_cfg	*ddr_cfg)
+{
+	union al_ddr_ctrl_regs __iomem *ctrl_regs =
+		(union al_ddr_ctrl_regs __iomem *)
+		ddr_cfg->ddr_ctrl_regs_base;
+	unsigned int timeout;
+	uint32_t reg_val;
+
+	reg_val = al_reg_read32(&ctrl_regs->alpine_v3.umctl2_mp.pcfgwqos0_0);
+	if ((!(reg_val & DWC_DDR_UMCTL2_MP_PCFGWQOS0_0_WQOS_MAP_REGION0_VPW)) ||
+		(!(reg_val & DWC_DDR_UMCTL2_MP_PCFGWQOS0_0_WQOS_MAP_REGION1_VPW)))
+		return 0;
+
+	reg_val = al_reg_read32(&ctrl_regs->alpine_v3.umctl2_mp.pcfgwqos1_0);
+	timeout = (reg_val & DWC_DDR_UMCTL2_MP_PCFGWQOS1_0_WQOS_MAP_TIMEOUT_MASK) >>
+		DWC_DDR_UMCTL2_MP_PCFGWQOS1_0_WQOS_MAP_TIMEOUT_SHIFT;
+
+	return timeout;
+}
+
+/*******************************************************************************
+ ******************************************************************************/
+DDR_STATIC void _al_ddr_pmdt_pmu_event_group_sel(
+	struct al_ddr_cfg		*ddr_cfg,
+	enum al_ddr_pmdt_event_group	grp)
+{
+	struct  al_ddrc_regs __iomem *ddrc_regs =
+		(struct al_ddrc_regs __iomem *)ddr_cfg->ddrc_regs_base;
+
+	switch (grp) {
+	case AL_DDR_PMDT_EVENT_GROUP0:
+		al_reg_write32_masked(&ddrc_regs->global.pmu,
+			DDRC_GLOBAL_PMU_PERF_BANK_LOC_SEL_MASK |
+			DDRC_GLOBAL_PMU_PERF_SEL_IOCACHE,
+			DDRC_GLOBAL_PMU_PERF_SEL_IOCACHE);
+		break;
+	case AL_DDR_PMDT_EVENT_GROUP1:
+		al_reg_write32_masked(&ddrc_regs->global.pmu,
+			DDRC_GLOBAL_PMU_PERF_BANK_LOC_SEL_MASK |
+			DDRC_GLOBAL_PMU_PERF_SEL_IOCACHE,
+			0 << DDRC_GLOBAL_PMU_PERF_BANK_LOC_SEL_SHIFT);
+		break;
+	case AL_DDR_PMDT_EVENT_GROUP2:
+		al_reg_write32_masked(&ddrc_regs->global.pmu,
+			DDRC_GLOBAL_PMU_PERF_BANK_LOC_SEL_MASK |
+			DDRC_GLOBAL_PMU_PERF_SEL_IOCACHE,
+			1 << DDRC_GLOBAL_PMU_PERF_BANK_LOC_SEL_SHIFT);
+		break;
+	case AL_DDR_PMDT_EVENT_GROUP3:
+		al_reg_write32_masked(&ddrc_regs->global.pmu,
+			DDRC_GLOBAL_PMU_PERF_BANK_LOC_SEL_MASK |
+			DDRC_GLOBAL_PMU_PERF_SEL_IOCACHE,
+			2 << DDRC_GLOBAL_PMU_PERF_BANK_LOC_SEL_SHIFT);
+		break;
+	default:
+		al_assert_msg(0, "%s: group %d not supported!\n", __func__, grp);
+	}
+}
+
+DDR_STATIC int _al_ddr_pmdt_event_bank_sel(
+		struct al_ddr_cfg		*ddr_cfg,
+		struct al_ddr_pmu_perf_sel	*pmu_perf_sel)
+{
+	uint32_t b[PMU_PERF_SEL_MAX_NUM];
+	unsigned int i;
+	enum al_ddr_pmu_bank_sel pmu_bank_sel[PMU_PERF_SEL_MAX_NUM] = {
+			pmu_perf_sel->pmu_bank_sel_b0,
+			pmu_perf_sel->pmu_bank_sel_b1,
+			pmu_perf_sel->pmu_bank_sel_b2,
+			pmu_perf_sel->pmu_bank_sel_b3};
+
+	struct  al_ddrc_regs __iomem *ddrc_regs =
+			(struct al_ddrc_regs __iomem *)ddr_cfg->ddrc_regs_base;
+
+	int arr[PMU_PERF_SEL_MAX_NUM][AL_DDR_PMU_BANK_SEL_SIZE] = {{1, 0, 3, 2, -1, -1, -1, -1},
+			{0, -1, 2, 1, -1, 3, -1, -1},
+			{-1, -1, 1, 0, 3, 2, -1, -1},
+			{-1, -1, -1, -1, 1, 0, 3, 2} };
+
+	for (i = 0; i < PMU_PERF_SEL_MAX_NUM; i++)
+		if (arr[i][pmu_bank_sel[i]] != -1)
+			b[i] = arr[i][pmu_bank_sel[i]];
+		else {
+			al_err("%s: Wrong selection for b%u bit!\n", __func__, i);
+			return -EINVAL;
+		}
+
+	al_reg_write32_masked(&ddrc_regs->global.pmu,
+				(DDRC_GLOBAL_PMU_PERF_SEL_B0_MASK |
+						DDRC_GLOBAL_PMU_PERF_SEL_B1_MASK |
+						DDRC_GLOBAL_PMU_PERF_SEL_B2_MASK |
+						DDRC_GLOBAL_PMU_PERF_SEL_B3_MASK),
+				((b[0] << DDRC_GLOBAL_PMU_PERF_SEL_B0_SHIFT) |
+						(b[1] << DDRC_GLOBAL_PMU_PERF_SEL_B1_SHIFT) |
+						(b[2] << DDRC_GLOBAL_PMU_PERF_SEL_B2_SHIFT) |
+						(b[3] << DDRC_GLOBAL_PMU_PERF_SEL_B3_SHIFT)));
+
+	return 0;
+}
