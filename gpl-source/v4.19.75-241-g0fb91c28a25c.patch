+
+/* Primary Windows */
+#define AL_PCIE_0_BASE		0xc0000000UL
+#define AL_PCIE_0_SIZE		SZ_128M
+#define AL_PCIE_1_BASE		0xc8000000UL
+#define AL_PCIE_1_SIZE		SZ_128M
