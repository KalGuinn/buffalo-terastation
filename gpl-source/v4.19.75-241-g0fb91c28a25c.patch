+		info->ela_num = 1;
+		info->ext_trigger_num = 96;
+		info->pmu_counters = 16;
+		break;
+	default:
+		al_mod_err(" Illegal PMDTU id (%d)\n", id);
+		return -1;
+	}
+
+	return 0;
+}
