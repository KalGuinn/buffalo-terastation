+	al_mod_pcie_port_link_speed_ctrl_set(pcie_port, new_speed);
+
+	al_mod_reg_write32_masked(&regs->port_regs->gen2_ctrl,
+		PCIE_PORT_GEN2_CTRL_DIRECT_SPEED_CHANGE,
+		PCIE_PORT_GEN2_CTRL_DIRECT_SPEED_CHANGE);
+
+	return 0;
