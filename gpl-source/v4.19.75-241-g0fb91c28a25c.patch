+/******************************************************************************/
+/******************************************************************************/
+void al_mod_serdes_avg_core_interrupt_no_wait(
+	struct al_mod_serdes_grp_obj	*obj,
+	unsigned int			code,
+	unsigned int			data)
+{
+	struct al_mod_srd_1lane_regs __iomem *lane_regs = obj->regs_base;
+
+	if (obj->core_int_dbg_en)
+		al_mod_print("serdes core int complex %s lane %d code %04x data %04x\n",
+			complex_type_str_get(obj->complex_obj->complex_type), obj->lane_in_complex,
+			code, data);
+
+	/* Issue interrupt */
+	obj->complex_obj->reg_write32(&lane_regs->gen.i_core_interrupt,
+		(code << SRD_1LANE_GEN_I_CORE_INTERRUPT_CODE_SHIFT) |
+		(data << SRD_1LANE_GEN_I_CORE_INTERRUPT_DATA_SHIFT));
+}
+
+/******************************************************************************/
+/******************************************************************************/
+unsigned int al_mod_serdes_avg_core_interrupt(
+	struct al_mod_serdes_grp_obj	*obj,
+	unsigned int			code,
+	unsigned int			data)
+{
+	al_mod_serdes_avg_core_interrupt_no_wait(obj, code, data);
+
+	return al_mod_serdes_avg_core_interrupt_res_wait_and_get(obj);
+}
