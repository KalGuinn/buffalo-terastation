+	AL_ETH_EPE_GROUP_D_HDR_INPUT_FIFO_ERR_OUT_EOP_HDR_EMPTY_1 | \
+	AL_ETH_EPE_GROUP_D_HDR_INPUT_FIFO_ERR_OUT_EOP_HDR_EMPTY_2 | \
+	AL_ETH_EPE_GROUP_D_HDR_INPUT_FIFO_ERR_OUT_EOP_HDR_EMPTY_3)
+
+void al_eth_epe_error_ints_masks_get(struct al_eth_epe_handle *handle,
+					uint32_t *epe_a_mask,
+					uint32_t *epe_b_mask,
+					uint32_t *epe_c_mask,
+					uint32_t *epe_d_mask)
+{
+	al_assert(epe_a_mask);
+	al_assert(epe_b_mask);
+	al_assert(epe_c_mask);
+	al_assert(epe_d_mask);
+
+	al_assert(handle);
+	al_assert(handle->eth_rev_id >= AL_ETH_REV_ID_4);
+
+	*epe_a_mask = AL_ETH_EPE_GROUP_A_ERROR_INTS;
+	*epe_b_mask = AL_ETH_EPE_GROUP_B_ERROR_INTS;
+	*epe_c_mask = AL_ETH_EPE_GROUP_C_ERROR_INTS;
+	*epe_d_mask = AL_ETH_EPE_GROUP_D_ERROR_INTS;
+}
+
+static void al_eth_epe_error_ints_unmask(struct al_eth_epe_handle *handle)
+{
+	uint32_t epe_a_mask;
+	uint32_t epe_b_mask;
+	uint32_t epe_c_mask;
+	uint32_t epe_d_mask;
+
+	al_assert(handle);
+	al_assert(handle->ints_base);
+
+	al_eth_epe_error_ints_masks_get(handle,
+					&epe_a_mask,
+					&epe_b_mask,
+					&epe_c_mask,
+					&epe_d_mask);
+
+	/* EPE IOFIC config */
+	al_iofic_config(handle->ints_base,
+			AL_INT_GROUP_A,
+			INT_CONTROL_GRP_MASK_MSI_X);
+	al_iofic_config(handle->ints_base,
+			AL_INT_GROUP_B,
+			INT_CONTROL_GRP_MASK_MSI_X);
+	al_iofic_config(handle->ints_base,
+			AL_INT_GROUP_C,
+			INT_CONTROL_GRP_MASK_MSI_X);
+	al_iofic_config(handle->ints_base,
+			AL_INT_GROUP_D,
+			INT_CONTROL_GRP_MASK_MSI_X);
+
+	/* clear old unvalid parity interrupts */
+	al_iofic_clear_cause(handle->ints_base,
+				AL_INT_GROUP_A,
+				epe_a_mask);
+	al_iofic_clear_cause(handle->ints_base,
+				AL_INT_GROUP_B,
+				epe_b_mask);
+	al_iofic_clear_cause(handle->ints_base,
+				AL_INT_GROUP_C,
+				epe_c_mask);
+	al_iofic_clear_cause(handle->ints_base,
+				AL_INT_GROUP_D,
+				epe_d_mask);
+
+	/* unmask interrupts */
+	al_iofic_unmask(handle->ints_base,
+			AL_INT_GROUP_A,
+			epe_a_mask);
+	al_iofic_unmask(handle->ints_base,
+			AL_INT_GROUP_B,
+			epe_b_mask);
+	al_iofic_unmask(handle->ints_base,
+			AL_INT_GROUP_C,
+			epe_c_mask);
+	al_iofic_unmask(handle->ints_base,
+			AL_INT_GROUP_D,
+			epe_d_mask);
+}
