+	uint32_t vc0_non_posted_rcv_q_ctrl;
+	uint32_t vc0_comp_rcv_q_ctrl;
+	uint32_t reserved4[(0x10C - 0x54) >> 2];
+	uint32_t gen2_ctrl;
+	uint32_t reserved5[(0x190 - 0x110) >> 2];
+	uint32_t gen3_ctrl;
