+	 * @param val value to write
+	 *
+	 * @return 0 on success, negative errno on failure
+	 */
+	int (*mdio_write)(struct al_mod_eth_mac_obj *, uint32_t phy_addr, uint32_t device,
+		uint32_t reg, uint16_t val);
+
