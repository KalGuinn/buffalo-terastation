+	case (AL_PMDT_UNIT_DDR_CONTROLLER_1):
+		info->axi_mon_num = 0;
+		info->ela_num = 1;
+		info->ext_trigger_num = 61;
+		info->pmu_counters = 16;
+		break;
+	case (AL_PMDT_UNIT_SHARED_RESOURCE_ETH_100_0):
+		info->axi_mon_num = 0;
+		info->ela_num = 1;
+		info->ext_trigger_num = 63;
+		info->pmu_counters = 16;
+		break;
+	case (AL_PMDT_UNIT_EC_ETH_100_0):
+	case (AL_PMDT_UNIT_EC_ETH_100_1):
+	case (AL_PMDT_UNIT_EC_ETH_100_2):
+	case (AL_PMDT_UNIT_EC_ETH_100_3):
