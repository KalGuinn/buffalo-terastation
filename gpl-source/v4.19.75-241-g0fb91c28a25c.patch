+ * @param	udma
+ *		UDMA context
+ * @param	entry
+ *		Entry params
+ */
+void al_udma_ttt_entry_set(
+	struct al_udma			*udma,
+	struct al_udma_ttt_entry	*entry);
+
+/**
+ * Initialize default configurations for the Transaction Types Table
+ *
+ * Valid for UDMA >= v4
+ *
+ * @param	rx_udma
+ *		UDMA context
+ */
+void al_udma_ttt_default_config(
+	struct al_udma *rx_udma);
+
+/* *INDENT-OFF* */
+#ifdef __cplusplus
+}
+#endif
+/* *INDENT-ON* */
+/** @} end of UDMA config group */
+#endif /* __AL_HAL_UDMA_CONFIG_H__ */
