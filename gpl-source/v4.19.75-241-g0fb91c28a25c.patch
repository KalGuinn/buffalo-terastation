+#define SRAM_AGENT_ADDRESS					0xfbff4010
+#define SRAM_CPU_RESUME_ADDRESS					0xfbff5ec0
+#define SRAM_DEV_INFO_ADDRESS					0xfbff5ae0
+#define PBS_INT_MEM_SHARED_PARAMS_OFFSET			0x1ef0
+#define SRAM_GENERAL_SHARED_DATA_OFFSET			0x1ea0
+
+/* TDM sub windows  - dummy values */
+#define AL_SPI_MASTER_AUX_BASE					0
+/* uC shared not supported for Alpine V1 - dummy value */
+#define AL_UC_SHARED_BASE					0
+
+/* Not relevant for V1 - dummy values */
+#define AL_PBS_CCTM_BASE	0
+#define AL_NB_ANPA_BASE(i)	0
+#define AL_SATA_PMDT_BASE(i)	0
+#define AL_PCIE_MSTR_PMDT_BASE(i)	0
+#define AL_PCIE_SLV_PMDT_BASE(i)	0
+#define AL_PCIE_CORE_PMDT_BASE(i)	0
