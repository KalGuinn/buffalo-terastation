+
+#include "al_tpm_if_spi.h"
+
+#define TPM_SPI_TIMEOUT 1000000
+#define TIS_BASE_OFFSET 0xD4
+#define DEFAULT_FREQ	1000000
+
+#define SPI_XFER_BEGIN		0x01
+#define SPI_XFER_END		0x02
+
+#define SPI_READ_CMD		0x80
+#define SPI_WRITE_CMD		0x00
+
+static inline void fill_cmd_buf(
+		unsigned char *cmd_buf,
+		unsigned int offset,
+		unsigned int data_size,
+		unsigned char cmd_selector) {
+	cmd_buf[0] = cmd_selector | (data_size-1); /* 0=1byte */
+
+	/* Legacy base offset from memory mapped TPM driver
+	 * required by NationZ, ignored by Infenion
+	 */
+	cmd_buf[1] = TIS_BASE_OFFSET;
+	cmd_buf[2] = (offset>>8)  & 0xFF;
+	cmd_buf[3] = (offset)     & 0xFF;
+}
+
+static int al_tpm_if_spi_read_gen(
+	struct al_tpm_if *tpm_if,
+	unsigned int offset,
+	uint8_t *data,
+	unsigned int data_size)
+{
+	int err = 0;
+	struct al_tpm_if_spi_gen *tpm_if_spi_gen;
+	unsigned char cmd_buf[4];
+
+	al_assert(tpm_if);
+	al_assert(tpm_if->priv);
+
+	tpm_if_spi_gen = tpm_if->priv;
+
+	err = tpm_if_spi_gen->spi_claim_bus(tpm_if_spi_gen->slave);
+	if (err) {
+		al_err("%s: TPM SPI claim bus failed!\n", __func__);
+		*data = 0;
+		return err;
+	}
+
+	fill_cmd_buf(cmd_buf, offset, data_size, SPI_READ_CMD);
+
+	/* Step 1: copy cmd to slave's last_cmd */
+	err = tpm_if_spi_gen->spi_xfer(
+			tpm_if_spi_gen->slave,
+			sizeof(cmd_buf) * 8, /* actual cmd length in bits */
+			cmd_buf,
+			NULL,
+			SPI_XFER_BEGIN); /* copies cmd to slave's last_cmd */
+	if (err)
+		goto out_err;
+
+	/* Step 2: send read command and read data */
+	err = tpm_if_spi_gen->spi_xfer(
+			tpm_if_spi_gen->slave,
+			data_size * 8,
+			NULL,
+			data,
+			SPI_XFER_END);
+	if (!err)
+		goto out;
+
+out_err:
+	al_err("TPM SPI read access failed\n");
+	*data = 0;
+
+out:
+tpm_if_spi_gen->spi_release_bus(tpm_if_spi_gen->slave);
+	return err;
+}
+
+static int al_tpm_if_spi_read(
+	struct al_tpm_if *tpm_if, unsigned int offset, uint8_t *data, unsigned int data_size)
+{
+	int err = 0;
+	struct al_tpm_if_spi *tpm_if_spi;
+	al_assert(tpm_if);
+	al_assert(tpm_if->priv);
+
+	tpm_if_spi = tpm_if->priv;
+
+	err = al_spi_claim_bus(
+		tpm_if_spi->spi_if, tpm_if_spi->freq,  tpm_if_spi->phase,
+		tpm_if_spi->polarity, tpm_if_spi->cs);
+	if (err) {
+		al_err("%s: TPM SPI claim bus failed!\n", __func__);
+		*data = 0;
+		return err;
+	}
+
+	al_memset(tpm_if_spi->TX, 0, TPM_MAX_COMMAND_SIZE);
+	al_memset(tpm_if_spi->RX, 0, TPM_MAX_COMMAND_SIZE);
+
+	fill_cmd_buf(tpm_if_spi->TX, offset, data_size, SPI_READ_CMD);
+
+	err = al_spi_read(
+			tpm_if_spi->spi_if,
+			tpm_if_spi->TX,
+			4,
+			tpm_if_spi->RX,
+			data_size,
+			tpm_if_spi->cs,
+			TPM_SPI_TIMEOUT);
+	if (!err)
+		al_memcpy(data, tpm_if_spi->RX, data_size);
+	else
+		*data = 0;
+
+	al_spi_release_bus(tpm_if_spi->spi_if, tpm_if_spi->cs);
+
+	return err;
+}
+
+static uint8_t al_tpm_if_spi_read1(struct al_tpm_if *tpm_if, unsigned int offset)
+{
+	uint8_t data;
+	int err;
+
+	err = tpm_if->read(tpm_if, offset, &data, 1);
+	if (err)
+		al_err("TPM SPI access failed\n");
+	return data;
+}
+
+static uint32_t al_tpm_if_spi_read4(struct al_tpm_if *tpm_if, unsigned int offset)
+{
+	uint32_t data;
+	int err = 0;
+	err = tpm_if->read(tpm_if, offset, (uint8_t *)&data, 4);
+	if (err)
+		al_err("TPM SPI read access failed\n");
+
+	return data;
+}
+
+static int al_tpm_if_spi_write_gen(
+	struct al_tpm_if *tpm_if,
+	unsigned int offset,
+	uint8_t *data,
+	unsigned int data_size)
+{
+	int err = 0;
+	struct al_tpm_if_spi_gen *tpm_if_spi_gen;
+	unsigned char cmd_buf[4];
+
+	al_assert(tpm_if);
+	al_assert(tpm_if->priv);
+
+	tpm_if_spi_gen = tpm_if->priv;
+
+	err = tpm_if_spi_gen->spi_claim_bus(tpm_if_spi_gen->slave);
+	if (err) {
+		al_err("%s: TPM SPI claim bus failed!\n", __func__);
+		*data = 0;
+		return err;
+	}
+
+	fill_cmd_buf(cmd_buf, offset, data_size, SPI_WRITE_CMD);
+
+	/* Step 1: copy cmd to slave's last_cmd */
+	err = tpm_if_spi_gen->spi_xfer(
+			tpm_if_spi_gen->slave,
+			sizeof(cmd_buf) * 8, /* actual cmd length in bits */
+			cmd_buf,
+			NULL,
+			SPI_XFER_BEGIN); /* copies cmd to slave's last_cmd */
+	if (err)
+		goto out_err;
+
+	/* Step 2: send write command and write data */
+	err = tpm_if_spi_gen->spi_xfer(
+			tpm_if_spi_gen->slave,
+			data_size * 8,
+			data,
+			NULL,
+			SPI_XFER_END);
+	if (!err)
+		goto out;
+
+out_err:
+	al_err("TPM SPI write access failed\n");
+
+out:
+	tpm_if_spi_gen->spi_release_bus(tpm_if_spi_gen->slave);
+	return err;
+}
+
+static int al_tpm_if_spi_write(
+	struct al_tpm_if *tpm_if, unsigned int offset, uint8_t *data, unsigned int data_size)
+{
+	int err = 0;
+	struct al_tpm_if_spi *tpm_if_spi;
+	al_assert(tpm_if);
+	al_assert(tpm_if->priv);
+	tpm_if_spi = tpm_if->priv;
+
+	err = al_spi_claim_bus(
+		tpm_if_spi->spi_if, tpm_if_spi->freq, tpm_if_spi->phase,
+		tpm_if_spi->polarity, tpm_if_spi->cs);
+	if (err) {
+		al_err("TPM SPI claim bus failed!\n");
+		return err;
+	}
+
+	al_memset(tpm_if_spi->TX, 0, TPM_MAX_COMMAND_SIZE);
+
+	fill_cmd_buf(tpm_if_spi->TX, offset, data_size, SPI_WRITE_CMD);
+
+	err = al_spi_write(
+		tpm_if_spi->spi_if ,
+		tpm_if_spi->TX,
+		4,
+		data,
+		data_size,
+		tpm_if_spi->cs,
+		TPM_SPI_TIMEOUT);
+	if (err)
+		al_err("TPM SPI write access failed\n");
+
+	al_spi_release_bus(tpm_if_spi->spi_if, tpm_if_spi->cs);
+
+	return err;
+}
+
+static void al_tpm_if_spi_write1(struct al_tpm_if *tpm_if, unsigned int offset, uint8_t val)
+{
+	int err = 0;
+	err = tpm_if->write(tpm_if, offset, &val, 1);
+	if (err)
+		al_err("TPM SPI access failed\n");
+
+}
+
+static void al_tpm_if_spi_write4(struct al_tpm_if *tpm_if, unsigned int offset, uint32_t val)
+{
+	int err = 0;
+	err = tpm_if->write(tpm_if, offset, (uint8_t *)&val, 4);
+	if (err)
+		al_err("TPM SPI access failed\n");
+}
+
+static void init_common_spi_if(
+		struct al_tpm_if *tpm_if,
+		void *priv_structure,
+		int (*read)(struct al_tpm_if *tpm_if, unsigned int offset, uint8_t *p, unsigned int size),
+		int (*write)(struct al_tpm_if *tpm_if, unsigned int offset, uint8_t *p, unsigned int size))
+{
+	tpm_if->priv = priv_structure;
+
+	tpm_if->read = read;
+	tpm_if->write = write;
+	tpm_if->read1 = al_tpm_if_spi_read1;
+	tpm_if->read4 = al_tpm_if_spi_read4;
+	tpm_if->write1 = al_tpm_if_spi_write1;
+	tpm_if->write4 = al_tpm_if_spi_write4;
+}
+
+void al_tpm_if_spi_handle_init_gen(
+		struct al_tpm_if *tpm_if,
+		struct al_tpm_if_spi_gen *tpm_if_spi_gen,
+		const struct al_tpm_if_spi_gen *init_params_gen)
+{
+	al_assert(tpm_if);
+	al_assert(tpm_if_spi_gen);
+	al_assert(init_params_gen);
+
+	al_memset(tpm_if, 0, sizeof(struct al_tpm_if));
+	al_memset(tpm_if_spi_gen, 0, sizeof(struct al_tpm_if_spi_gen));
+
+	tpm_if_spi_gen->slave = init_params_gen->slave;
+	tpm_if_spi_gen->spi_claim_bus = init_params_gen->spi_claim_bus;
+	tpm_if_spi_gen->spi_release_bus = init_params_gen->spi_release_bus;
+	tpm_if_spi_gen->spi_xfer = init_params_gen->spi_xfer;
+
+	init_common_spi_if(tpm_if,
+			tpm_if_spi_gen,
+			al_tpm_if_spi_read_gen,
+			al_tpm_if_spi_write_gen);
+}
+
+void al_tpm_if_spi_handle_init_ex(struct al_tpm_if *tpm_if, struct al_tpm_if_spi *tpm_if_spi,
+	struct al_tpm_if_spi_init_params *init_params)
+{
+	al_assert(tpm_if);
+	al_assert(tpm_if_spi);
+	al_assert(init_params);
+	al_assert(init_params->spi_if);
+
+	al_memset(tpm_if, 0, sizeof(struct al_tpm_if));
+	al_memset(tpm_if_spi, 0, sizeof(struct al_tpm_if_spi));
+
+	tpm_if_spi->spi_if = init_params->spi_if;
+	tpm_if_spi->cs = init_params->cs;
+	tpm_if_spi->polarity = init_params->polarity;
+	tpm_if_spi->phase = init_params->phase;
+	tpm_if_spi->freq = init_params->freq;
+
+	init_common_spi_if(tpm_if,
+			tpm_if_spi,
+			al_tpm_if_spi_read,
+			al_tpm_if_spi_write);
+}
+
+void al_tpm_if_spi_handle_init(struct al_tpm_if *tpm_if, struct al_tpm_if_spi *tpm_if_spi,
+		struct al_spi_interface	*spi_if, unsigned int cs)
+{
+	al_assert(tpm_if);
+	al_assert(tpm_if_spi);
+	al_assert(spi_if);
+
+	al_memset(tpm_if, 0, sizeof(struct al_tpm_if));
+	al_memset(tpm_if_spi, 0, sizeof(struct al_tpm_if_spi));
+
+	tpm_if_spi->spi_if = spi_if;
+	tpm_if_spi->cs = cs;
+	tpm_if_spi->polarity = AL_SPI_POLARITY_INACTIVE_LOW;
+	tpm_if_spi->phase = AL_SPI_PHASE_SLAVE_SELECT;
+	tpm_if_spi->freq = DEFAULT_FREQ;
+
+	init_common_spi_if(tpm_if,
+			tpm_if_spi,
+			al_tpm_if_spi_read,
+			al_tpm_if_spi_write);
+}
