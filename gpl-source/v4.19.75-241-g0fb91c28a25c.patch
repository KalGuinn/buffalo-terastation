+
+#ifndef __AL_HAL_ETH_KR_H__
+#define __AL_HAL_ETH_KR_H__
+
+#include "al_mod_hal_eth_common.h"
+#include "al_mod_hal_eth.h"
+
+#define AL_ETH_AN_TECH_1000BASE_KX  AL_BIT(0)
+#define AL_ETH_AN_TECH_10GBASE_KX4  AL_BIT(1)
+#define AL_ETH_AN_TECH_10GBASE_KR   AL_BIT(2)
+#define AL_ETH_AN_TECH_40GBASE_KR4  AL_BIT(3)
+#define AL_ETH_AN_TECH_40GBASE_CR4  AL_BIT(4)
+#define AL_ETH_AN_TECH_100GBASE_CR  AL_BIT(5)
+#define AL_ETH_AN_TECH_100GBASE_KP4 AL_BIT(6)
+#define AL_ETH_AN_TECH_100GBASE_KR4 AL_BIT(7)
+#define AL_ETH_AN_TECH_100GBASE_CR4 AL_BIT(8)
+
+#define AL_ETH_AN_FEC_ADV           AL_BIT(0)
+#define AL_ETH_AN_FEC_REQ           AL_BIT(1)
+
+/* *INDENT-OFF* */
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* *INDENT-ON* */
+
+/* AN (Auto-negotiation) Advertisement Registers */
+struct al_mod_eth_an_adv {
+	/* constant value defining 802.3ap support.
+	 * The suggested value is 0x01.*/
+	uint8_t   selector_field;
+	/* Contains arbitrary data. */
+	uint8_t   echoed_nonce;
+	/* pause capability. */
+	uint8_t   capability;
+	/* Set to 1 to indicate a Remote Fault condition.
+	 * Set to 0 to indicate normal operation.*/
+	uint8_t   remote_fault;
+	/* Should always be set to 0. */
+	uint8_t   acknowledge;
+	/* Set to 1 to indicate that the device has next pages to send.
+	 * Set to 0 to indicate that that device has no next pages to send. */
+	uint8_t   next_page;
+	/* Must be set to an arbitrary value.
+	 * Two devices must have a different nonce for autonegotiation to
+	 * operate (a loopback will not allow autonegotiation to complete). */
+	uint8_t   transmitted_nonce;
+	uint32_t  technology;
+	uint8_t   fec_capability;
+};
+
+/* AN next page fields */
+struct al_mod_eth_an_np {
+	/* These bits can be used as message code field or unformatted code field.
+	 * When msg_page is true, these bits represent message code field.
+	 * Predefined message code field Code Field should be used as specified in the standard
+	 * 802.3ap.
+	 * For the null message code the value is 0x01.
+	 */
+	uint16_t	unformatted_code_field;
+	/* Flag to keep track of the state of the local device's Toggle bit.
+	 * Initial value is taken from base page. Set to 0.
+	 */
+	al_mod_bool		toggle;
+	/*
+	 * This bit should remain set to one throughout the Next Page process,
+	 * provided that the Next Page process runs smoothly
+	 * set it to false if the device doesnt have any more next pages to send
+	 */
+	uint8_t   ack;
+	/* Acknowledge 2 is used to indicate that the receiver is able to act on the information
+	 * (or perform the task) defined in the message.
+	 */
+	al_mod_bool		ack2;
+	al_mod_bool		msg_page;
+	/* If the device does not have any more Next Pages to send, set to AL_FALSE */
+	al_mod_bool		next_page;
+	uint16_t	unformatted_code_field1;
+	uint16_t	unformatted_code_field2;
+
+	/* If the device does not have any more Next Pages to send, set to AL_FALSE */
+	al_mod_bool ack_no_more_pages;
+};
+
+enum al_mod_eth_kr_cl72_cstate {
+	C72_CSTATE_NOT_UPDATED = 0,
+	C72_CSTATE_UPDATED = 1,
+	C72_CSTATE_MIN = 2,
+	C72_CSTATE_MAX = 3,
+};
+
+enum al_mod_eth_kr_cl72_coef_op {
+	AL_PHY_KR_COEF_UP_HOLD = 0,
+	AL_PHY_KR_COEF_UP_INC = 1,
+	AL_PHY_KR_COEF_UP_DEC = 2,
+	AL_PHY_KR_COEF_UP_RESERVED = 3
+};
+
+struct al_mod_eth_kr_coef_up_data {
+	enum al_mod_eth_kr_cl72_coef_op c_zero;
+	enum al_mod_eth_kr_cl72_coef_op c_plus;
+	enum al_mod_eth_kr_cl72_coef_op c_minus;
+	al_mod_bool preset;
+	al_mod_bool initialize;
+};
+
+struct al_mod_eth_kr_status_report_data {
+	enum al_mod_eth_kr_cl72_cstate c_zero;
+	enum al_mod_eth_kr_cl72_cstate c_plus;
+	enum al_mod_eth_kr_cl72_cstate c_minus;
+	al_mod_bool receiver_ready;
+};
+
+/** DME downsample configuration */
+struct al_mod_hal_eth_an_lt_dme_downsample_conf {
+	unsigned int max_curr_sample_point;
+	uint32_t mask_find_first_vec;
+	al_mod_bool en_override;
+};
+
+/**
+ * get the last received coefficient update message from the link partner
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ * @param lpcoeff coeff update received
+ *
+ */
+void al_mod_eth_lp_coeff_up_get(
+			struct al_mod_hal_eth_adapter *adapter,
+			enum al_mod_eth_an_lt_lane lane,
+			struct al_mod_eth_kr_coef_up_data *lpcoeff);
+
+/**
+ * get the last received status report message from the link partner
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ * @param status status report received
+ *
+ */
+void al_mod_eth_lp_status_report_get(
+			struct al_mod_hal_eth_adapter *adapter,
+			enum al_mod_eth_an_lt_lane lane,
+			struct al_mod_eth_kr_status_report_data *status);
+
+/**
+ * set the coefficient data for the next message that will be sent to lp
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ * @param ldcoeff coeff update to send
+ *
+ */
+void al_mod_eth_ld_coeff_up_set(
+			struct al_mod_hal_eth_adapter *adapter,
+			enum al_mod_eth_an_lt_lane lane,
+			struct al_mod_eth_kr_coef_up_data *ldcoeff);
+
+/**
+ * set the status report message for the next message that will be sent to lp
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ * @param status status report to send
+ *
+ */
+void al_mod_eth_ld_status_report_set(
+			struct al_mod_hal_eth_adapter *adapter,
+			enum al_mod_eth_an_lt_lane lane,
+			struct al_mod_eth_kr_status_report_data *status);
+
+/**
+ * get the receiver frame lock status
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ *
+ * @return true if Training frame delineation is detected, otherwise false.
+ */
+al_mod_bool al_mod_eth_kr_receiver_frame_lock_get(struct al_mod_hal_eth_adapter *adapter,
+					  enum al_mod_eth_an_lt_lane lane);
+
+/**
+ * get the start up protocol progress status
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ *
+ * @return true if the startup protocol is in progress.
+ */
+al_mod_bool al_mod_eth_kr_startup_proto_prog_get(struct al_mod_hal_eth_adapter *adapter,
+					 enum al_mod_eth_an_lt_lane lane);
+
+/**
+ * indicate the receiver is ready (the link training is completed)
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ *
+ */
+void al_mod_eth_receiver_ready_set(struct al_mod_hal_eth_adapter *adapter,
+			       enum al_mod_eth_an_lt_lane lane);
+
+/**
+ * read Training failure status.
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ *
+ *@return true if Training failure has been detected.
+ */
+al_mod_bool al_mod_eth_kr_training_status_fail_get(struct al_mod_hal_eth_adapter *adapter,
+					   enum al_mod_eth_an_lt_lane lane);
+
+/****************************** auto negotiation *******************************/
+/**
+ * Initialize Auto-negotiation
+ * - Program Ability Registers (Advertisement Registers)
+ * - Clear Status latches
+ * @param adapter pointer to the private structure
+ * @param an_adv pointer to the AN Advertisement Registers structure
+ *        when NULL, the registers will not be updated.
+ *
+ * @return 0 on success. otherwise on failure.
+ */
+int al_mod_eth_kr_an_init(struct al_mod_hal_eth_adapter *adapter,
+		      struct al_mod_eth_an_adv *an_adv);
+
+/**
+ * Enable/Restart Auto-negotiation
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ * @param next_page_enable next page enable
+ * @param lt_enable initialize link training as well
+ *
+ * @return 0 on success. otherwise on failure.
+ */
+int al_mod_eth_kr_an_start(struct al_mod_hal_eth_adapter *adapter,
+		       enum al_mod_eth_an_lt_lane lane,
+		       al_mod_bool next_page_enable,
+		       al_mod_bool lt_enable);
+
+
+int al_mod_eth_kr_next_page_write(struct al_mod_hal_eth_adapter *adapter,
+			      struct al_mod_eth_an_np *np);
+
+int al_mod_eth_kr_next_page_read(struct al_mod_hal_eth_adapter *adapter,
+			     struct al_mod_eth_an_np *np);
+
+/**
+ * Stop Auto-negotiation
+ *
+ * Stopping the auto-negotiation will prevent the mac from sending the last page
+ * to the link partner in case it start the AN again. It must be called after
+ * link training is completed or the software will lose sync with the HW state
+ * machine
+ *
+ * @param adapter pointer to the private structure
+ *
+ */
+void al_mod_eth_kr_an_stop(struct al_mod_hal_eth_adapter *adapter);
+
+/**
+ *  Check Auto-negotiation event done
+ *
+ * @param adapter pointer to the private structure
+ * @param page_received	Set to true if the AN page received indication is set.
+ *			Set to false otherwise.
+ * @param an_completed	Set to true of the AN completed indication is set.
+ *			Set to false otherwise.
+ * @param error	Set to true if any error encountered
+ *
+ */
+void al_mod_eth_kr_an_status_check(struct al_mod_hal_eth_adapter *adapter,
+			      al_mod_bool *page_received,
+			      al_mod_bool *an_completed,
+			      al_mod_bool *error);
+
+/**
+ * Check if entire Auto-negotiation process is done
+ * @param adapter pointer to the private structure
+ * @param an_select Value of an_select field read from the register
+ *
+ */
+int al_mod_eth_kr_an_wait_done(struct al_mod_hal_eth_adapter *adapter,
+	int *an_select);
+
+/**
+ *  Read the remote auto-negotiation advertising.
+ *  This function is safe to called after al_mod_eth_kr_an_status_check returned
+ *  with page_received set.
+ *
+ * @param adapter pointer to the private structure
+ * @param an_adv pointer to the AN Advertisement Registers structure
+ *
+ */
+void al_mod_eth_kr_an_read_adv(struct al_mod_hal_eth_adapter *adapter,
+			   struct al_mod_eth_an_adv *an_adv);
+
+/**
+ *  Set the AN_LT module's link_status bit to the specified value
+ *
+ *  Should be done after DUT linkup is established (block lock / align lock, etc.)
+ *  (i.e. al_mod_eth_link_status_get() == 1)
+ *
+ * @param adapter pointer to the private structure
+ * @param link_status to set link_status bit in AN_LT module
+ *
+ */
+void al_mod_eth_kr_an_link_status_set(struct al_mod_hal_eth_adapter *adapter,
+	int link_status);
+
+/****************************** link training **********************************/
+/**
+ *  Initialize Link-training.
+ *  Clear the status register and set the local coefficient update and status
+ *  to zero.
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ *
+ */
+void al_mod_eth_kr_lt_initialize(struct al_mod_hal_eth_adapter *adapter,
+			     enum al_mod_eth_an_lt_lane lane);
+
+/**
+ * Wait for frame lock.
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ * @param timeout timeout in usec.
+ *
+ * @return true if frame lock received. false otherwise.
+ */
+al_mod_bool al_mod_eth_kr_lt_frame_lock_wait(struct al_mod_hal_eth_adapter *adapter,
+				     enum al_mod_eth_an_lt_lane lane,
+				     uint32_t timeout);
+
+/**
+ * reset the 10GBase- KR startup protocol and begin its operation
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ *
+ */
+void al_mod_eth_kr_lt_restart(struct al_mod_hal_eth_adapter *adapter,
+			  enum al_mod_eth_an_lt_lane lane);
+
+/**
+ * reset the 10GBase- KR startup protocol and end its operation
+ *
+ * @param adapter pointer to the private structure
+ * @param lane lane number
+ *
+ */
+void al_mod_eth_kr_lt_stop(struct al_mod_hal_eth_adapter *adapter,
+		       enum al_mod_eth_an_lt_lane lane);
+
+/**
+ * Configure the interrupt controller registers, actual interrupts are still
+ * masked at this stage.
+ *
+ * @param adapter pointer to the private structure
+ * @param group the interrupt group.
+ * @param lane the AN/LT serdes lane to configure
+ * @param flags flags of Interrupt Control Register
+ *
+ * @return 0 on success. -EINVAL otherwise.
+ */
+int al_mod_eth_an_lt_iofic_config(struct al_mod_hal_eth_adapter *adapter, int group, int lane,
+	uint32_t flags);
+
+/**
+ * mask specific interrupts for a given group
+ * this functions modifies interrupt mask register, the callee must make sure
+ * the mask is not changed by another cpu.
+ *
+ * @param adapter pointer to the private structure
+ * @param group the interrupt group
+ * @param lane the AN/LT serdes lane to configure
+ * @param mask bitwise of interrupts to mask, set bits will be unmasked.
+ */
+void al_mod_eth_an_lt_iofic_mask(struct al_mod_hal_eth_adapter *adapter, int group, int lane,
+	uint32_t mask);
+
+/**
+ * unmask specific interrupts for a given group
+ * this functions guarantees atomic operations, it is performance optimized as
+ * it will not require read-modify-write. The unmask done using the interrupt
+ * mask clear register, so it's safe to call it while the mask is changed by
+ * the HW (auto mask) or another core.
+ *
+ * @param adapter pointer to the private structure
+ * @param group the interrupt group
+ * @param lane the AN/LT serdes lane to configure
+ * @param mask bitwise of interrupts to unmask, set bits will be unmasked.
+ */
+void al_mod_eth_an_lt_iofic_unmask(struct al_mod_hal_eth_adapter *adapter, int group, int lane,
+	uint32_t mask);
+/**
+ * read interrupt cause register for a given group
+ * this will clear the set bits if the Clear on Read mode enabled.
+ * @param adapter pointer to the private structure
+ * @param lane the AN/LT serdes lane to configure
+ * @param group the interrupt group
+ */
+uint32_t al_mod_eth_an_lt_iofic_read_cause(struct al_mod_hal_eth_adapter *adapter, int group, int lane);
+
+/**
+ * set interrupt cause register for a given group
+ * this will clear the set bits if the Clear on Read mode enabled.
+ * @param adapter pointer to the private structure
+ * @param group the interrupt group
+ * @param lane the AN/LT serdes lane to configure
+ * @param mask bitwise of bits to be set.
+ */
+void al_mod_eth_an_lt_iofic_set_cause(struct al_mod_hal_eth_adapter *adapter, int group, int lane,
+	uint32_t mask);
+
+/** DME downsample configuration */
+
+/**
+ * DME downsample configuration override
+ *
+ * @param adapter pointer to the private structure
+ * @param conf the required configuration
+ */
+void al_mod_eth_an_lt_dme_downsample_override(struct al_mod_hal_eth_adapter *adapter,
+	struct al_mod_hal_eth_an_lt_dme_downsample_conf *conf);
+
+#ifdef __cplusplus
+}
+#endif
+/* *INDENT-ON* */
+#endif /*__AL_HAL_ETH_KR_H__*/
+/** @} end of Ethernet kr group */
