+/* uC shared location in SRAM */
+#define AL_UC_SHARED_BASE	(AL_PBS_SRAM_BASE + 0xF000)
+
+/* TDM sub windows */
+#define AL_TDM_AXI_TX_FIFO_BASE (AL_TDM_AXI_BASE + 0x00000)
+#define AL_TDM_AXI_RX_FIFO_BASE (AL_TDM_AXI_BASE + 0x01000)
