+
+	if (adapter->rev_id < AL_ETH_REV_ID_3) {
+		reg_addr = al_mod_eth_an_lt_regs_addr[reg_id][AL_ETH_LT_UNIT_REV_1];
+		if (an_lt == AL_ETH_AN_REGS) {
