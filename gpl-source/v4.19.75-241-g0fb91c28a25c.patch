+
+	al_reg_write32_masked(&ctrl_regs->alpine_v3.umctl2_regs.crcparctl0,
+			DWC_DDR_UMCTL2_REGS_CRCPARCTL0_DFI_ALERT_ERR_INT_CLR,
+			DWC_DDR_UMCTL2_REGS_CRCPARCTL0_DFI_ALERT_ERR_INT_CLR);
+
+	al_data_memory_barrier();
+
+	al_reg_write32(&ddrc_regs->channel.int_cause, ~DDRC_CHANNEL_INT_CAUSE_DFI_ALERT_ERR);
+}
