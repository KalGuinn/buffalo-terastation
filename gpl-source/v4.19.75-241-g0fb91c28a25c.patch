+#define AL_TDM_APB_CFG_BASE (AL_PBS_TDM_APB_BASE + 0x02000)
+#define AL_SPI_MASTER_AUX_BASE	(AL_PBS_TDM_APB_BASE + 0x0002100)
+
+/************************************
+  SBUS complexes & slave addresses
+************************************/
+#define AL_SBUS_MASTER_BASE_THERMAL_SENSOR			AL_SRD_CMPLX_HS_SBUS_MASTER_BASE
+#define AL_SBUS_ADDR_THERMAL_SENSOR				6
+
+#endif
