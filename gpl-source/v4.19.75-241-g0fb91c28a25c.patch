+static int mac_stats_get(struct al_eth_mac_obj *obj,  struct al_eth_mac_stats *stats)
+{
+	struct al_eth_mac_regs *mac_regs_base = obj->mac_regs_base;
+	struct al_eth_mac_1g_stats __iomem *stats_1g = &mac_regs_base->mac_1g.stats;
+	struct al_eth_mac_10g_stats_v2 __iomem *stats_10g = &mac_regs_base->mac_10g.stats.v2;
+	uint64_t octets;
+
+	al_assert(stats);
+
+	al_memset(stats, 0, sizeof(struct al_eth_mac_stats));
+
+	switch (obj->mac_mode) {
+	case AL_ETH_MAC_MODE_RGMII:
+	case AL_ETH_MAC_MODE_SGMII:
+		stats->if_in_ucast_pkts = al_reg_read32(&stats_1g->if_in_ucast_pkts);
+		stats->if_in_mcast_pkts = al_reg_read32(&stats_1g->if_in_mcast_pkts);
+		stats->if_in_bcast_pkts = al_reg_read32(&stats_1g->if_in_bcast_pkts);
+		stats->pkts = al_reg_read32(&stats_1g->pkts);
+		stats->if_out_ucast_pkts = al_reg_read32(&stats_1g->if_out_ucast_pkts);
+		stats->if_out_mcast_pkts = al_reg_read32(&stats_1g->if_out_mcast_pkts);
+		stats->if_out_bcast_pkts = al_reg_read32(&stats_1g->if_out_bcast_pkts);
+		stats->if_in_errors = al_reg_read32(&stats_1g->if_in_errors);
+		stats->if_out_errors = al_reg_read32(&stats_1g->if_out_errors);
+		stats->frames_rxed_ok = al_reg_read32(&stats_1g->frames_rxed_ok);
+		stats->frames_txed_ok = al_reg_read32(&stats_1g->frames_txed_ok);
+		stats->octets_rxed_ok = al_reg_read32(&stats_1g->octets_rxed_ok);
+		stats->octets_txed_ok = al_reg_read32(&stats_1g->octets_txed_ok);
+		stats->undersize_pkts = al_reg_read32(&stats_1g->undersize_pkts);
+		stats->fragments = al_reg_read32(&stats_1g->fragments);
+		stats->jabbers = al_reg_read32(&stats_1g->jabbers);
+		stats->oversize_pkts = al_reg_read32(&stats_1g->oversize_pkts);
+		stats->fcs_errors =
+			al_reg_read32(&stats_1g->fcs_errors);
+		stats->alignment_errors = al_reg_read32(&stats_1g->alignment_errors);
+		stats->drop_events = al_reg_read32(&stats_1g->drop_events);
+		stats->pause_mac_ctrl_frames_txed =
+			al_reg_read32(&stats_1g->pause_mac_ctrl_frames_txed);
+		stats->pause_mac_ctrl_frames_rxed =
+			al_reg_read32(&stats_1g->pause_mac_ctrl_frames_rxed);
+		stats->frame_too_long_errs = 0; /* N/A */
+		stats->in_range_length_errs = 0; /* N/A */
+		stats->vlan_txed_ok = 0; /* N/A */
+		stats->vlan_rxed_ok = 0; /* N/A */
+		stats->octets = al_reg_read32(&stats_1g->octets);
+		stats->pkts_64_octets = al_reg_read32(&stats_1g->pkts_64_octets);
+		stats->pkts_65_to_127_octets =
+			al_reg_read32(&stats_1g->pkts_65_to_127_octets);
+		stats->pkts_128_to_255_octets =
+			al_reg_read32(&stats_1g->pkts_128_to_255_octets);
+		stats->pkts_256_to_511_octets =
+			al_reg_read32(&stats_1g->pkts_256_to_511_octets);
+		stats->pkts_512_to_1023_octets =
+			al_reg_read32(&stats_1g->pkts_512_to_1023_octets);
+		stats->pkts_1024_to_1518_octets =
+			al_reg_read32(&stats_1g->pkts_1024_to_1518_octets);
+		stats->pkts_1519_to_x = al_reg_read32(&stats_1g->pkts_1519_to_x);
+		break;
+	case AL_ETH_MAC_MODE_SGMII_2_5G:
+	case AL_ETH_MAC_MODE_10GbE_Serial:
+	case AL_ETH_MAC_MODE_10G_SGMII:
+		stats->if_in_ucast_pkts = al_reg_read32(&stats_10g->if_in_ucast_pkts);
+		stats->if_in_mcast_pkts = al_reg_read32(&stats_10g->if_in_mcast_pkts);
+		stats->if_in_bcast_pkts = al_reg_read32(&stats_10g->if_in_bcast_pkts);
+		stats->pkts = al_reg_read32(&stats_10g->pkts);
+		stats->if_out_ucast_pkts = al_reg_read32(&stats_10g->if_out_ucast_pkts);
+		stats->if_out_mcast_pkts = al_reg_read32(&stats_10g->if_out_mcast_pkts);
+		stats->if_out_bcast_pkts = al_reg_read32(&stats_10g->if_out_bcast_pkts);
+		stats->if_in_errors = al_reg_read32(&stats_10g->if_in_errors);
+		stats->if_out_errors = al_reg_read32(&stats_10g->if_out_errors);
+		stats->frames_rxed_ok = al_reg_read32(&stats_10g->frames_rxed_ok);
+		stats->frames_txed_ok = al_reg_read32(&stats_10g->frames_txed_ok);
+
+		/* octets_rxed_ok = if_in_octets - 18 * frames_rxed_ok - 4 * vlan_rxed_ok */
+		octets = al_reg_read32(&stats_10g->if_in_octets_l);
+		octets |= (uint64_t)(al_reg_read32(&stats_10g->if_in_octets_h)) << 32;
+		octets -= 18 * stats->frames_rxed_ok;
+		octets -= 4 * al_reg_read32(&stats_10g->vlan_rxed_ok);
+		stats->octets_rxed_ok = octets;
+
+		/* octets_txed_ok = if_out_octets - 18 * frames_txed_ok
+		 * - 4 * vlan_txed_ok */
+		octets = al_reg_read32(&stats_10g->if_out_octets_l);
+		octets |= (uint64_t)(al_reg_read32(&stats_10g->if_out_octets_h)) << 32;
+		octets -= 18 * stats->frames_txed_ok;
+		octets -= 4 * al_reg_read32(&stats_10g->vlan_txed_ok);
+		stats->octets_txed_ok = octets;
+
+		stats->undersize_pkts =
+			al_reg_read32(&stats_10g->undersize_pkts);
+		stats->fragments = al_reg_read32(&stats_10g->fragments);
+		stats->jabbers = al_reg_read32(&stats_10g->jabbers);
+		stats->oversize_pkts = al_reg_read32(&stats_10g->oversize_pkts);
+		stats->fcs_errors =
+			al_reg_read32(&stats_10g->fcs_errors);
+		stats->alignment_errors = al_reg_read32(&stats_10g->alignment_errors);
+		stats->drop_events = al_reg_read32(&stats_10g->drop_events);
+		stats->pause_mac_ctrl_frames_txed =
+			al_reg_read32(&stats_10g->pause_mac_ctrl_frames_txed);
+		stats->pause_mac_ctrl_frames_rxed =
+			al_reg_read32(&stats_10g->pause_mac_ctrl_frames_rxed);
+		stats->frame_too_long_errs = al_reg_read32(&stats_10g->frame_too_long_errs);
+		stats->in_range_length_errs = al_reg_read32(&stats_10g->in_range_length_errs);
+		stats->vlan_txed_ok = al_reg_read32(&stats_10g->vlan_txed_ok);
+		stats->vlan_rxed_ok = al_reg_read32(&stats_10g->vlan_rxed_ok);
+		stats->octets = al_reg_read32(&stats_10g->octets);
+		stats->pkts_64_octets = al_reg_read32(&stats_10g->pkts_64_octets);
+		stats->pkts_65_to_127_octets =
+			al_reg_read32(&stats_10g->pkts_65_to_127_octets);
+		stats->pkts_128_to_255_octets =
+			al_reg_read32(&stats_10g->pkts_128_to_255_octets);
+		stats->pkts_256_to_511_octets =
+			al_reg_read32(&stats_10g->pkts_256_to_511_octets);
+		stats->pkts_512_to_1023_octets =
+			al_reg_read32(&stats_10g->pkts_512_to_1023_octets);
+		stats->pkts_1024_to_1518_octets =
+			al_reg_read32(&stats_10g->pkts_1024_to_1518_octets);
+		stats->pkts_1519_to_x = al_reg_read32(&stats_10g->pkts_1519_to_x);
+		break;
+	default:
+		return -EPERM;
+	}
+
+	stats->eee_in = al_reg_read32(&mac_regs_base->stat.eee_in);
+	stats->eee_out = al_reg_read32(&mac_regs_base->stat.eee_out);
+
+	return 0;
+}
