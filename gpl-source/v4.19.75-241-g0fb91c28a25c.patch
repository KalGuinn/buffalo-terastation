+/* Performance params printout */
+void al_mod_udma_perf_params_print(
+	struct al_mod_udma		*m2s_udma,
+	struct al_mod_udma		*s2m_udma)
+{
+	struct al_mod_udma_m2s_desc_pref_conf m2s_conf;
+	struct al_mod_udma_s2m_desc_pref_conf s2m_conf;
+	unsigned int m2s_ostand_max_data_read;
+	unsigned int m2s_ostand_max_desc_read;
+	unsigned int m2s_ostand_max_comp_req;
+	unsigned int s2m_ostand_max_desc_read;
+	unsigned int s2m_ostand_max_data_req;
+	unsigned int s2m_ostand_max_comp_req;
+	uint32_t reg;
+	int err;
+	unsigned int i;
+
+	err = al_mod_udma_m2s_pref_get(m2s_udma, &m2s_conf);
+	if (err) {
+		al_mod_err("%s: al_mod_udma_handle_init failed!\n", __func__);
+		return;
+	}
+
+	reg = al_mod_reg_read32(&m2s_udma->udma_regs->m2s.axi_m2s.ostand_cfg);
+	m2s_ostand_max_data_read = AL_REG_FIELD_GET(reg,
+		UDMA_AXI_M2S_OSTAND_CFG_MAX_DATA_RD_MASK,
+		UDMA_AXI_M2S_OSTAND_CFG_MAX_DATA_RD_SHIFT);
+	m2s_ostand_max_desc_read = AL_REG_FIELD_GET(reg,
+		UDMA_AXI_M2S_OSTAND_CFG_MAX_DESC_RD_MASK,
+		UDMA_AXI_M2S_OSTAND_CFG_MAX_DESC_RD_SHIFT);
+	m2s_ostand_max_comp_req = AL_REG_FIELD_GET(reg,
+		UDMA_AXI_M2S_OSTAND_CFG_MAX_COMP_REQ_MASK,
+		UDMA_AXI_M2S_OSTAND_CFG_MAX_COMP_REQ_SHIFT);
+
+	err = al_mod_udma_s2m_pref_get(s2m_udma, &s2m_conf);
+	if (err) {
+		al_mod_err("%s: al_mod_udma_handle_init failed!\n", __func__);
+		return;
+	}
+
+	reg = al_mod_reg_read32(&s2m_udma->udma_regs->s2m.axi_s2m.ostand_cfg_rd);
+	s2m_ostand_max_desc_read = AL_REG_FIELD_GET(reg,
+		UDMA_AXI_S2M_OSTAND_CFG_RD_MAX_DESC_RD_OSTAND_MASK,
+		UDMA_AXI_S2M_OSTAND_CFG_RD_MAX_DESC_RD_OSTAND_SHIFT);
+
+	reg = al_mod_reg_read32(&s2m_udma->udma_regs->s2m.axi_s2m.ostand_cfg_wr);
+	s2m_ostand_max_data_req = AL_REG_FIELD_GET(reg,
+		UDMA_AXI_S2M_OSTAND_CFG_WR_MAX_DATA_WR_OSTAND_MASK,
+		UDMA_AXI_S2M_OSTAND_CFG_WR_MAX_DATA_WR_OSTAND_SHIFT);
+	s2m_ostand_max_comp_req = AL_REG_FIELD_GET(reg,
+		UDMA_AXI_S2M_OSTAND_CFG_WR_MAX_COMP_REQ_MASK,
+		UDMA_AXI_S2M_OSTAND_CFG_WR_MAX_COMP_REQ_SHIFT);
+
+	al_mod_print("- M2S\n");
+	al_mod_print("  * outstanding reads:\n");
+	al_mod_print("    > ostand_max_data_read = %u\n", m2s_ostand_max_data_read);
+	al_mod_print("    > ostand_max_desc_read = %u\n", m2s_ostand_max_desc_read);
+	al_mod_print("  * outstanding writes:\n");
+	al_mod_print("    > ostand_max_comp_req = %u\n", m2s_ostand_max_comp_req);
+	al_mod_print("  * prefetch:\n");
+	al_mod_print("    > desc_fifo_depth = %u\n", m2s_conf.desc_fifo_depth);
+	al_mod_print("    > max_desc_per_packet = %u\n", m2s_conf.max_desc_per_packet);
+	al_mod_print("    > pref_thr = %u\n", m2s_conf.pref_thr);
+	al_mod_print("    > min_burst_above_thr = %u\n", m2s_conf.min_burst_above_thr);
+	al_mod_print("    > min_burst_below_thr = %u\n", m2s_conf.min_burst_below_thr);
+	al_mod_print("    > max_pkt_limit = %u\n", m2s_conf.max_pkt_limit);
+	al_mod_print("    > data_fifo_depth = %u\n", m2s_conf.data_fifo_depth);
+
+	al_mod_print("- S2M\n");
+	al_mod_print("  * outstanding reads:\n");
+	al_mod_print("    > ostand_max_desc_read = %u\n", s2m_ostand_max_desc_read);
+	al_mod_print("  * outstanding writes:\n");
+	al_mod_print("    > ostand_max_data_req = %u\n", s2m_ostand_max_data_req);
+	al_mod_print("    > ostand_max_comp_req = %u\n", s2m_ostand_max_comp_req);
+	al_mod_print("  * prefetch:\n");
+	al_mod_print("    > desc_fifo_depth = %u\n", s2m_conf.desc_fifo_depth);
+	al_mod_print("    > pref_thr = %u\n", s2m_conf.pref_thr);
+	al_mod_print("    > min_burst_above_thr = %u\n", s2m_conf.min_burst_above_thr);
+	al_mod_print("    > min_burst_below_thr = %u\n", s2m_conf.min_burst_below_thr);
+
+	for (i = 0; i < al_mod_udma_num_queues_get(s2m_udma); i++) {
+		struct al_mod_udma_q *s2m_udma_q;
+		struct al_mod_udma_s2m_q_comp_conf comp_conf;
+
+		err = al_mod_udma_q_handle_get(s2m_udma, i, &s2m_udma_q);
+		if (err) {
+			al_mod_err("%s: al_mod_udma_q_handle_get failed!\n", __func__);
+			return;
+		}
+
+		if (!al_mod_udma_q_is_enabled(s2m_udma_q)) {
+			al_mod_print("  * Queue %u: Disabled\n", i);
+			continue;
+		}
+
+		al_mod_udma_s2m_q_comp_get(s2m_udma_q, &comp_conf);
+
+		al_mod_print("  * Queue %u\n", i);
+		al_mod_print("    > dis_comp_coal = %s\n",
+			comp_conf.dis_comp_coal ? "enabled" : "disabled");
+		al_mod_print("    > en_comp_ring_update = %s\n",
+			comp_conf.en_comp_ring_update ? "enabled" : "disabled");
+		al_mod_print("    > comp_timer = %u\n", comp_conf.comp_timer);
+		al_mod_print("    > q_qos = %u\n", comp_conf.q_qos);
+	}
+}
