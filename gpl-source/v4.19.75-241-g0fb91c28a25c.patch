+	{.temp = 15, .direction = 1, .step = 0},
+	{.temp = 33, .direction = 1, .step = 1},
+	{.temp = 51, .direction = 1, .step = 2},
+	{.temp = 69, .direction = -1, .step = 3},
+	{.temp = 87, .direction = -1, .step = 2},
+	{.temp = 110, .direction = -1, .step = 1},
+	{.temp = 140, .direction = -1, .step = 0},
+};
