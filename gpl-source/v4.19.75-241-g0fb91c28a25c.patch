+static uint64_t al_mod_eth_50g_mac_reg_read64(
+	struct al_mod_eth_mac_v4_regs *mac_regs_base,
+	uint32_t reg_addr)
+{
+	uint64_t val;
+
+	/* indirect access */
+	al_mod_reg_write32(&mac_regs_base->mtip.mac_50g_addr, reg_addr);
+	val = al_mod_reg_read32(&mac_regs_base->mtip.mac_50g_data);
+
+	al_mod_reg_write32(&mac_regs_base->mtip.mac_50g_addr, reg_addr+4);
+	val |= (uint64_t) (al_mod_reg_read32(&mac_regs_base->mtip.mac_50g_data)) << 32;
+
+	al_mod_dbg("%s: reg %d. val 0x%"PRIx64"\n", __func__, reg_addr, val);
+
+	return val;
+}
