+#define AL_SATA_PMDT_BASE(idx)			(AL_SATA_BASE(idx) + AL_SATA_PMDT_OFFSET)
+#define AL_SATA_IOFIC_OFFSET			0x2000
+#define AL_SATA_IOFIC_BASE(idx)			(AL_SATA_BASE(idx) + AL_SATA_IOFIC_OFFSET)
