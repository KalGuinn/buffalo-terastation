+
+#include "al_mod_hal_common.h"
+#include "al_mod_hal_eth_field.h"
+
+/* Number of bits in 1 byte */
+#define BITS_TO_BYTE					8
+
+void al_mod_eth_field_extractor_calc(const struct al_mod_eth_field_extractor *fe,
+	unsigned int *offset_p, unsigned int *size_p)
+{
+	unsigned int offset = 0;
+	unsigned int size = 0;
+
+	al_mod_assert(fe);
+
+	offset = fe->offset;
+	size = fe->size;
+
+	if (fe->field) {
+		if (!size)
+			size = fe->field->size - offset;
+
+		offset += fe->field->offset;
+
+		if (fe->field->section)
+			offset += fe->field->section->offset;
+	}
+
+	if (offset_p)
+		*offset_p = offset;
+
+	if (size_p)
+		*size_p = size;
+}
+
+void al_mod_eth_field_extractor_calc_byte(const struct al_mod_eth_field_extractor *fe,
+	unsigned int *offset, unsigned int *size)
+{
+	al_mod_eth_field_extractor_calc(fe, offset, size);
+
+	if (offset) {
+		al_mod_assert_msg(((*offset) % BITS_TO_BYTE == 0),
+			"Field extractor offset is not byte aligned\n");
+
+		*offset /= BITS_TO_BYTE;
+	}
+
+	if (size) {
+		al_mod_assert_msg(((*size) % BITS_TO_BYTE == 0),
+			"Field extractor size is not byte aligned\n");
+
+		*size /= BITS_TO_BYTE;
+	}
+}
