+	signal_detect = ((reg & (SERDES_C_LANE_STAT_LN_STAT_LOS |
+				 SERDES_C_LANE_STAT_LN_STAT_LOS_DEGLITCH)) ?
+					AL_FALSE : AL_TRUE);
