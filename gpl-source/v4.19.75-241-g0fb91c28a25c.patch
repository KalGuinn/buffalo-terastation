+		DWC_DDR_UMCTL2_REGS_MSTR_DATA_BUS_WIDTH_32 :
+		DWC_DDR_UMCTL2_REGS_MSTR_DATA_BUS_WIDTH_64) |
+		(en_2t_timing_mode ?
