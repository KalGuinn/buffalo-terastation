+#define AL_ADV_ETH_SRAM_SIZE	SZ_4M
+#define AL_TDM_AXI_BASE		0xf2300000UL
+#define AL_TDM_AXI_SIZE		SZ_128K
+#define AL_PCIE_7_ECAM_BASE	0xfb500000UL
+#define AL_PCIE_7_ECAM_SIZE	SZ_1M
