+static void bist_rx_status(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane,
+	al_mod_bool				*is_locked,
+	al_mod_bool				*err_cnt_overflow,
+	uint32_t			*err_cnt)
+{
+	al_mod_assert(obj);
+	al_mod_assert(lane == AL_SRDS_LANE_0);
+	al_mod_assert(is_locked);
