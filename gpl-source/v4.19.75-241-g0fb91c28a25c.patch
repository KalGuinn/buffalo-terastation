+/* Configure S2M UDMA completion */
+int al_mod_udma_s2m_completion_set(struct al_mod_udma *udma,
+			       struct al_mod_udma_s2m_completion_conf *conf);
+
+/* Configure the M2S UDMA scheduling mode */
+int al_mod_udma_m2s_sc_set(struct al_mod_udma *udma,
+		       struct al_mod_udma_m2s_dwrr_conf *sched);
+
+/* Configure the M2S UDMA rate limitation */
+int al_mod_udma_m2s_rlimit_set(struct al_mod_udma *udma,
+			   struct al_mod_udma_m2s_rlimit_mode *mode);
+int al_mod_udma_m2s_rlimit_reset(struct al_mod_udma *udma);
+
+/* Configure the M2S Stream rate limitation */
+int al_mod_udma_m2s_strm_rlimit_set(struct al_mod_udma *udma,
+				struct al_mod_udma_m2s_rlimit_cfg *conf);
+int al_mod_udma_m2s_strm_rlimit_act(struct al_mod_udma *udma,
+				enum al_mod_udma_m2s_rlimit_action act);
+
+/* Configure the M2S UDMA Q rate limitation */
+int al_mod_udma_m2s_q_rlimit_set(struct al_mod_udma_q *udma_q,
+			     struct al_mod_udma_m2s_rlimit_cfg *conf);
+int al_mod_udma_m2s_q_rlimit_act(struct al_mod_udma_q *udma_q,
+			     enum al_mod_udma_m2s_rlimit_action act);
+
+/* Configure the M2S UDMA Q scheduling mode */
+int al_mod_udma_m2s_q_sc_set(struct al_mod_udma_q *udma_q,
+			 struct al_mod_udma_m2s_q_dwrr_conf *conf);
+int al_mod_udma_m2s_q_sc_pause(struct al_mod_udma_q *udma_q, al_mod_bool set);
+int al_mod_udma_m2s_q_sc_reset(struct al_mod_udma_q *udma_q);
+
+/* M2S UDMA completion and application timeouts */
+int al_mod_udma_m2s_comp_timeouts_set(struct al_mod_udma *udma,
+				  struct al_mod_udma_m2s_comp_timeouts *conf);
+int al_mod_udma_m2s_comp_timeouts_get(struct al_mod_udma *udma,
+				  struct al_mod_udma_m2s_comp_timeouts *conf);
+
+/* UDMA get gen registers */
+static INLINE void __iomem *al_mod_udma_gen_regs_get(struct al_mod_udma *udma)
+{
+	al_mod_assert(udma);
+	al_mod_assert(udma->gen_regs);
+
+	return udma->gen_regs;
+}
+
+/* UDMA get gen interrupt registers */
+static INLINE struct udma_iofic_regs __iomem *al_mod_udma_gen_int_regs_get(struct al_mod_udma *udma)
+{
+	al_mod_assert(udma);
+	al_mod_assert(udma->gen_int_regs);
+
+	return udma->gen_int_regs;
+}
+
+/**
+ * S2M UDMA Configure the expected behavior of Rx/S2M UDMA when there are no Rx Descriptors.
+ *
+ * @param udma
+ * @param drop_packet when set to true, the UDMA will drop packet.
+ * @param gen_interrupt when set to true, the UDMA will generate
+ *        no_desc_hint interrupt when a packet received and the UDMA
+ *	  doesn't find enough free descriptors for it.
+ * @param wait_for_desc_timeout timeout in SB cycles to wait for new
+ *	  descriptors before dropping the packets.
+ *	  Notes:
+ *		- The hint interrupt is raised immediately without waiting
+ *		for new descs.
+ *		- value 0 means wait for ever.
+ *
+ * Notes:
+ * - When get_interrupt is set, the API won't program the iofic to unmask this
+ * interrupt, in this case the callee should take care for doing that unmask
+ * using the al_mod_udma_iofic_config() API.
+ *
+ * - The hardware's default configuration is: no drop packet, generate hint
+ * interrupt.
+ * - This API must be called once and before enabling the UDMA
+ *
+ * @return 0 if no error found.
+ */
+int al_mod_udma_s2m_no_desc_cfg_set(struct al_mod_udma *udma, al_mod_bool drop_packet, al_mod_bool gen_interrupt, uint32_t wait_for_desc_timeout);
+
+/**
+ * M2S UDMA configure a queue's completion update
+ *
+ * @param udma_q UDMA queue
+ * @param enable set to true to enable completion update
+ *
+ * completion update better be disabled for tx queues as those descriptors
+ * doesn't carry useful information, thus disabling it saves DMA accesses.
+ *
+ * @return 0 if no error found.
+ */
+int al_mod_udma_m2s_q_compl_updade_config(struct al_mod_udma_q *udma_q, al_mod_bool enable);
+
+/**
+ * S2M UDMA configure a queue's completion update
+ *
+ * @param udma_q UDMA queue
+ * @param enable set to true to enable completion update
+ *
+ * completion update better be disabled for tx queues as those descriptors
+ * doesn't carry useful information, thus disabling it saves DMA accesses.
+ *
+ * @return 0 if no error found.
+ */
+int al_mod_udma_s2m_q_compl_updade_config(struct al_mod_udma_q *udma_q, al_mod_bool enable);
+
+/**
+ * S2M UDMA configure a queue's completion descriptors coalescing
+ *
+ * @param udma_q UDMA queue
+ * @param enable set to true to enable completion coalescing
+ * @param coal_timeout in South Bridge cycles.
+ *
+ * @return 0 if no error found.
+ */
+int al_mod_udma_s2m_q_compl_coal_config(struct al_mod_udma_q *udma_q, al_mod_bool enable, uint32_t coal_timeout);
+
+/**
+ * S2M UDMA configure completion descriptors write burst parameters
+ *
+ * @param udma
+ * @param burst_size completion descriptors write burst size in bytes.
+ *
+ * @return 0 if no error found.
+ */int al_mod_udma_s2m_compl_desc_burst_config(struct al_mod_udma *udma, uint16_t
+		 burst_size);
+
+/**
+ * S2M UDMA configure a queue's completion header split
+ *
+ * @param udma_q UDMA queue
+ * @param enable set to true to enable completion header split
+ * @param force_hdr_split the header split length will be taken from the queue configuration
+ * @param hdr_len header split length.
+ *
+ * @return 0 if no error found.
+ */
+int al_mod_udma_s2m_q_compl_hdr_split_config(struct al_mod_udma_q *udma_q,
+					 al_mod_bool enable,
+					 al_mod_bool force_hdr_split,
+					 uint32_t hdr_len);
+
+/* S2M UDMA per queue completion configuration */
+int al_mod_udma_s2m_q_comp_set(struct al_mod_udma_q *udma_q,
+			   struct al_mod_udma_s2m_q_comp_conf *conf);
+void al_mod_udma_s2m_q_comp_get(
+	struct al_mod_udma_q		*udma_q,
+	struct al_mod_udma_s2m_q_comp_conf	*conf);
+
+/** UDMA Target-ID control configuration per queue */
+#define AL_UDMA_GEN_TGTID_HAS_CONF_QUEUE_SET_ADV
+void al_mod_udma_gen_tgtid_conf_queue_set_adv(
+	struct al_mod_udma			*udma,
+	struct al_mod_udma_gen_tgtid_conf	*conf,
+	uint32_t qid);
+
+/** UDMA Target-ID control configuration */
+#define AL_UDMA_GEN_TGTID_HAS_CONF_SET_ADV
+void al_mod_udma_gen_tgtid_conf_set_adv(
+	struct al_mod_udma			*udma,
+	struct al_mod_udma_gen_tgtid_conf	*conf);
+
+/** UDMA Target-ID MSIX control configuration */
+#define AL_UDMA_GEN_TGTID_MSIX_HAS_CONF_SET_ADV
+void al_mod_udma_gen_tgtid_msix_conf_set_adv(
+	struct al_mod_udma				*udma,
+	struct al_mod_udma_gen_tgtid_msix_conf	*conf);
+
+/**
+ * Transaction type table
+*/
+
+/** TTT command types */
+#define AL_UDMA_TTT_WR_CMD_BUFF1	0
+
+/** Counter action */
+enum al_mod_udma_ttt_cnt_action {
+	/** Override existing value */
+	AL_UDMA_TTT_CNT_ACTION_OVERRIDE		= 0,
+	/** Add to the existing value (accumulate) */
+	AL_UDMA_TTT_CNT_ACTION_ADD		= 1,
+};
+
+/** Counter target */
+enum al_mod_udma_ttt_cnt_tgt {
+	AL_UDMA_TTT_CNT_TGT_DONT_ADD		= 0,
+	AL_UDMA_TTT_CNT_TGT_ADD_TO_BUFF1_LEN	= 1,
+	AL_UDMA_TTT_CNT_TGT_ADD_TO_BUFF2_LEN	= 2,
+};
+
+/** Padding command */
+enum al_mod_udma_ttt_padding_cmd {
+	/** Don't pad */
+	AL_UDMA_TTT_PADDING_CMD_DISABLE		= 0,
+	/** pad to 64B */
+	AL_UDMA_TTT_PADDING_CMD_64B		= 1,
+};
+
+/** Default configuration transaction types */
+#define AL_UDMA_TTT_TYPE_BUF1_DATA	0
+
+/** Transaction Type Table Entry */
+struct al_mod_udma_ttt_entry {
+	/** Queue number */
+	unsigned int			queue_num;
+	/** Transaction type (0 - 31) */
+	unsigned int			tr_type;
+	/** Write command */
+	unsigned int			wr_cmd;
+	/** Counter action */
+	enum al_mod_udma_ttt_cnt_action	cnt_action;
+	/** Counter target */
+	enum al_mod_udma_ttt_cnt_tgt	cnt_tgt;
+	/**
+	 * AXI Address Selector (per bit)
+	 *
+	 * When bit is '1', take corresponding bit from highest 32 bits of original address
+	 * (from stream interface), when '0' take the bit from corresponding bit in 'axi_msb_addr'.
+	 */
+	uint32_t			axi_msb_addr_sel;
+	/** AXI Address High value */
+	uint32_t			axi_msb_addr;
+	/**
+	 * AXI Target-ID Selector (per bit)
+	 *
+	 * When bit is '1', take corresponding bit from highest 16 bits of original address
+	 * (from stream interface), when '0' take the bit from corresponding bit in 'tgt_id_val'.
+	 */
+	unsigned int			tgt_id_sel;
+	/** AXI Target-ID value (16 bits) */
+	unsigned int			tgt_id_val;
+	/** Write padding command */
+	enum al_mod_udma_ttt_padding_cmd	wr_pad_cmd;
+	/** Force the assertion of all AXI write strobe at the start of section */
+	al_mod_bool				wr_pad_sos_wstrb;
+	/** Force the assertion of all AXI write strobe at the end of section */
+	al_mod_bool				wr_pad_eos_wstrb;
+};
+
+/**
+ * Transaction Type Table enable/disable
+ *
+ * Valid for UDMA >= v4
+ *
+ * @param	udma
+ *		UDMA context
+ * @param	en
+ *		AL_TRUE for enabling, AL_FALSE for disabling
+ */
+void al_mod_udma_ttt_en(
+	struct al_mod_udma	*udma,
+	al_mod_bool		en);
+
+/**
+ * Transaction Type Table entry set
+ *
+ * Valid for UDMA >= v4
+ *
+ * @param	udma
+ *		UDMA context
+ * @param	entry
+ *		Entry params
+ */
+void al_mod_udma_ttt_entry_set(
+	struct al_mod_udma			*udma,
+	struct al_mod_udma_ttt_entry	*entry);
+
+/**
+ * Initialize default configurations for the Transaction Types Table
+ *
+ * Valid for UDMA >= v4
+ *
+ * @param	rx_udma
+ *		UDMA context
+ */
+void al_mod_udma_ttt_default_config(
+	struct al_mod_udma *rx_udma);
+
+/* *INDENT-OFF* */
+#ifdef __cplusplus
+}
+#endif
+/* *INDENT-ON* */
+/** @} end of UDMA config group */
+#endif /* __AL_HAL_UDMA_CONFIG_H__ */
