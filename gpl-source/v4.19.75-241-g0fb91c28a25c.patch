+static int fec_stats_get(struct al_eth_mac_obj *obj, uint32_t *corrected, uint32_t *uncorrectable)
+{
+	struct al_eth_mac_regs *mac_regs_base = obj->mac_regs_base;
+
+	*corrected = al_reg_read32(&mac_regs_base->stat.v3_pcs_10g_ll_cerr);
+	*uncorrectable = al_reg_read32(&mac_regs_base->stat.v3_pcs_10g_ll_ncerr);
+
+	return 0;
+}
