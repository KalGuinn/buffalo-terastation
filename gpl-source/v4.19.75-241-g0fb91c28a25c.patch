+			(post_mpsm_gap_x32_ctrl <<
+			DWC_DDR_UMCTL2_REGS_DRAMTMG11_POST_MPSM_GAP_X32_SHIFT)));
+
+		al_reg_write32_masked(
+			&ctrl_regs->dramtmg12,
+			DWC_DDR_UMCTL2_REGS_DRAMTMG12_T_MRD_PDA_MASK,
