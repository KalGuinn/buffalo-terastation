+#define AL_PCI_COMMAND_INTR_DISABLE		0x400      /* Adapter Interrupt disable */
+
+/**
+ * Status
+ */
+#define AL_PCI_STATUS				0x06       /* 16 bits */
+#define AL_PCI_STATUS_SHIFT			16         /* status shift */
