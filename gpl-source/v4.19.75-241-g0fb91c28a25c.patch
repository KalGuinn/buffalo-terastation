+#define AL_SERDES_25G_UDELAY(usec) (obj->udelay_cb(obj->udelay_cb_context, (usec)))
+#define AL_SERDES_25G_MSLEEP(msec) (obj->msleep_cb(obj->msleep_cb_context, (msec)))
