+		*data = al_mod_reg_read32(&obj->regs->sbus.rcv);
+#else
+	if (!err)
+		*data = al_mod_reg_read32(&obj->regs->sbus.spare_rcv);
+#endif
+
+	/* Unlock SBUS master */
+	al_mod_sbus_mutex_unlock(obj, mutex_user_idx);
