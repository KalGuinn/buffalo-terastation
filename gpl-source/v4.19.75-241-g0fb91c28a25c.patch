+		al_mod_reg_write32(&crc_regs_base->v4_tx_gcp_alu_const_table_1, 48);
+		/* Encryption headers size + UDP - not used */
+		al_mod_reg_write32(&crc_regs_base->v4_tx_gcp_alu_const_table_2, 48);
