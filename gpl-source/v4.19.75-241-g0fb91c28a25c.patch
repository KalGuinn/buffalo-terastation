+int al_mod_pmdt_map_unit_default_config_get(
+		enum al_mod_pmdt_unit id,
+		struct al_mod_pmdt_config *config)
+{
+	al_mod_assert(config);
+
+	if (id >= AL_PMDT_UNIT_MAX) {
