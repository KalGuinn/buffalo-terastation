+	al_assert(params->ref_clk_freq);
+
+	sgpo_if->regs = params->sgpo_regs_base;
+	sgpo_if->ref_clk_freq = params->ref_clk_freq;
+
+	dev_id = al_pbs_dev_id_get(params->pbs_regs_base);
