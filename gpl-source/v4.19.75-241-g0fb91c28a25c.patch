+/*******************************************************************************
+ ******************************************************************************/
+DDR_STATIC unsigned int _al_ddr_logical_rank_from_phys(
+	struct al_ddr_cfg		*ddr_cfg __attribute__((unused)),
+	unsigned int			rank)
+{
+	return rank * 4;
+}
