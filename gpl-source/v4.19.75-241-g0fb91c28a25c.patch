+
+	err = al_sbus_cmd_issue(obj, AL_SBUS_CMD_READ, receiver_addr, data_addr, 0, AL_TRUE);
+
+#if AL_SBUS_USE_CORE
+	if (!err)
+		*data = al_reg_read32(&obj->regs->sbus.rcv);
+#else
+	if (!err)
+		*data = al_reg_read32(&obj->regs->sbus.spare_rcv);
+#endif
+
+	/* Unlock SBUS master */
+	al_sbus_mutex_unlock(obj, mutex_user_idx);
