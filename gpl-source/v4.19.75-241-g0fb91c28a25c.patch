+/**** Port_Init register ****/
+/* Enable port to start LTSSM Link Training */
+#define PCIE_W_GLOBAL_CTRL_PORT_INIT_APP_LTSSM_EN_MASK (1 << 0)
+#define PCIE_W_GLOBAL_CTRL_PORT_INIT_APP_LTSSM_EN_SHIFT (0)
+/* When set to 1'b1 the auto lane reversal is disabled. */
+#define PCIE_W_GLOBAL_CTRL_PORT_INIT_DIS_AUTO_LANE_REVERSAL (1 << 1)
+/* ordering WD were expired */
+#define PCIE_W_GLOBAL_CTRL_PORT_INIT_AMBA_ORDR_MGR_WDT_INT (1 << 2)
+/* compare the ltssm to this value to generate interrupt  */
+#define PCIE_W_GLOBAL_CTRL_PORT_INIT_LTSSM_STATE_CMP_1_BIT5 (1 << 3)
+/*
+ * Device Type
