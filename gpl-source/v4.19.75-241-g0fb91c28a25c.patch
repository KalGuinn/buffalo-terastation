+	((idx) == 0) ? AL_PCIE_0_BASE :	\
+	((idx) == 1) ? AL_PCIE_1_BASE :	\
+	((idx) == 2) ? AL_PCIE_2_BASE :	\
+	((idx) == 3) ? AL_PCIE_3_BASE :	\
