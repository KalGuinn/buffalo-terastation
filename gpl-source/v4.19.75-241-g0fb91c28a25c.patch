+static inline al_mod_bool elapsed_time_msec(unsigned int current_time,
+					unsigned int *start_time,
+					unsigned int time_interval)
+{
+	if ((current_time - *start_time) >= time_interval) {
+		*start_time = current_time;
+		return AL_TRUE;
+	}
+
+	return AL_FALSE;
