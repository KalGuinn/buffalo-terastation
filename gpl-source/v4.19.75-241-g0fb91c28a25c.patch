+#if ((defined(AL_DEV_ID) && (AL_DEV_ID <= AL_DEV_ID_ALPINE_V2)) ||\
+	(defined(AL_DEV_ID) && defined(AL_DEV_REV_ID)))
+
+#include <al_hal_common.h>
+#include <al_hal_reg_utils.h>
+#include <al_hal_nb_regs_common.h>
+#include <al_hal_nb_regs_v1_v2.h>
