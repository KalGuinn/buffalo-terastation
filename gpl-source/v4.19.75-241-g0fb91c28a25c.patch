+ */
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_7_AR_PF_VEC_MSG_ADDR_SEL_MASK 0x000FFFFF
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_7_AR_PF_VEC_MSG_ADDR_SEL_SHIFT 0
+/* Rsrvd */
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_7_RSRVD_MASK 0xFFF00000
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_7_RSRVD_SHIFT 20
+
+/**** func_ctrl_8 register ****/
+/* override value. */
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_8_AR_PF_VEC_MSG_ADDR_OVRD_MASK 0x000FFFFF
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_8_AR_PF_VEC_MSG_ADDR_OVRD_SHIFT 0
+/* Rsrvd */
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_8_RSRVD_MASK 0xFFF00000
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_8_RSRVD_SHIFT 20
+
+/**** func_ctrl_9 register ****/
+/* no snoop override  */
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_9_PF_VEC_NO_SNOOP_OVRD (1 << 0)
+/* no snoop override value  */
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_9_PF_VEC_NO_SNOOP_OVRD_VALUE (1 << 1)
+/* atu bypass override  */
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_9_PF_VEC_ATU_BYPASS_OVRD (1 << 2)
+/* atu bypass override value */
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_9_PF_VEC_ATU_BYPASS_OVRD_VALUE (1 << 3)
+/* Rsrvd */
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_9_RSRVD_MASK 0xFFFFFFF0
+#define PCIE_AXI_PF_AXI_ATTR_OVRD_FUNC_CTRL_9_RSRVD_SHIFT 4
+
+/**** func_ctrl_10 register ****/
+/* choose the field  from the axuser */
+#define PCIE_AXI_REV_4_PF_AXI_ATTR_OVRD_FUNC_CTRL_10_PF_VEC_ATS_VEC_OVRD_FROM_AXUSER_MASK 0x00000003
+#define PCIE_AXI_REV_4_PF_AXI_ATTR_OVRD_FUNC_CTRL_10_PF_VEC_ATS_VEC_OVRD_FROM_AXUSER_SHIFT 0
+/* choose the field  from register */
+#define PCIE_AXI_REV_4_PF_AXI_ATTR_OVRD_FUNC_CTRL_10_PF_VEC_ATS_VEC_OVRD_FROM_REG_MASK 0x0000000C
+#define PCIE_AXI_REV_4_PF_AXI_ATTR_OVRD_FUNC_CTRL_10_PF_VEC_ATS_VEC_OVRD_FROM_REG_SHIFT 2
+/* in case the field take from the address, offset field for each bit. */
+#define PCIE_AXI_REV_4_PF_AXI_ATTR_OVRD_FUNC_CTRL_10_PF_VEC_ATS_VEC_ADDR_OFFSET_MASK 0x00000FF0
+#define PCIE_AXI_REV_4_PF_AXI_ATTR_OVRD_FUNC_CTRL_10_PF_VEC_ATS_VEC_ADDR_OFFSET_SHIFT 4
+/* register value overiide */
+#define PCIE_AXI_REV_4_PF_AXI_ATTR_OVRD_FUNC_CTRL_10_CFG_ATS_VEC_OVRD_MASK 0x00003000
+#define PCIE_AXI_REV_4_PF_AXI_ATTR_OVRD_FUNC_CTRL_10_CFG_ATS_VEC_OVRD_SHIFT 12
+/* Rsrvd */
+#define PCIE_AXI_REV_4_PF_AXI_ATTR_OVRD_FUNC_CTRL_10_RSRVD_14_31_MASK 0xFFFFC000
+#define PCIE_AXI_REV_4_PF_AXI_ATTR_OVRD_FUNC_CTRL_10_RSRVD_14_31_SHIFT 14
+
+/**** config pclk generate ****/
+/* cntr_low */
+/* pcie unit reference clock */
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_UNIT_PCLK_MASK			(0x0000000F)
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_UNIT_PCLK_SHIFT			(0)
+
+/* enable the main clock gate to the pcie clock generation logic */
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_MAIN_CLK_GATE_EN			(1 << 4)
+
+/* set the reset to the pcie clock generation logic */
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_MAIN_INTERNAL_CLK_LOGIC_RST_EN	(1 << 5)
+
+/* enable the gen2 pipe clock divider to the pcie clock generation logic */
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_CLK_GEN2_DIV_EN			(1 << 6)
+/* enable the gen1 pipe clock divider to the pcie clock generation logic */
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_CLK_GEN1_DIV_EN			(1 << 7)
+
+/* gen2 pipe clock divider according to the SB clock */
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_GEN2_MHZ_MASK			(0x00000F00)
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_GEN2_MHZ_SHIFT				(8)
+
+/* gen1 pipe clock divider according to the SB clock */
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_GEN1_MHZ_MASK			(0x0000F000)
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_GEN1_MHZ_SHIFT				(12)
+
+/* set delay in after assert the reset to the clock dividers */
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_RST_DELAY_AFTER_CLK_EN_MASK		(0xFFFF0000)
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_LOW_RST_DELAY_AFTER_CLK_EN_SHIFT	(16)
+
+/* cntr_high */
+/* set the delay before preforming serdes rate change */
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_HIGH_DELAY_BEFORE_RATE_CHANGE_MASK	(0x000000FF)
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_HIGH_DELAY_BEFORE_RATE_CHANGE_SHIFT	(0)
+
+/* set the delay after preforming serdes rate change */
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_HIGH_DELAY_AFTER_RATE_CHANGE_MASK	(0x0000FF00)
+#define PCIE_AXI_CFG_PCLK_GENERATE_CNTR_HIGH_DELAY_AFTER_RATE_CHANGE_SHIFT	(8)
+
+/**** entry_vec register ****/
+/* entry0 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_ENTRY_0_MASK	0x0000001F
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_ENTRY_0_SHIFT	0
+/* entry1 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_ENTRY_1_MASK	0x000003E0
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_ENTRY_1_SHIFT	5
+/* entry2 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_ENTRY_2_MASK	0x00007C00
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_ENTRY_2_SHIFT	10
+/* entry3 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_ENTRY_3_MASK	0x000F8000
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_ENTRY_3_SHIFT	15
+/* atu bypass for message “write” */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_AW_MSG_ATU_BYPASS (1 << 20)
+/* atu bypass for message “read” */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_AR_MSG_ATU_BYPASS (1 << 21)
+/* Rsrvd */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_RSRVD_MASK	0xFFC00000
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_ENTRY_VEC_RSRVD_SHIFT	22
+
+/**** code_entry_vec_0 register ****/
+/* entry0 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_0_ENTRY_0_MASK 0x000000FF
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_0_ENTRY_0_SHIFT 0
+/* entry1 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_0_ENTRY_1_MASK 0x0000FF00
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_0_ENTRY_1_SHIFT 8
+/* entry2 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_0_ENTRY_2_MASK 0x00FF0000
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_0_ENTRY_2_SHIFT 16
+/* entry3 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_0_ENTRY_3_MASK 0xFF000000
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_0_ENTRY_3_SHIFT 24
+
+/**** code_entry_vec_1 register ****/
+/* entry0 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_1_ENTRY_0_MASK 0x000000FF
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_1_ENTRY_0_SHIFT 0
+/* entry1 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_1_ENTRY_1_MASK 0x0000FF00
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_1_ENTRY_1_SHIFT 8
+/* entry2 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_1_ENTRY_2_MASK 0x00FF0000
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_1_ENTRY_2_SHIFT 16
+/* entry3 */
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_1_ENTRY_3_MASK 0xFF000000
+#define PCIE_AXI_MSG_ATTR_AXUSER_TABLE_CODE_ENTRY_VEC_1_ENTRY_3_SHIFT 24
+
+/**** flush register ****/
+/*
+ * determine the value of address[63:48] are used to qualify Write PoS flush on inbound writes
+ * transactions
+ */
+#define PCIE_AXI_MSTR_POS_FLUSH_VALUE_MASK 0x0000FFFF
+#define PCIE_AXI_MSTR_POS_FLUSH_VALUE_SHIFT 0
+/*
+ * determine which bits out of inbound address[63:48] are used to qualify Write PoS flush on inbound
+ * writes transactions.
+ * PoS flushing is enabled only when OrderPos.Control[27] is set
+ */
+#define PCIE_AXI_MSTR_POS_FLUSH_MASK_MASK 0xFFFF0000
+#define PCIE_AXI_MSTR_POS_FLUSH_MASK_SHIFT 16
+
+/**** ctrl0 register ****/
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL0_FORCE_TARGET_PASW			(1 << 0)
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL0_FORCE_TARGET_REG			(1 << 1)
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL0_FORCE_TARGET_DRAM_MASK		0xF0
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL0_FORCE_TARGET_DRAM_SHIFT		4
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL0_FORCE_TARGET_PASW_REG_MASK		0xF00
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL0_FORCE_TARGET_PASW_REG_SHIFT	8
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL0_BDF_TO_SMMU_TGTID_MAP		(1 << 12)
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL0_SELECTED_SMMU_BYPASS_MASK		0x6000
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL0_SELECTED_SMMU_BYPASS_SHIFT		13
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL0_SMMU_BYPASS_OVERRIDE_VAL_MASK	(1 << 15)
+
+/**** ctrl1 register ****/
+/* Bit mask clear of the inbound address[63:48] into the Fabric  */
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL1_AXADDR_CLEAR_MASK 0x0000FFFF
+#define PCIE_AXI_MSTR_ATTR_MAP_CTRL1_AXADDR_CLEAR_SHIFT 0
+
+/**** entry register ****/
+/* table entry */
+#define PCIE_AXI_MSTR_CFGTABLE_ENTRY_VALUE_MASK 0x000FFFFF
+#define PCIE_AXI_MSTR_CFGTABLE_ENTRY_VALUE_SHIFT 0
+
+/**** int_cause_grp_A_axi register ****/
+/*
+ * Master Response Composer Lookup Error
+ * Overflow that occurred in a lookup table of the Outbound responses. This
+ * indicates that there was a violation for the number of outstanding NP
+ * requests issued for the Inbound direction.
+ * Write zero to clear.
+ */
+#define PCIE_AXI_INT_GRP_A_CAUSE_GM_COMPOSER_LOOKUP_ERR (1 << 0)
+/*
+ * Indicates a PARITY ERROR on the master data read channel.
+ * Write zero to clear.
+ */
+#define PCIE_AXI_INT_GRP_A_CAUSE_PARITY_ERR_DATA_PATH_RD (1 << 2)
+/*
+ * Indicates a PARITY ERROR on the slave addr read channel.
+ * Write zero to clear.
+ */
+#define PCIE_AXI_INT_GRP_A_CAUSE_PARITY_ERR_OUT_ADDR_RD (1 << 3)
+/*
+ * Indicates a PARITY ERROR on the slave addr write channel.
+ * Write zero to clear.
+ */
+#define PCIE_AXI_INT_GRP_A_CAUSE_PARITY_ERR_OUT_ADDR_WR (1 << 4)
+/*
+ * Indicates a PARITY ERROR on the slave data write channel.
+ * Write zero to clear.
+ */
+#define PCIE_AXI_INT_GRP_A_CAUSE_PARITY_ERR_OUT_DATA_WR (1 << 5)
+/* Reserved */
+#define PCIE_AXI_INT_GRP_A_CAUSE_RESERVED_6 (1 << 6)
+/*
+ * Software error: ECAM write request with invalid bus number.
+ * Write Zero to clear
+ */
+#define PCIE_AXI_INT_GRP_A_CAUSE_SW_ECAM_ERR_RD (1 << 7)
+/*
+ * Software error: ECAM read request with invalid bus number.
+ * Write Zero to clear.
+ */
+#define PCIE_AXI_INT_GRP_A_CAUSE_SW_ECAM_ERR_WR (1 << 8)
+/* Indicates an ERROR in the PCIe application cause register. */
+#define PCIE_AXI_INT_GRP_A_CAUSE_PCIE_CORE_INT (1 << 9)
+/*
+ * Whenever the Master AXI finishes writing a message, it sets this bit.
+ * Whenever the int is cleared, the message information MSG_* regs are no longer
+ * valid.
+ */
+#define PCIE_AXI_INT_GRP_A_CAUSE_MSTR_AXI_GETOUT_MSG (1 << 10)
+/* Read AXI compilation has ERROR. */
+#define PCIE_AXI_INT_GRP_A_CAUSE_RD_CMPL_ERR (1 << 11)
+/* Write AXI compilation has ERROR. */
+#define PCIE_AXI_INT_GRP_A_CAUSE_WR_CMPL_ERR (1 << 12)
+/* Read AXI compilation has timed out. */
+#define PCIE_AXI_INT_GRP_A_CAUSE_RD_CMPL_TO (1 << 13)
+/* Write AXI compilation has timed out. */
+#define PCIE_AXI_INT_GRP_A_CAUSE_WR_CMPL_TO (1 << 14)
+/* Parity error AXI domain */
+#define PCIE_AXI_INT_GRP_A_CAUSE_PARITY_ERROR_AXI (1 << 15)
+/* POS error interrupt */
+#define PCIE_AXI_INT_GRP_A_CAUSE_POS_AXI_BRESP (1 << 16)
+/* The outstanding write counter become  full should never happen */
+#define PCIE_AXI_INT_GRP_A_CAUSE_WRITE_CNT_FULL_ERR (1 << 17)
+/* BRESP received before the write counter increment.  */
+#define PCIE_AXI_INT_GRP_A_CAUSE_BRESP_BEFORE_WR_CNT_INC_ERR (1 << 18)
+
+/**** int_control_grp_A_axi register ****/
+/* When Clear_on_Read =1, all bits of the Cause register are cleared on read. */
+#define PCIE_AXI_INT_GRP_A_CTRL_CLEAR_ON_READ (1 << 0)
+/*
+ * (Must be set only when MSIX is enabled.)
+ * When Auto-Mask =1 and an MSI-X ACK for this bit is received, its
+ * corresponding bit in the mask register is set, masking future interrupts.
+ */
+#define PCIE_AXI_INT_GRP_A_CTRL_AUTO_MASK (1 << 1)
+/*
+ * Auto_Clear (RW)
+ * When Auto-Clear =1, the bits in the Interrupt Cause register are auto-cleared
+ * after MSI-X is acknowledged. Must be used only if MSI-X is enabled.
+ */
+#define PCIE_AXI_INT_GRP_A_CTRL_AUTO_CLEAR (1 << 2)
+/*
+ * When set,_on_Posedge =1, the bits in the Interrupt Cause register are set on
+ * the posedge of the interrupt source, i.e., when interrupt source =1 and
+ * Interrupt Status = 0.
+ * When set,_on_Posedge =0, the bits in the Interrupt Cause register are set
+ * when interrupt source =1.
+ */
+#define PCIE_AXI_INT_GRP_A_CTRL_SET_ON_POS (1 << 3)
+/*
+ * When Moderation_Reset =1, all Moderation timers associated with the interrupt
+ * cause bits are cleared to 0, enabling immediate interrupt assertion if any
+ * unmasked cause bit is set to 1. This bit is self-negated.
+ */
+#define PCIE_AXI_INT_GRP_A_CTRL_MOD_RST (1 << 4)
+/*
+ * When mask_msi_x =1, no MSI-X from this group is sent. This bit is set to 1
+ * when the associate summary bit in this group is used to generate a single
+ * MSI-X for this group.
+ */
+#define PCIE_AXI_INT_GRP_A_CTRL_MASK_MSI_X (1 << 5)
+/* MSI-X AWID value. Same ID for all cause bits. */
+#define PCIE_AXI_INT_GRP_A_CTRL_AWID_MASK 0x00000F00
+#define PCIE_AXI_INT_GRP_A_CTRL_AWID_SHIFT 8
+/*
+ * This value determines the interval between interrupts. Writing ZERO disables
+ * Moderation.
+ */
+#define PCIE_AXI_INT_GRP_A_CTRL_MOD_INTV_MASK 0x00FF0000
+#define PCIE_AXI_INT_GRP_A_CTRL_MOD_INTV_SHIFT 16
+/*
+ * This value determines the Moderation_Timer_Clock speed.
+ * 0- Moderation-timer is decremented every 1x256 SB clock cycles ~1uS.
+ * 1- Moderation-timer is decremented every 2x256 SB clock cycles ~2uS.
+ * N- Moderation-timer is decremented every Nx256 SB clock cycles ~(N+1) uS.
+ */
+#define PCIE_AXI_INT_GRP_A_CTRL_MOD_RES_MASK 0x0F000000
+#define PCIE_AXI_INT_GRP_A_CTRL_MOD_RES_SHIFT 24
+
+/* internal serdes interrupt lanes 8 to 16 */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CAUSE_GRP_B_AXI_SERDES_INTERRUPT_MASK 0xFFFFFF00
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CAUSE_GRP_B_AXI_SERDES_INTERRUPT_SHIFT 8
+
+/**** int_control_grp_B_axi register ****/
+/* When Clear_on_Read =1, all bits of the Cause register are cleared on read. */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_CLEAR_ON_READ (1 << 0)
+/* (Must be set only when MSIX is enabled.)
+ * When Auto-Mask =1 and an MSI-X ACK for this bit is received, its corresponding
+ * bit in the mask register is set, masking future interrupts.
+ */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_AUTO_MASK (1 << 1)
+/* Auto_Clear (RW)
+ * When Auto-Clear =1, the bits in the Interrupt Cause register are auto-cleared
+ * after MSI-X is acknowledged. Must be used only if MSI-X is enabled.
+ */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_AUTO_CLEAR (1 << 2)
+/* When set,_on_Posedge =1, the bits in the Interrupt Cause register are set on
+ * the posedge of the interrupt source, i.e., when interrupt source =1 and
+ * Interrupt Status = 0.
+ * When set,_on_Posedge =0, the bits in the Interrupt Cause register are set
+ * when interrupt source =1.
+ */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_SET_ON_POS (1 << 3)
+/* When Moderation_Reset =1, all Moderation timers associated with the interrupt
+ * cause bits are cleared to 0, enabling immediate interrupt assertion if any
+ * unmasked cause bit is set to 1. This bit is self-negated.
+ */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_MOD_RST (1 << 4)
+/* When mask_msi_x =1, no MSI-X from this group is sent. This bit is set to 1
+ * when the associate summary bit in this group is used to generate a single
+ * MSI-X for this group.
+ */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_MASK_MSI_X (1 << 5)
+/* MSI-X AWID value. Same ID for all cause bits. */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_AWID_MASK 0x00000F00
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_AWID_SHIFT 8
+/* This value determines the interval between interrupts. Writing ZERO disables
+ * Moderation.
+ */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_MOD_INTV_MASK 0x00FF0000
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_MOD_INTV_SHIFT 16
+/* This value determines the Moderation_Timer_Clock speed.
+ * 0- Moderation-timer is decremented every 1x256 SB clock cycles ~1uS.
+ * 1- Moderation-timer is decremented every 2x256 SB clock cycles ~2uS.
+ * N- Moderation-timer is decremented every Nx256 SB clock cycles ~(N+1) uS.
+ */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_MOD_RES_MASK 0x0F000000
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_MOD_RES_SHIFT 24
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __AL_HAL_pcie_axi_REG_H */
+
+/** @} end of ... group */
