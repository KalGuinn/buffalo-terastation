+#define NB_V1_V2_GLOBAL_CPUS_INIT_CONTROL_CPUS_INITDONE_MASK 0x0000000F
+#define NB_V1_V2_GLOBAL_CPUS_INIT_CONTROL_CPUS_INITDONE_SHIFT 0
