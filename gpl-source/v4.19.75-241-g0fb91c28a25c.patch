+static al_mod_bool al_mod_serdes_lane_ready(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane	lane)
+{
+	uint8_t rx_ready_reg, tx_ready_reg;
+
+	al_mod_serdes_reg_read(obj, (enum al_mod_serdes_reg_page)lane, AL_SRDS_REG_TYPE_PMA,
+			   SERDES_IREG_PCS_OUT_RX_READY_REG_NUM, &rx_ready_reg);
+
+	al_mod_serdes_reg_read(obj, (enum al_mod_serdes_reg_page)lane, AL_SRDS_REG_TYPE_PMA,
+			   SERDES_IREG_PCS_OUT_TX_READY_REG_NUM, &tx_ready_reg);
+
+	return ((rx_ready_reg & SERDES_IREG_PCS_OUT_RX_READY) == SERDES_IREG_PCS_OUT_RX_READY) &&
+	       ((tx_ready_reg & SERDES_IREG_PCS_OUT_TX_READY) == SERDES_IREG_PCS_OUT_TX_READY);
+}
