+	int			row,
+	int			num_bytes,
+	int			ecc_enabled,
+	uint32_t		*cmd_seq_buff,
+	int			*cmd_seq_buff_num_entries,
+	uint32_t		*cw_size,
+	uint32_t		*cw_count);
