+
+		switch (lane) {
+		case AL_ETH_AN__LT_LANE_0:
+			al_mod_reg_write32(&adapter->mac_regs_base->gen_v3.an_lt_0_addr,
+				       (uintptr_t)&regs->an_lt[adapter->curr_lt_unit].addr);
