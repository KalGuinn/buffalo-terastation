+ */
+#define AL_PCIE_REV_ID_1			1
+#define AL_PCIE_REV_ID_2			2
+#define AL_PCIE_REV_ID_3			3
+#define AL_PCIE_REV_ID_4			4
+#define AL_PCIE_REV_ID_5			5
+#define AL_PCIE_REV_ID_MAX			AL_PCIE_REV_ID_5
+
