+/******************************************************************************/
+/******************************************************************************/
+static inline uint8_t al_mod_serdes_grp_reg_read(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_reg_page		page,
+	enum al_mod_serdes_reg_type		type,
+	uint16_t			offset)
+{
+	struct al_mod_serdes_regs __iomem	*regs_base = obj->regs_base;
+
+	al_mod_reg_write32(
+		&regs_base->gen.reg_addr,
+		SRDS_CORE_REG_ADDR(page, type, offset));
+
+	return al_mod_reg_read32(&regs_base->gen.reg_data);
+}
+
+/******************************************************************************/
+/******************************************************************************/
+static inline void al_mod_serdes_grp_reg_write(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_reg_page		page,
+	enum al_mod_serdes_reg_type		type,
+	uint16_t			offset,
+	uint8_t				data)
+{
+	struct al_mod_serdes_regs __iomem	*regs_base = obj->regs_base;
+
+	al_mod_reg_write32(
+		&regs_base->gen.reg_addr,
+		SRDS_CORE_REG_ADDR(page, type, offset));
+
+	al_mod_reg_write32(&regs_base->gen.reg_data, data);
+}
+
+/******************************************************************************/
+/******************************************************************************/
+static inline void al_mod_serdes_ns_delay(int cnt)
+{
+	al_mod_udelay((cnt + 999) / 1000);
+}
+
+/******************************************************************************/
+/******************************************************************************/
+static inline void al_mod_serdes_grp_reg_masked_write(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_reg_page		page,
+	enum al_mod_serdes_reg_type		type,
+	uint16_t			offset,
+	uint8_t				mask,
+	uint8_t				data)
+{
+	uint8_t val;
+	enum al_mod_serdes_reg_page	start_page = page;
+	enum al_mod_serdes_reg_page	end_page   = page;
+	enum al_mod_serdes_reg_page	iter_page;
+
+	if (page == AL_SRDS_REG_PAGE_0123_LANES_0123) {
+		start_page = AL_SRDS_REG_PAGE_0_LANE_0;
+		end_page   = AL_SRDS_REG_PAGE_3_LANE_3;
+	}
+
+	for (iter_page = start_page; iter_page <= end_page; ++iter_page) {
+		val = al_mod_serdes_grp_reg_read(obj, iter_page, type, offset);
+		val &= ~mask;
+		val |= data;
+		al_mod_serdes_grp_reg_write(obj, iter_page, type, offset, val);
+	}
+}
+
+/******************************************************************************/
+/******************************************************************************/
+static void _al_serdes_lane_rx_rate_change_sw_flow_dis(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	al_mod_bool lane_sw_flow_enabled;
+
+	al_mod_assert(lane != AL_SRDS_LANES_0123);
+
+	lane_sw_flow_enabled =
+		(al_mod_serdes_grp_reg_read(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 201) == 0xfc) &&
+		(al_mod_serdes_grp_reg_read(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 202) == 0xff) &&
+		(al_mod_serdes_grp_reg_read(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 203) == 0xff) &&
+		(al_mod_serdes_grp_reg_read(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 204) == 0xff) &&
+		(al_mod_serdes_grp_reg_read(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 205) == 0xff);
+
+	/**
+	 * Disable the Rx rate change software flow by clearing bit 7 of lane PMA register 205
+	 * (RSTPDOVR_RX_OVREN)
+	 */
+	if (lane_sw_flow_enabled) {
+		al_mod_dbg("%s(%d): actually disabling\n", __func__, lane);
+		al_mod_serdes_grp_reg_masked_write(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 205, 0x80, 0x00);
+	}
+}
+
+/******************************************************************************/
+/******************************************************************************/
+static void al_mod_serdes_group_rx_rate_change_sw_flow_dis(
+	struct al_mod_serdes_grp_obj	*obj)
+{
+	int lane;
+
+	for (lane = AL_SRDS_LANE_0; lane < AL_SRDS_NUM_LANES; lane++)
+		_al_serdes_lane_rx_rate_change_sw_flow_dis(obj, lane);
+}
+
+/******************************************************************************/
+/******************************************************************************/
+static void _al_serdes_lane_rx_rate_change_sw_flow_en_cond(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_lane		lane)
+{
+	al_mod_bool lane_sw_flow_almost_enabled;
+	al_mod_bool group_reset_enabled;
+	al_mod_bool lane_reset_enabled;
+	al_mod_bool group_pd_enabled;
+	al_mod_bool lane_pd_enabled;
+
+	al_mod_assert(lane != AL_SRDS_LANES_0123);
+
+	lane_sw_flow_almost_enabled =
+		(al_mod_serdes_grp_reg_read(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 201) == 0xfc) &&
+		(al_mod_serdes_grp_reg_read(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 202) == 0xff) &&
+		(al_mod_serdes_grp_reg_read(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 203) == 0xff) &&
+		(al_mod_serdes_grp_reg_read(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 204) == 0xff) &&
+		(al_mod_serdes_grp_reg_read(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 205) == 0x7f);
+
+	group_reset_enabled =
+		((al_mod_serdes_grp_reg_read(
+			obj, AL_SRDS_REG_PAGE_4_COMMON, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASSEN_SYNTH_REG_NUM) &
+		SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASSEN_SYNTH_MASK) ==
+		SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASSEN_SYNTH_VAL_REGS) &&
+		((al_mod_serdes_grp_reg_read(
+			obj, AL_SRDS_REG_PAGE_4_COMMON, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASS_SYNTH_REG_NUM) &
+			SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASS_SYNTH_MASK) ==
+		SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASS_SYNTH_VAL_ASSERT);
+
+	lane_reset_enabled =
+		((al_mod_serdes_grp_reg_read(
+			obj, (enum al_mod_serdes_reg_page)lane, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASSEN_REG_NUM) &
+		SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASSEN_MASK) ==
+		SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASSEN_VAL_REGS) &&
+		((al_mod_serdes_grp_reg_read(
+			obj, (enum al_mod_serdes_reg_page)lane, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASS_REG_NUM) &
+			SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASS_MASK) ==
+		SERDES_IREG_FLD_CMNCTLPOR_HARDRSTBYPASS_VAL_ASSERT);
+
+	group_pd_enabled =
+		(al_mod_serdes_grp_reg_read(
+			obj, AL_SRDS_REG_PAGE_4_COMMON, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_CMNPCSPSTATE_SYNTH_REG_NUM) &
+		SERDES_IREG_FLD_CMNPCSPSTATE_SYNTH_MASK) ==
+		SERDES_IREG_FLD_CMNPCSPSTATE_SYNTH_VAL_PD;
+
+	lane_pd_enabled =
+		(al_mod_serdes_grp_reg_read(
+			obj, (enum al_mod_serdes_reg_page)lane, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_LANEPCSPSTATE_RX_REG_NUM) &
+		SERDES_IREG_FLD_LANEPCSPSTATE_RX_MASK) ==
+		SERDES_IREG_FLD_LANEPCSPSTATE_RX_VAL_PD;
+
+	/**
+	 * Enable the Rx rate change software flow by setting bit 7 of lane PMA register 205
+	 * (RSTPDOVR_RX_OVREN)
+	 */
+	if (lane_sw_flow_almost_enabled && !group_reset_enabled && !lane_reset_enabled &&
+		!group_pd_enabled && !lane_pd_enabled) {
+		al_mod_dbg("%s(%d): actually enabling\n", __func__, lane);
+
+		al_mod_serdes_ns_delay(500);
+		al_mod_serdes_grp_reg_masked_write(obj, (enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA, 205, 0x80, 0x80);
+	}
+}
+
+/******************************************************************************/
+/******************************************************************************/
+static void al_mod_serdes_group_rx_rate_change_sw_flow_en_cond(
+	struct al_mod_serdes_grp_obj	*obj)
+{
+	int lane;
+
+	for (lane = AL_SRDS_LANE_0; lane < AL_SRDS_NUM_LANES; lane++)
+		_al_serdes_lane_rx_rate_change_sw_flow_en_cond(obj, lane);
+}
+
+/******************************************************************************/
+/******************************************************************************/
+static int al_mod_serdes_eye_measure_run(
+		struct al_mod_serdes_grp_obj	*obj,
+		enum al_mod_serdes_lane		lane,
+		uint32_t			timeout,
+		unsigned int			*value)
+{
+	struct al_mod_serdes_grp_obj	*grp_obj = obj;
+	struct al_mod_serdes_regs __iomem	*regs_base = grp_obj->regs_base;
+	uint32_t reg = 0;
+	uint32_t i;
+	struct serdes_lane *lane_regs;
+
+	lane_regs = &regs_base->lane[lane];
+
+	al_mod_reg_write32(&lane_regs->ictl_multi_rxeq,
+		       SERDES_LANE_ICTL_MULTI_RXEQ_START_L_A);
+
+	for (i = 0; i < timeout; i++) {
+		reg = al_mod_reg_read32(&lane_regs->octl_multi);
+
+		if (reg & SERDES_LANE_OCTL_MULTI_RXEQ_DONE_L_A)
+			break;
+
+		AL_SERDES_HSSP_MSLEEP(10);
+	}
+
+	if (i == timeout) {
+		al_mod_err("%s: measure eye failed on timeout\n", __func__);
+		return -ETIMEDOUT;
+	}
+
+	*value = al_mod_reg_read32(&lane_regs->odat_multi_rxeq);
+
+	al_mod_reg_write32(&lane_regs->ictl_multi_rxeq, 0);
+
+	return 0;
+}
+
+/******************************************************************************/
+/******************************************************************************/
+static int al_mod_serdes_eye_diag_pre_sample(
+		struct al_mod_serdes_grp_obj *obj,
+		enum al_mod_serdes_lane	lane,
+		unsigned int *sample_count,
+		unsigned int *rxcal_mask)
+{
+	enum al_mod_serdes_reg_page	page = (enum al_mod_serdes_reg_page)lane;
+	uint8_t sample_count_orig_msb;
+	uint8_t sample_count_orig_lsb;
+
+	al_mod_assert(obj);
+	al_mod_assert(((int)page) >= AL_SRDS_REG_PAGE_0_LANE_0);
+	al_mod_assert(((int)page) <= AL_SRDS_REG_PAGE_0123_LANES_0123);
+
+
+	/* Obtain sample count by reading RXCALROAMEYEMEAS_COUNT */
+	sample_count_orig_msb = al_mod_serdes_grp_reg_read(obj,
+		AL_SRDS_REG_PAGE_4_COMMON, AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_EYE_DIAG_SAMPLE_CNT_MSB_REG_NUM);
+	sample_count_orig_lsb = al_mod_serdes_grp_reg_read(obj,
+		AL_SRDS_REG_PAGE_4_COMMON, AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_EYE_DIAG_SAMPLE_CNT_LSB_REG_NUM);
+
+	*sample_count = ((uint32_t)sample_count_orig_msb) << 8 |
+			sample_count_orig_lsb;
+
+	/* Set sample count to ~100000 samples */
+	al_mod_serdes_grp_reg_write(obj, AL_SRDS_REG_PAGE_4_COMMON,
+		AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_EYE_DIAG_SAMPLE_CNT_MSB_REG_NUM, 0x13);
+	al_mod_serdes_grp_reg_write(obj, AL_SRDS_REG_PAGE_4_COMMON,
+		AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_EYE_DIAG_SAMPLE_CNT_LSB_REG_NUM, 0x88);
+
+	/* BER Contour Overwrite */
+	al_mod_serdes_grp_reg_masked_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_RXCALROAMEYEMEASIN_LOCWREN_REG_NUM,
+		SERDES_IREG_FLD_RXCALROAMEYEMEASIN_LOCWREN,
+		0);
+	al_mod_serdes_grp_reg_masked_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_RXCALROAMXADJUST_LOCWREN_REG_NUM,
+		SERDES_IREG_FLD_RXCALROAMXADJUST_LOCWREN,
+		0);
+	al_mod_serdes_grp_reg_masked_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_RXCALROAMYADJUST_LOCWREN_REG_NUM,
+		SERDES_IREG_FLD_RXCALROAMYADJUST_LOCWREN,
+		0);
+
+	/* RXROAM_XORBITSEL = 0x1 or 0x0 */
+	al_mod_serdes_grp_reg_masked_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_RXROAM_XORBITSEL_REG_NUM,
+		SERDES_IREG_FLD_RXROAM_XORBITSEL,
+		SERDES_IREG_FLD_RXROAM_XORBITSEL_2ND);
+
+	if (rxcal_mask)
+		*rxcal_mask = al_mod_serdes_grp_reg_read(obj, page, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RXCALROAMEYEMEASIN_CYCLEEN_REG_NUM);
+
+	return 0;
+}
+
+static int al_mod_serdes_eye_diag_start_sample(
+		struct al_mod_serdes_grp_obj *obj,
+		enum al_mod_serdes_lane	lane,
+		unsigned int *rxcal_mask,
+		int x,
+		int y)
+{
+	enum al_mod_serdes_reg_page	page = (enum al_mod_serdes_reg_page)lane;
+
+	al_mod_assert(obj);
+	al_mod_assert(((int)page) >= AL_SRDS_REG_PAGE_0_LANE_0);
+	al_mod_assert(((int)page) <= AL_SRDS_REG_PAGE_0123_LANES_0123);
+
+	/* Set X */
+	if (x > 0)
+		al_mod_serdes_grp_reg_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RXCALROAMXADJUST_REG_NUM, x);
+
+	/* Set Y */
+	if (y > 0)
+		al_mod_serdes_grp_reg_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RXCALROAMYADJUST_REG_NUM,
+			y < 32 ? 31 - y : y + 1);
+
+	/* Start Measurement by setting RXCALROAMEYEMEASIN_CYCLEEN = 0x1 */
+	if (rxcal_mask)
+		/* use provided mask to save read time (of read-modify-write) */
+		al_mod_serdes_grp_reg_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RXCALROAMEYEMEASIN_CYCLEEN_REG_NUM,
+			SERDES_IREG_FLD_RXCALROAMEYEMEASIN_CYCLEEN_START | *rxcal_mask);
+	else
+		al_mod_serdes_grp_reg_masked_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RXCALROAMEYEMEASIN_CYCLEEN_REG_NUM,
+			SERDES_IREG_FLD_RXCALROAMEYEMEASIN_CYCLEEN_START,
+			SERDES_IREG_FLD_RXCALROAMEYEMEASIN_CYCLEEN_START);
+
+	return 0;
+}
+
+static int al_mod_serdes_eye_diag_poll_sample(
+		struct al_mod_serdes_grp_obj *obj,
+		enum al_mod_serdes_lane lane)
+{
+	enum al_mod_serdes_reg_page	page = (enum al_mod_serdes_reg_page)lane;
+	int is_ready;
+
+	al_mod_assert(obj);
+	al_mod_assert(((int)page) >= AL_SRDS_REG_PAGE_0_LANE_0);
+	al_mod_assert(((int)page) <= AL_SRDS_REG_PAGE_0123_LANES_0123);
+
+	/* Check RXCALROAMEYEMEASDONE Signal */
+	is_ready = al_mod_serdes_grp_reg_read(obj, page, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RXCALROAMEYEMEASDONE_REG_NUM) &
+			SERDES_IREG_FLD_RXCALROAMEYEMEASDONE;
+
+	return is_ready ? 1 : 0;
+}
+
+static int al_mod_serdes_eye_diag_stop_sample(
+		struct al_mod_serdes_grp_obj *obj,
+		enum al_mod_serdes_lane lane,
+		unsigned int *rxcal_mask,
+		unsigned int *value)
+{
+	enum al_mod_serdes_reg_page	page = (enum al_mod_serdes_reg_page)lane;
+
+	al_mod_assert(obj);
+	al_mod_assert(((int)page) >= AL_SRDS_REG_PAGE_0_LANE_0);
+	al_mod_assert(((int)page) <= AL_SRDS_REG_PAGE_0123_LANES_0123);
+	al_mod_assert(value);
+
+	/* Stop Measurement by setting RXCALROAMEYEMEASIN_CYCLEEN = 0x0 */
+	if (rxcal_mask)
+		/* use provided mask to save read time (of read-modify-write) */
+		al_mod_serdes_grp_reg_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RXCALROAMEYEMEASIN_CYCLEEN_REG_NUM,
+			~SERDES_IREG_FLD_RXCALROAMEYEMEASIN_CYCLEEN_START & *rxcal_mask);
+	else
+		al_mod_serdes_grp_reg_masked_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RXCALROAMEYEMEASIN_CYCLEEN_REG_NUM,
+			SERDES_IREG_FLD_RXCALROAMEYEMEASIN_CYCLEEN_START,
+			0);
+
+	/* Obtain Error Counts by reading RXCALROAMEYEMEAS_ACC */
+	*value = ((unsigned int)al_mod_serdes_grp_reg_read(obj, page,
+		AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_RXCALROAMEYEMEAS_ACC_MSB_REG_NUM)) << 8 |
+		al_mod_serdes_grp_reg_read(obj, page, AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_RXCALROAMEYEMEAS_ACC_LSB_REG_NUM);
+
+	return 0;
+}
+
+static int al_mod_serdes_eye_diag_post_sample(
+		struct al_mod_serdes_grp_obj *obj,
+		enum al_mod_serdes_lane lane,
+		unsigned int sample_count)
+{
+	enum al_mod_serdes_reg_page	page = (enum al_mod_serdes_reg_page)lane;
+	uint8_t sample_count_orig_msb;
+	uint8_t sample_count_orig_lsb;
+
+	al_mod_assert(obj);
+	al_mod_assert(((int)page) >= AL_SRDS_REG_PAGE_0_LANE_0);
+	al_mod_assert(((int)page) <= AL_SRDS_REG_PAGE_0123_LANES_0123);
+
+	/* BER Contour Overwrite */
+	al_mod_serdes_grp_reg_masked_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_RXCALROAMEYEMEASIN_LOCWREN_REG_NUM,
+		SERDES_IREG_FLD_RXCALROAMEYEMEASIN_LOCWREN,
+		SERDES_IREG_FLD_RXCALROAMEYEMEASIN_LOCWREN);
+	al_mod_serdes_grp_reg_masked_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_RXCALROAMXADJUST_LOCWREN_REG_NUM,
+		SERDES_IREG_FLD_RXCALROAMXADJUST_LOCWREN,
+		SERDES_IREG_FLD_RXCALROAMXADJUST_LOCWREN);
+	al_mod_serdes_grp_reg_masked_write(obj, page, AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_RXCALROAMYADJUST_LOCWREN_REG_NUM,
+		SERDES_IREG_FLD_RXCALROAMYADJUST_LOCWREN,
+		SERDES_IREG_FLD_RXCALROAMYADJUST_LOCWREN);
+
+	/* Restore sample count */
+	sample_count_orig_msb = (uint8_t)(sample_count >> 8);
+	sample_count_orig_lsb = (uint8_t)sample_count;
+
+	al_mod_serdes_grp_reg_write(obj, AL_SRDS_REG_PAGE_4_COMMON,
+		AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_EYE_DIAG_SAMPLE_CNT_MSB_REG_NUM,
+		sample_count_orig_msb);
+	al_mod_serdes_grp_reg_write(obj, AL_SRDS_REG_PAGE_4_COMMON,
+		AL_SRDS_REG_TYPE_PMA,
+		SERDES_IREG_FLD_EYE_DIAG_SAMPLE_CNT_LSB_REG_NUM,
+		sample_count_orig_lsb);
+
+	return 0;
+}
+
+static int al_mod_serdes_eye_diag_sample(
+		struct al_mod_serdes_grp_obj	*obj,
+		enum al_mod_serdes_lane		lane,
+		unsigned int			x,
+		int				y,
+		unsigned int			timeout,
+		unsigned int			*value)
+{
+	enum al_mod_serdes_reg_page	page = (enum al_mod_serdes_reg_page)lane;
+	uint32_t i;
+	unsigned int sample_count;
+
+	al_mod_assert(obj);
+	al_mod_assert(((int)page) >= AL_SRDS_REG_PAGE_0_LANE_0);
+	al_mod_assert(((int)page) <= AL_SRDS_REG_PAGE_0123_LANES_0123);
+	al_mod_assert(value);
+
+	al_mod_serdes_eye_diag_pre_sample(obj, lane, &sample_count, NULL);
+	al_mod_serdes_eye_diag_start_sample(obj, lane, NULL, x, y);
+	/* Polling until ready */
+	for (i = 0; i < timeout; i++) {
+		if (al_mod_serdes_eye_diag_poll_sample(obj, lane))
+			break;
+		AL_SERDES_HSSP_UDELAY(1);
+	}
+	if (i == timeout) {
+		al_mod_err("%s: eye diagram sampling timed out!\n", __func__);
+		return -ETIMEDOUT;
+	}
+	/* TBD - this is the original location, should we move it before timeout check? */
+	al_mod_serdes_eye_diag_stop_sample(obj, lane, NULL, value);
+	al_mod_serdes_eye_diag_post_sample(obj, lane, sample_count);
+
+	return 0;
+}
+
+/******************************************************************************/
+/******************************************************************************/
+static void al_mod_serdes_tx_deemph_set(
+		struct al_mod_serdes_grp_obj	*obj,
+		enum al_mod_serdes_lane		lane,
+		uint32_t			c_zero,
+		uint32_t			c_plus_1,
+		uint32_t			c_minus_1)
+{
+	al_mod_serdes_grp_reg_masked_write(
+			obj,
+			(enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_TX_DRV_1_REG_NUM,
+			SERDES_IREG_TX_DRV_1_LEVN_MASK,
+			((c_zero + c_plus_1 + c_minus_1)
+				<< SERDES_IREG_TX_DRV_1_LEVN_SHIFT));
+
+	al_mod_serdes_grp_reg_masked_write(
+			obj,
+			(enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_TX_DRV_2_REG_NUM,
+			SERDES_IREG_TX_DRV_2_LEVNM1_MASK,
+			(c_plus_1 << SERDES_IREG_TX_DRV_2_LEVNM1_SHIFT));
+
+	al_mod_serdes_grp_reg_masked_write(
+			obj,
+			(enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_TX_DRV_3_REG_NUM,
+			SERDES_IREG_TX_DRV_3_LEVNP1_MASK,
+			(c_minus_1 << SERDES_IREG_TX_DRV_3_LEVNP1_SHIFT));
+}
+
+static void al_mod_serdes_tx_deemph_get(
+		struct al_mod_serdes_grp_obj	*obj,
+		enum al_mod_serdes_lane		lane,
+		uint32_t			*c_zero,
+		uint32_t			*c_plus_1,
+		uint32_t			*c_minus_1)
+{
+	uint32_t reg = 0;
+
+	reg = al_mod_serdes_grp_reg_read(
+			obj,
+			(enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_TX_DRV_2_REG_NUM);
+
+	*c_plus_1 = ((reg & SERDES_IREG_TX_DRV_2_LEVNM1_MASK) >>
+					SERDES_IREG_TX_DRV_2_LEVNM1_SHIFT);
+
+	reg = al_mod_serdes_grp_reg_read(
+			obj,
+			(enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_TX_DRV_3_REG_NUM);
+
+	*c_minus_1 = ((reg & SERDES_IREG_TX_DRV_3_LEVNP1_MASK) >>
+					SERDES_IREG_TX_DRV_3_LEVNP1_SHIFT);
+
+	reg = al_mod_serdes_grp_reg_read(
+			obj,
+			(enum al_mod_serdes_reg_page)lane,
+			AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_TX_DRV_1_REG_NUM);
+
+	*c_zero = (((reg & SERDES_IREG_TX_DRV_1_LEVN_MASK) >>
+		SERDES_IREG_TX_DRV_1_LEVN_SHIFT) - *c_plus_1 - *c_minus_1);
+}
+
+static al_mod_bool al_mod_serdes_tx_deemph_inc(
+		struct al_mod_serdes_grp_obj	*obj,
+		enum al_mod_serdes_lane		lane,
+		enum al_mod_serdes_tx_deemph_param	param)
+{
+	al_mod_bool ret = AL_TRUE;
+	uint32_t c0;
+	uint32_t c1;
+	uint32_t c_1;
+
+	al_mod_serdes_tx_deemph_get(obj, lane, &c0, &c1, &c_1);
+
+	al_mod_dbg("%s: current txdeemph: c0 = 0x%x c1 = 0x%x c-1 = 0x%x\n",
+		__func__, c0, c1, c_1);
+
+	switch (param) {
+	case AL_SERDES_TX_DEEMP_C_ZERO:
+
+		if (c0 == AL_SERDES_TX_DEEMPH_C_ZERO_MAX_VAL)
+			return AL_FALSE;
+
+		c0++;
+
+		break;
+	case AL_SERDES_TX_DEEMP_C_PLUS:
+
+		if (c1 == AL_SERDES_TX_DEEMPH_C_PLUS_MAX_VAL)
+			return AL_FALSE;
+
+		c1++;
+
+		break;
+	case AL_SERDES_TX_DEEMP_C_MINUS:
+
+		if (c_1 == AL_SERDES_TX_DEEMPH_C_MINUS_MAX_VAL)
+			return AL_FALSE;
+
+		c_1++;
+
+		break;
+	}
+
+	if ((c0 + c1 + c_1) > AL_SERDES_TX_DEEMPH_SUM_MAX) {
+		al_mod_dbg("%s: sum of all tx de-emphasis over the max limit\n",
+			__func__);
+
+		return AL_FALSE;
+	}
+
+	al_mod_dbg("%s: new txdeemph: c0 = 0x%x c1 = 0x%x c-1 = 0x%x\n",
+		__func__, c0, c1, c_1);
+
+	al_mod_serdes_tx_deemph_set(obj, lane, c0, c1, c_1);
+
+	return ret;
+}
+
+static al_mod_bool al_mod_serdes_tx_deemph_dec(
+		struct al_mod_serdes_grp_obj	*obj,
+		enum al_mod_serdes_lane		lane,
+		enum al_mod_serdes_tx_deemph_param	param)
+{
+	al_mod_bool ret = AL_TRUE;
+	uint32_t c0;
+	uint32_t c1;
+	uint32_t c_1;
+
+	al_mod_serdes_tx_deemph_get(obj, lane, &c0, &c1, &c_1);
+
+	al_mod_dbg("%s: current txdeemph: c0 = 0x%x c1 = 0x%x c-1 = 0x%x\n",
+		__func__, c0, c1, c_1);
+
+	switch (param) {
+	case AL_SERDES_TX_DEEMP_C_ZERO:
+
+		if (c0 == AL_SERDES_TX_DEEMPH_C_ZERO_MIN_VAL)
+			return AL_FALSE;
+
+		c0--;
+
+		break;
+	case AL_SERDES_TX_DEEMP_C_PLUS:
+
+		if (c1 == AL_SERDES_TX_DEEMPH_C_PLUS_MIN_VAL)
+			return AL_FALSE;
+
+		c1--;
+
+		break;
+	case AL_SERDES_TX_DEEMP_C_MINUS:
+
+		if (c_1 == AL_SERDES_TX_DEEMPH_C_MINUS_MIN_VAL)
+			return AL_FALSE;
+
+		c_1--;
+
+		break;
+	}
+
+	al_mod_dbg("%s: new txdeemph: c0 = 0x%x c1 = 0x%x c-1 = 0x%x\n",
+		__func__, c0, c1, c_1);
+
+	al_mod_serdes_tx_deemph_set(obj, lane, c0, c1, c_1);
+
+	return ret;
+}
