+void al_mod_udma_ring_print(struct al_mod_udma *udma, uint32_t qid,
+		enum al_mod_udma_ring_type rtype)
+{
+	struct al_mod_udma_q *queue;
+	uint32_t desc_size;
+	uint8_t *base_ptr;
+	uint32_t i;
+
+	if (!udma)
+		return;
+
+	if (qid >= udma->num_of_queues)
+		return;
+
+	queue = &udma->udma_q[qid];
+	if (rtype == AL_RING_SUBMISSION) {
+		base_ptr = (uint8_t *)queue->desc_base_ptr;
+		desc_size = sizeof(union al_mod_udma_desc);
+		if (base_ptr)
+			al_mod_dbg("Q[%d] submission ring pointers:\n", qid);
+		else {
+			al_mod_dbg("Q[%d] submission ring is not allocated\n", qid);
+			return;
+		}
+	} else {
+		base_ptr = (uint8_t *)queue->cdesc_base_ptr;
+		desc_size = queue->cdesc_size;
+		if (base_ptr)
+			al_mod_dbg("Q[%d] completion ring pointers:\n", qid);
+		else {
+			al_mod_dbg("Q[%d] completion ring is not allocated\n", qid);
+			return;
+		}
+	}
+
+	for (i = 0; i < queue->size; i++) {
+		uint32_t *curr_addr = (uint32_t *)(base_ptr + i * desc_size);
+		if (desc_size == 16)
+			al_mod_dbg("[%04d](%p): %08x %08x %08x %08x\n",
+					i,
+					curr_addr,
+					(uint32_t)*curr_addr,
+					(uint32_t)*(curr_addr+1),
+					(uint32_t)*(curr_addr+2),
+					(uint32_t)*(curr_addr+3));
+		else if (desc_size == 8)
+			al_mod_dbg("[%04d](%p): %08x %08x\n",
+					i,
+					curr_addr,
+					(uint32_t)*curr_addr,
+					(uint32_t)*(curr_addr+1));
+		else if (desc_size == 4)
+			al_mod_dbg("[%04d](%p): %08x\n",
+					i,
+					curr_addr,
+					(uint32_t)*curr_addr);
+		else
+			break;
+	}
+}
+
+void al_mod_udma_ring_descs_around_comp_print(struct al_mod_udma *udma, uint32_t qid,
+					  enum al_mod_udma_ring_type rtype,
+					  unsigned int num_of_descs_pre_comp_head)
+{
+	struct al_mod_udma_q *queue;
+	uint32_t desc_size;
+	uint8_t *base_ptr;
+	uint32_t i;
+	uint32_t crhp;
+	uint32_t drtp;
+	unsigned int pre_next_to_complete_num;
+	unsigned int pre_next_to_complete_idx;
+	unsigned int num_of_descs_to_print;
+	unsigned int end_idx;
+
+	al_mod_assert(udma);
+	al_mod_assert(qid < udma->num_of_queues);
+
+	queue = &udma->udma_q[qid];
+	if (rtype == AL_RING_SUBMISSION) {
+		base_ptr = (uint8_t *)queue->desc_base_ptr;
+		desc_size = sizeof(union al_mod_udma_desc);
+		if (base_ptr)
+			al_mod_info("Q[%d] submission ring around comp head pointers:\n", qid);
+		else {
+			al_mod_warn("Q[%d] submission ring is not allocated\n", qid);
+			return;
+		}
+	} else {
+		base_ptr = (uint8_t *)queue->cdesc_base_ptr;
+		desc_size = queue->cdesc_size;
+		if (base_ptr)
+			al_mod_info("Q[%d] completion ring pre comp header pointers:\n", qid);
+		else {
+			al_mod_warn("Q[%d] completion ring is not allocated\n", qid);
+			return;
+		}
+	}
+
+	al_mod_info("desc_size: %d\n", desc_size);
+	al_mod_assert((desc_size == 16) || (desc_size == 8) || (desc_size == 4));
+
+	crhp = al_mod_reg_read32(&queue->q_regs->rings.crhp);
+	pre_next_to_complete_num = al_mod_min_t(typeof(queue->size - 1), queue->size - 1,
+					    num_of_descs_pre_comp_head);
+	pre_next_to_complete_idx = (crhp - pre_next_to_complete_num)
+				   & queue->size_mask;
+
+	if (rtype == AL_RING_SUBMISSION) {
+		drtp = al_mod_reg_read32(&queue->q_regs->rings.drhp);
+		num_of_descs_to_print = (drtp - pre_next_to_complete_idx) & queue->size_mask;
+		al_mod_info("drtp: 0x%08x\n", drtp);
+	} else {
+		num_of_descs_to_print = pre_next_to_complete_num + 1;
+	}
+
+	al_mod_info("crhp: 0x%08x\n", crhp);
+	al_mod_info("ring_size: 0x%08x\n", queue->size);
+
+	end_idx = pre_next_to_complete_idx + num_of_descs_to_print;
+	for (i = pre_next_to_complete_idx; i <= end_idx; i++) {
+		uint32_t *curr_addr = (uint32_t *)(base_ptr + (i & queue->size_mask) * desc_size);
+
+		if (desc_size == 16)
+			al_mod_info("[%04d](%p): %08x %08x %08x %08x\n",
+					(i & queue->size_mask),
+					curr_addr,
+					(uint32_t)*curr_addr,
+					(uint32_t)*(curr_addr+1),
+					(uint32_t)*(curr_addr+2),
+					(uint32_t)*(curr_addr+3));
+		else if (desc_size == 8)
+			al_mod_info("[%04d](%p): %08x %08x\n",
+					(i & queue->size_mask),
+					curr_addr,
+					(uint32_t)*curr_addr,
+					(uint32_t)*(curr_addr+1));
+		else if (desc_size == 4)
+			al_mod_info("[%04d](%p): %08x\n",
+					(i & queue->size_mask),
+					curr_addr,
+					(uint32_t)*curr_addr);
+	}
+}
