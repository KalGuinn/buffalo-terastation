+/**
+ *  @{
+ * @file   al_hal_eth_mac_v1_v2.c
+ *
+ * @brief  Ethernet MAC v1 / v2 HAL
+ *
+ */
+
+#include "al_hal_eth.h"
+#include "al_hal_eth_mac.h"
+#include "al_hal_eth_mac_internal.h"
+#include "al_hal_eth_mac_regs.h"
+#include "al_hal_eth_mac_config_defs.h"
+
+/* Number of xfi_txclk cycles that accumulate into 100ns */
+#define ETH_MAC_KR_10_PCS_CFG_EEE_TIMER_VAL 52
+
+static int mac_mode_set(struct al_eth_mac_obj *obj, enum al_eth_mac_mode mode)
+{
+	al_assert(obj);
+
+	obj->mac_mode = mode;
+
+	return 0;
+}
+
+static int mac_mode_get(__attribute__((unused)) struct al_eth_mac_obj *obj,
+	__attribute__((unused)) enum al_eth_mac_mode *mode)
+{
+	al_assert(0);
+
+	return 0;
+}
+
+static int mac_config(struct al_eth_mac_obj *obj, enum al_eth_mac_mode mode)
+{
+	struct al_eth_mac_regs *mac_regs_base = obj->mac_regs_base;
+
+	switch (mode) {
+	case AL_ETH_MAC_MODE_RGMII:
+		al_reg_write32(&mac_regs_base->gen.clk_cfg,
+			(ETH_MAC_GEN_CLK_CFG_RX_CLK_SEL |
+				AL_ETH_MAC_GEN_CLK_CFG_LANES_CLK_SEL(0x3, 0x2, 0x1, 0x0)));
+
+		/* 1G MAC control register */
+		/* bit[0]  - TX_ENA - zeroed by default. Should be asserted by al_eth_mac_start
+		 * bit[1]  - RX_ENA - zeroed by default. Should be asserted by al_eth_mac_start
+		 * bit[3]  - ETH_SPEED - zeroed to enable 10/100 Mbps Ethernet
+		 * bit[4]  - PROMIS_EN - asserted to enable MAC promiscuous mode
+		 * bit[23] - CNTL_FRM-ENA - asserted to enable control frames
+		 * bit[24] - NO_LGTH_CHECK - asserted to disable length checks,
+		 * 		which is done in the controller
+		 */
+		al_reg_write32(&mac_regs_base->mac_1g.cmd_cfg,
+			(ETH_MAC_MAC_1G_CMD_CFG_NO_LGTH_CHECK |
+				ETH_MAC_MAC_1G_CMD_CFG_CNTL_FRM_ENA  |
+				ETH_MAC_MAC_1G_CMD_CFG_PROMIS_EN));
+
+		/* RX_SECTION_EMPTY,  */
+		al_reg_write32(&mac_regs_base->mac_1g.rx_section_empty, 0x00000000);
+		/* RX_SECTION_FULL,  */
+		/* must be larger than almost empty */
+		al_reg_write32(&mac_regs_base->mac_1g.rx_section_full, 0x0000000c);
+		/* RX_ALMOST_EMPTY,  */
+		al_reg_write32(&mac_regs_base->mac_1g.rx_almost_empty, 0x00000008);
+		/* RX_ALMOST_FULL,  */
+		al_reg_write32(&mac_regs_base->mac_1g.rx_almost_full, 0x00000008);
+
+
+		/* TX_SECTION_EMPTY,  */
+		/* 8 ? */
+		al_reg_write32(&mac_regs_base->mac_1g.tx_section_empty, 0x00000008);
+		/* TX_SECTION_FULL, 0 - store and forward, */
+		al_reg_write32(&mac_regs_base->mac_1g.tx_section_full, 0x0000000c);
+		/* TX_ALMOST_EMPTY,  */
+		al_reg_write32(&mac_regs_base->mac_1g.tx_almost_empty, 0x00000008);
+		/* TX_ALMOST_FULL,  */
+		al_reg_write32(&mac_regs_base->mac_1g.tx_almost_full, 0x00000008);
+
+		/* XAUI MAC control register */
+		al_reg_write32(&mac_regs_base->gen.cfg,
+			(ETH_MAC_GEN_CFG_SWAP_SERDES_TX(0x0) |
+				ETH_MAC_GEN_CFG_SWAP_SERDES_RX(0x0) |
+				ETH_MAC_GEN_CFG_MDIO_POL_NORMAL |
+				ETH_MAC_GEN_CFG_MDIO_1_10_1G_MAC |
+				ETH_MAC_GEN_CFG_TBI_MSB_TX_LSB |
+				ETH_MAC_GEN_CFG_RGMII_SGMII_SEL_RGMII |
+				ETH_MAC_GEN_CFG_SGMII_SEL_10G_MAC |
+				ETH_MAC_GEN_CFG_TBI_MSB_RX_LSB |
+				ETH_MAC_GEN_CFG_XAUI_RXAUI_XAUI |
+				ETH_MAC_GEN_CFG_XGMII_SGMII_SGMII |
+				ETH_MAC_GEN_CFG_MAC_1_10_1G_MAC));
+
+		/* 1G MACSET 1G */
+		/* taking sel_1000/sel_10 inputs from rgmii PHY, and not from register.
+		 * disabling magic_packets detection in mac */
+		al_reg_write32(&mac_regs_base->gen.mac_1g_cfg,
+			(ETH_MAC_GEN_MAC_1G_CFG_SLEEPN_SLEEP |
+			ETH_MAC_GEN_MAC_1G_CFG_SET_10_DEF_0 |
+			ETH_MAC_GEN_MAC_1G_CFG_SET_10_SEL_FROM_RGMII |
+			ETH_MAC_GEN_MAC_1G_CFG_SET_1000_DEF_1 |
+			ETH_MAC_GEN_MAC_1G_CFG_SET_1000_SEL_FROM_RGMII));
+		/* RGMII set 1G */
+		al_reg_write32_masked(&mac_regs_base->gen.mux_sel,
+			(ETH_MAC_GEN_MUX_SEL_SERDES_3_TX_MASK |
+			ETH_MAC_GEN_MUX_SEL_SERDES_2_TX_MASK |
+			ETH_MAC_GEN_MUX_SEL_SERDES_1_TX_MASK |
+			ETH_MAC_GEN_MUX_SEL_SERDES_0_TX_MASK |
+			ETH_MAC_GEN_MUX_SEL_XAUI_3_IN_MASK |
+			ETH_MAC_GEN_MUX_SEL_XAUI_2_IN_MASK |
+			ETH_MAC_GEN_MUX_SEL_XAUI_1_IN_MASK |
+			ETH_MAC_GEN_MUX_SEL_XAUI_0_IN_MASK |
+			ETH_MAC_GEN_MUX_SEL_RXAUI_1_IN_MASK |
+			ETH_MAC_GEN_MUX_SEL_RXAUI_0_IN_MASK |
+			ETH_MAC_GEN_MUX_SEL_SGMII_IN_MASK),
+			(ETH_MAC_GEN_MUX_SEL_SERDES_3_TX(
+			ETH_MAC_GEN_MUX_SEL_SERDES_TX_XAUI_0) |
+			ETH_MAC_GEN_MUX_SEL_SERDES_2_TX(
+			ETH_MAC_GEN_MUX_SEL_SERDES_TX_XAUI_0) |
+			ETH_MAC_GEN_MUX_SEL_SERDES_1_TX(
+			ETH_MAC_GEN_MUX_SEL_SERDES_TX_XAUI_0) |
+			ETH_MAC_GEN_MUX_SEL_SERDES_0_TX(
+			ETH_MAC_GEN_MUX_SEL_SERDES_TX_SGMII)  |
+			ETH_MAC_GEN_MUX_SEL_XAUI_3_IN(0x3) |
+			ETH_MAC_GEN_MUX_SEL_XAUI_2_IN(0x2) |
+			ETH_MAC_GEN_MUX_SEL_XAUI_1_IN(0x1) |
+			ETH_MAC_GEN_MUX_SEL_XAUI_0_IN(0x0) |
+			ETH_MAC_GEN_MUX_SEL_RXAUI_1_IN(0x1) |
+			ETH_MAC_GEN_MUX_SEL_RXAUI_0_IN(0x0) |
+			ETH_MAC_GEN_MUX_SEL_SGMII_IN(0x0)));
+		al_reg_write32(&mac_regs_base->gen.rgmii_sel,
+			(ETH_MAC_GEN_RGMII_SEL_RX_SWAP_9 |
+			ETH_MAC_GEN_RGMII_SEL_RX_SWAP_7_3 |
+			ETH_MAC_GEN_RGMII_SEL_RX_SWAP_4 |
+			ETH_MAC_GEN_RGMII_SEL_RX_SWAP_3_0));
+		break;
+	case AL_ETH_MAC_MODE_SGMII:
+		al_reg_write32(&mac_regs_base->gen.clk_cfg, 0x40053210);
+
+		/* 1G MAC control register */
+		/* bit[0]  - TX_ENA - zeroed by default. Should be asserted by al_eth_mac_start
+		 * bit[1]  - RX_ENA - zeroed by default. Should be asserted by al_eth_mac_start
+		 * bit[3]  - ETH_SPEED - zeroed to enable 10/100 Mbps Ethernet
+		 * bit[4]  - PROMIS_EN - asserted to enable MAC promiscuous mode
+		 * bit[23] - CNTL_FRM-ENA - asserted to enable control frames
+		 * bit[24] - NO_LGTH_CHECK - asserted to disable length checks,
+		 *				which is done in the controller
+		 */
+		al_reg_write32(&mac_regs_base->mac_1g.cmd_cfg, 0x01800010);
+
+		/* RX_SECTION_EMPTY,  */
+		al_reg_write32(&mac_regs_base->mac_1g.rx_section_empty, 0x00000000);
+		/* RX_SECTION_FULL,  */
+		/* must be larger than almost empty */
+		al_reg_write32(&mac_regs_base->mac_1g.rx_section_full, 0x0000000c);
+		/* RX_ALMOST_EMPTY,  */
+		al_reg_write32(&mac_regs_base->mac_1g.rx_almost_empty, 0x00000008);
+		/* RX_ALMOST_FULL,  */
+		al_reg_write32(&mac_regs_base->mac_1g.rx_almost_full, 0x00000008);
+
+
+		/* TX_SECTION_EMPTY,  */
+		al_reg_write32(&mac_regs_base->mac_1g.tx_section_empty, 0x00000008); /* 8 ? */
+		/* TX_SECTION_FULL, 0 - store and forward, */
+		al_reg_write32(&mac_regs_base->mac_1g.tx_section_full, 0x0000000c);
+		/* TX_ALMOST_EMPTY,  */
+		al_reg_write32(&mac_regs_base->mac_1g.tx_almost_empty, 0x00000008);
+		/* TX_ALMOST_FULL,  */
+		al_reg_write32(&mac_regs_base->mac_1g.tx_almost_full, 0x00000008);
+
+		/* XAUI MAC control register */
+		al_reg_write32(&mac_regs_base->gen.cfg, 0x000000c0);
+
+		/* 1G MACSET 1G */
+		/* taking sel_1000/sel_10 inputs from rgmii_converter, and not from register.
+		 * disabling magic_packets detection in mac */
+		al_reg_write32(&mac_regs_base->gen.mac_1g_cfg, 0x00000002);
+		/* SerDes configuration */
+		al_reg_write32_masked(&mac_regs_base->gen.mux_sel,
+			~ETH_MAC_GEN_MUX_SEL_KR_IN_MASK, 0x00063910);
+		al_reg_write32(&mac_regs_base->gen.sd_fifo_ctrl, 0x000004f0);
+		al_reg_write32(&mac_regs_base->gen.sd_fifo_ctrl, 0x00000401);
+
+		/* FAST AN -- Testing only */
+#if (defined(AL_ETH_FAST_AN)) && (AL_ETH_FAST_AN == 1)
+		al_reg_write32(&mac_regs_base->sgmii.reg_addr, 0x00000012);
+		al_reg_write32(&mac_regs_base->sgmii.reg_data, 0x00000040);
+		al_reg_write32(&mac_regs_base->sgmii.reg_addr, 0x00000013);
+		al_reg_write32(&mac_regs_base->sgmii.reg_data, 0x00000000);
+#endif
+
+		/* Setting PCS i/f mode to SGMII (instead of default 1000Base-X) */
+		al_reg_write32(&mac_regs_base->sgmii.reg_addr, 0x00000014);
+		al_reg_write32(&mac_regs_base->sgmii.reg_data, 0x0000000b);
+		/* setting dev_ability to have speed of 1000Mb, [11:10] = 2'b10 */
+		al_reg_write32(&mac_regs_base->sgmii.reg_addr, 0x00000004);
+		al_reg_write32(&mac_regs_base->sgmii.reg_data, 0x000009A0);
+		al_reg_write32_masked(&mac_regs_base->gen.led_cfg,
+				      ETH_MAC_GEN_LED_CFG_SEL_MASK,
+				      ETH_MAC_GEN_LED_CFG_SEL_DEFAULT_REG);
+		break;
+	case AL_ETH_MAC_MODE_SGMII_2_5G:
+		/* MAC register file */
+		al_reg_write32(&mac_regs_base->mac_10g.cmd_cfg, 0x01022830);
+		/* XAUI MAC control register */
+		al_reg_write32(&mac_regs_base->gen.cfg, 0x00000001);
+		al_reg_write32(&mac_regs_base->mac_10g.if_mode, 0x00000028);
+		al_reg_write32(&mac_regs_base->mac_10g.control, 0x00001140);
+		/* RXAUI MAC control register */
+		al_reg_write32(&mac_regs_base->gen.xgmii_dfifo_32_64, 0x00000401);
+		al_reg_write32(&mac_regs_base->gen.xgmii_dfifo_64_32, 0x00000401);
+		al_reg_write32_masked(&mac_regs_base->gen.mux_sel,
+				      ~ETH_MAC_GEN_MUX_SEL_KR_IN_MASK, 0x00063910);
+		al_reg_write32(&mac_regs_base->gen.clk_cfg, 0x40003210);
+		al_reg_write32(&mac_regs_base->gen.sd_fifo_ctrl, 0x000004f0);
+		al_reg_write32(&mac_regs_base->gen.sd_fifo_ctrl, 0x00000401);
+
+		al_reg_write32_masked(&mac_regs_base->gen.led_cfg,
+				      ETH_MAC_GEN_LED_CFG_SEL_MASK,
+				      ETH_MAC_GEN_LED_CFG_SEL_DEFAULT_REG);
+		break;
+	case AL_ETH_MAC_MODE_10GbE_Serial:
+		/* MAC register file */
+		al_reg_write32(&mac_regs_base->mac_10g.cmd_cfg, 0x01022810);
+		/* XAUI MAC control register */
+		al_reg_write32(&mac_regs_base->gen.cfg, 0x00000005);
+		/* RXAUI MAC control register */
+		al_reg_write32(&mac_regs_base->gen.rxaui_cfg, 0x00000007);
+		al_reg_write32(&mac_regs_base->gen.sd_cfg, 0x000001F1);
+		al_reg_write32(&mac_regs_base->gen.xgmii_dfifo_32_64, 0x00000401);
+		al_reg_write32(&mac_regs_base->gen.xgmii_dfifo_64_32, 0x00000401);
+		al_reg_write32_masked(&mac_regs_base->gen.mux_sel,
+					~ETH_MAC_GEN_MUX_SEL_KR_IN_MASK, 0x00073910);
+		al_reg_write32(&mac_regs_base->gen.clk_cfg, 0x10003210);
+		al_reg_write32(&mac_regs_base->gen.sd_fifo_ctrl, 0x000004f0);
+		al_reg_write32(&mac_regs_base->gen.sd_fifo_ctrl, 0x00000401);
+
+		al_reg_write32_masked(&mac_regs_base->gen.led_cfg,
+				      ETH_MAC_GEN_LED_CFG_SEL_MASK,
+				      ETH_MAC_GEN_LED_CFG_SEL_DEFAULT_REG);
+		break;
+	case AL_ETH_MAC_MODE_10G_SGMII:
+		/* MAC register file */
+		al_reg_write32(&mac_regs_base->mac_10g.cmd_cfg, 0x01022810);
+
+		/* XAUI MAC control register */
+		al_reg_write32(&mac_regs_base->gen.cfg, 0x00000001);
+
+		al_reg_write32(&mac_regs_base->mac_10g.if_mode, 0x0000002b);
+		al_reg_write32(&mac_regs_base->mac_10g.control, 0x00009140);
+		/* FAST AN -- Testing only */
+#if (defined(AL_ETH_FAST_AN)) && (AL_ETH_FAST_AN == 1)
+		al_reg_write32(&mac_regs_base->mac_10g.link_timer_lo, 0x00000040);
+		al_reg_write32(&mac_regs_base->mac_10g.link_timer_hi, 0x00000000);
+#endif
+
+		/* RXAUI MAC control register */
+		al_reg_write32(&mac_regs_base->gen.rxaui_cfg, 0x00000007);
+		al_reg_write32(&mac_regs_base->gen.xgmii_dfifo_32_64, 0x00000401);
+		al_reg_write32(&mac_regs_base->gen.xgmii_dfifo_64_32, 0x00000401);
+		al_reg_write32_masked(&mac_regs_base->gen.mux_sel,
+					~ETH_MAC_GEN_MUX_SEL_KR_IN_MASK, 0x00063910);
+		al_reg_write32(&mac_regs_base->gen.clk_cfg, 0x40003210);
+		al_reg_write32(&mac_regs_base->gen.sd_fifo_ctrl, 0x00000401);
+
+		al_reg_write32_masked(&mac_regs_base->gen.led_cfg,
+				      ETH_MAC_GEN_LED_CFG_SEL_MASK,
+				      ETH_MAC_GEN_LED_CFG_SEL_DEFAULT_REG);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	mac_mode_set(obj, mode);
+
+	return 0;
+}
