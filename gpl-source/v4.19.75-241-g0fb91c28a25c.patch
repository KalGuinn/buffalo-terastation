+					 * data write FIFO, defined based on
+					 * header FIFO size
+					 */
+	uint8_t max_pkt_limit;		/* maximum number of packets in the
+					* data write FIFO,defined based on
+					* header FIFO size
+					*/
+	uint8_t fifo_margin;
+	uint32_t desc_wait_timer;	/* waiting time for the host to write
+					* new descriptor to the queue
