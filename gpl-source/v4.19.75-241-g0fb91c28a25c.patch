+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_MASK_MSI_X (1 << 5)
+/* MSI-X AWID value. Same ID for all cause bits. */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_AWID_MASK 0x00000F00
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_AWID_SHIFT 8
+/* This value determines the interval between interrupts. Writing ZERO disables
+ * Moderation.
+ */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_MOD_INTV_MASK 0x00FF0000
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_MOD_INTV_SHIFT 16
+/* This value determines the Moderation_Timer_Clock speed.
+ * 0- Moderation-timer is decremented every 1x256 SB clock cycles ~1uS.
+ * 1- Moderation-timer is decremented every 2x256 SB clock cycles ~2uS.
+ * N- Moderation-timer is decremented every Nx256 SB clock cycles ~(N+1) uS.
+ */
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_MOD_RES_MASK 0x0F000000
+#define PCIE_AXI_INTERRUPT_GRP_B_AXI_INT_CONTROL_GRP_B_AXI_MOD_RES_SHIFT 24
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __AL_HAL_pcie_axi_REG_H */
+
+/** @} end of ... group */
