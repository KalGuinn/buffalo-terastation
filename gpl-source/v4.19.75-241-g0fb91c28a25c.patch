+					(enum al_serdes_reg_page)lane,
+					SERDES_25G_LANE_DRV_TXEQ_CTRL3_ADDR,
+					SERDES_25G_LANE_DRV_TXEQ_CTRL3_TXEQ_CM1_MASK,
+					SERDES_25G_LANE_DRV_TXEQ_CTRL3_TXEQ_CM1_SHIFT,
