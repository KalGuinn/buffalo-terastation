+static int mac_start_stop_adv(struct al_eth_mac_obj *obj,
+			      al_bool tx,
+			      al_bool rx,
+			      al_bool tx_start,
+			      al_bool rx_start)
+{
+	struct al_eth_mac_regs *mac_regs_base = obj->mac_regs_base;
+	uint32_t cmd_cfg = 0;
+	uint32_t mask = 0;
+
+	al_dbg("%s: mac_mode:%s, tx_modify:%d, tx_start:%d, rx_modify:%d, rx_start:%d\n",
+	       __func__,
+	       al_eth_mac_mode_str(obj->mac_mode),
+	       tx,
+	       tx_start,
+	       rx,
+	       rx_start);
+
+	switch (obj->mac_mode) {
+	case AL_ETH_MAC_MODE_RGMII:
+	case AL_ETH_MAC_MODE_SGMII:
+		if (tx) {
+			mask |= ETH_1G_MAC_CMD_CFG_TX_ENA;
+			if (tx_start)
+				cmd_cfg |= ETH_1G_MAC_CMD_CFG_TX_ENA;
+		}
+
+		if (rx) {
+			mask |= ETH_1G_MAC_CMD_CFG_RX_ENA;
+			if (rx_start)
+				cmd_cfg |= ETH_1G_MAC_CMD_CFG_RX_ENA;
+		}
+		/* 1G MAC control register */
+		al_reg_write32_masked(&mac_regs_base->mac_1g.cmd_cfg,
+				      mask,
+				      cmd_cfg);
+		break;
+	case AL_ETH_MAC_MODE_SGMII_2_5G:
+	case AL_ETH_MAC_MODE_10GbE_Serial:
+	case AL_ETH_MAC_MODE_10G_SGMII:
+		if (tx) {
+			mask |= ETH_10G_MAC_CMD_CFG_TX_ENA;
+			if (tx_start)
+				cmd_cfg |= ETH_10G_MAC_CMD_CFG_TX_ENA;
+		}
+
+		if (rx) {
+			mask |= ETH_10G_MAC_CMD_CFG_RX_ENA;
+			if (rx_start)
+				cmd_cfg |= ETH_10G_MAC_CMD_CFG_RX_ENA;
+		}
+		/* 10G MAC control register  */
+		al_reg_write32_masked(&mac_regs_base->mac_10g.cmd_cfg,
+				      mask,
+				      cmd_cfg);
+		break;
+	default:
+		al_err("%s@%s: Unsupported mac_mode: %s\n",
+		       __func__, __FILE__,
+		       al_eth_mac_mode_str(obj->mac_mode));
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int mac_loopback_config(struct al_eth_mac_obj *obj, al_bool enable)
+{
+	struct al_eth_mac_regs *mac_regs_base = obj->mac_regs_base;
+
+	switch (obj->mac_mode) {
+	case AL_ETH_MAC_MODE_RGMII:
+	case AL_ETH_MAC_MODE_SGMII:
+		al_reg_write32_masked(&mac_regs_base->mac_1g.cmd_cfg, AL_BIT(15),
+			(enable ? AL_BIT(15) : 0));
+		break;
+	case AL_ETH_MAC_MODE_10GbE_Serial:
+		al_reg_write32(&mac_regs_base->kr.pcs_addr, ETH_MAC_KR_PCS_CONTROL_1_ADDR);
+		al_reg_write32_masked(&mac_regs_base->kr.pcs_data, AL_BIT(14),
+			enable ? AL_BIT(14) : 0);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
