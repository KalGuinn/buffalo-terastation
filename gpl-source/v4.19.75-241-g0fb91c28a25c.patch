+
+
+
+	cfg->calc.t_rp = t_rp;
+	cfg->calc.t_ras_min = t_ras_min;
+	cfg->calc.t_rc = t_rc;
+	cfg->calc.t_rrd = t_rrd;
+	cfg->calc.t_rcd = t_rcd;
+	cfg->calc.t_rtp = t_rtp;
+	cfg->calc.t_wtr = t_wtr;
