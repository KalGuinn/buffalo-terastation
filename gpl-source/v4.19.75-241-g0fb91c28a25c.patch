+/*
+* Unit Registers
+*/
+
+struct al_mod_eth_mac_1g_stats {
+	uint32_t reserved1[2];
+	uint32_t frames_txed_ok;			/* 0x68 */
+	uint32_t frames_rxed_ok;			/* 0x6c */
+	uint32_t fcs_errors;				/* 0x70 */
+	uint32_t alignment_errors;			/* 0x74 */
+	uint32_t octets_txed_ok;			/* 0x78 */
+	uint32_t octets_rxed_ok;			/* 0x7c */
+	uint32_t pause_mac_ctrl_frames_txed;		/* 0x80 */
+	uint32_t pause_mac_ctrl_frames_rxed;		/* 0x84 */
+	uint32_t if_in_errors;				/* 0x88 */
+	uint32_t if_out_errors;				/* 0x8c */
+	uint32_t if_in_ucast_pkts;			/* 0x90 */
+	uint32_t if_in_mcast_pkts;			/* 0x94 */
+	uint32_t if_in_bcast_pkts;			/* 0x98 */
+	uint32_t reserved2;
+	uint32_t if_out_ucast_pkts;			/* 0xa0 */
+	uint32_t if_out_mcast_pkts;			/* 0xa4 */
+	uint32_t if_out_bcast_pkts;			/* 0xa8 */
+	uint32_t drop_events;				/* 0xac */
+	uint32_t octets;				/* 0xb0 */
+	uint32_t pkts;					/* 0xb4 */
+	uint32_t undersize_pkts;			/* 0xb8 */
+	uint32_t oversize_pkts;				/* 0xbc */
+	uint32_t pkts_64_octets;			/* 0xc0 */
+	uint32_t pkts_65_to_127_octets;			/* 0xc4 */
+	uint32_t pkts_128_to_255_octets;		/* 0xc8 */
+	uint32_t pkts_256_to_511_octets;		/* 0xcc */
+	uint32_t pkts_512_to_1023_octets;		/* 0xd0 */
+	uint32_t pkts_1024_to_1518_octets;		/* 0xd4 */
+	uint32_t pkts_1519_to_x;			/* 0xd8 */
+	uint32_t jabbers;				/* 0xdc */
+	uint32_t fragments;				/* 0xe0 */
+	uint32_t reserved3[71];
+};
+
+struct al_mod_eth_mac_1g {
+	/* [0x0] */
+	uint32_t rev;
+	uint32_t scratch;
+	uint32_t cmd_cfg;
+	uint32_t mac_0;
+	/* [0x10] */
+	uint32_t mac_1;
+	uint32_t frm_len;
+	uint32_t pause_quant;
+	uint32_t rx_section_empty;
+	/* [0x20] */
+	uint32_t rx_section_full;
+	uint32_t tx_section_empty;
+	uint32_t tx_section_full;
+	uint32_t rx_almost_empty;
+	/* [0x30] */
+	uint32_t rx_almost_full;
+	uint32_t tx_almost_empty;
+	uint32_t tx_almost_full;
+	uint32_t mdio_addr0;
+	/* [0x40] */
+	uint32_t mdio_addr1;
+	uint32_t Reserved[5];
+	/* [0x58] */
+	uint32_t reg_stat;
+	uint32_t tx_ipg_len;
+	/* [0x60] */
+	struct al_mod_eth_mac_1g_stats stats;
+	/* [0x200] */
+	uint32_t phy_regs_base;
+	uint32_t Reserved2[127];
+};
+
+struct al_mod_eth_mac_10g_stats_v2 {
+	uint32_t frames_txed_ok;			/* 0x80 */
+	uint32_t reserved1;
+	uint32_t frames_rxed_ok;			/* 0x88 */
+	uint32_t reserved2;
+	uint32_t fcs_errors;				/* 0x90 */
+	uint32_t reserved3;
+	uint32_t alignment_errors;			/* 0x98 */
+	uint32_t reserved4;
+	uint32_t pause_mac_ctrl_frames_txed;		/* 0xa0 */
+	uint32_t reserved5;
+	uint32_t pause_mac_ctrl_frames_rxed;		/* 0xa8 */
+	uint32_t reserved6;
+	uint32_t frame_too_long_errs;			/* 0xb0 */
+	uint32_t reserved7;
+	uint32_t in_range_length_errs;			/* 0xb8 */
+	uint32_t reserved8;
+	uint32_t vlan_txed_ok;				/* 0xc0 */
+	uint32_t reserved9;
+	uint32_t vlan_rxed_ok;				/* 0xc8 */
+	uint32_t reserved10;
+	uint32_t if_out_octets_l;			/* 0xd0 */
+	uint32_t if_out_octets_h;			/* 0xd4 */
+	uint32_t if_in_octets_l;			/* 0xd8 */
+	uint32_t if_in_octets_h;			/* 0xdc */
+	uint32_t if_in_ucast_pkts;			/* 0xe0 */
