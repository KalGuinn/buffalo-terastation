+/******************************************************************************/
+/******************************************************************************/
+static void al_mod_serdes_dcgain_set(
+	struct al_mod_serdes_grp_obj	*obj,
+	uint8_t				dcgain)
+{
+	al_mod_serdes_grp_reg_masked_write(obj,
+			AL_SRDS_REG_PAGE_4_COMMON,
+			AL_SRDS_REG_TYPE_PMA,
+			SERDES_IREG_FLD_RXEQ_DCGAIN_LUP0_REG_NUM,
+			SERDES_IREG_FLD_RXEQ_DCGAIN_LUP0_MASK,
+			(dcgain << SERDES_IREG_FLD_RXEQ_DCGAIN_LUP0_SHIFT));
+}
+
+/******************************************************************************/
+/******************************************************************************/
+#define SERDES_LANE_ICTL_MULTI_SATA_CONFIG 0x30990034
+
+#define SERDES_HSSP_SPEED_MASK		(SERDES_LANE_ICTL_MULTI_RXRATE_L_MASK | \
+					SERDES_LANE_ICTL_MULTI_TXRATE_L_MASK)
+#define SERDES_HSSP_SPEED(c)					\
+	(((c) << SERDES_LANE_ICTL_MULTI_RXRATE_L_SHIFT) |	\
+	 ((c) << SERDES_LANE_ICTL_MULTI_TXRATE_L_SHIFT))
+#define SERDES_HSSP_SPEED_1G		SERDES_HSSP_SPEED(1)
+#define SERDES_HSSP_SPEED_2_5G		SERDES_HSSP_SPEED(2)
+#define SERDES_HSSP_SPEED_10G		SERDES_HSSP_SPEED(3)
+
+static void al_mod_serdes_hssp_mode_class_get(struct al_mod_serdes_grp_obj *obj,
+					enum al_mod_serdes_group_mode_class *serdes_group_mode_class)
+{
+	struct al_mod_serdes_regs __iomem	*regs_base = obj->regs_base;
+	enum al_mod_serdes_group_mode_class lane_mode_class[AL_SRDS_NUM_LANES] = {0};
+	int i;
+	uint32_t reg;
+
+	reg = al_mod_reg_read32(&regs_base->gen.ictl_pcs);
+	if (reg == 0x1) {
+		*serdes_group_mode_class = AL_SRDS_MODE_CLASS_PCIE;
+	} else {
+		for (i = 0; i < AL_SRDS_NUM_LANES; i++) {
+			reg = al_mod_reg_read32(&regs_base->lane[i].ictl_multi);
+			if (reg == SERDES_LANE_ICTL_MULTI_SATA_CONFIG)
+				lane_mode_class[i] = AL_SRDS_MODE_CLASS_SATA;
+			else if (((reg & SERDES_HSSP_SPEED_MASK) == SERDES_HSSP_SPEED_10G) ||
+				 ((reg & SERDES_HSSP_SPEED_MASK) == SERDES_HSSP_SPEED_1G) ||
+				 ((reg & SERDES_HSSP_SPEED_MASK) == SERDES_HSSP_SPEED_2_5G))
+				lane_mode_class[i] = AL_SRDS_MODE_CLASS_ETH;
+			else
+				lane_mode_class[i] = AL_SRDS_MODE_CLASS_UNKNOWN;
+
+			if ((i > 0) && (lane_mode_class[i] != lane_mode_class[i-1])) {
+				al_mod_err("%s: Inconsistent mode_class configuration between different lanes of the serdes\n",
+				__func__);
+				*serdes_group_mode_class = AL_SRDS_MODE_CLASS_UNKNOWN;
+				break;
+			}
+		}
+
+		*serdes_group_mode_class = lane_mode_class[0];
+	}
+
+	al_mod_dbg("%s: serdes_group_mode_class is %d\n", __func__, *serdes_group_mode_class);
+}
+
+static int al_mod_serdes_hssp_serdes_mode_get(struct al_mod_serdes_grp_obj *obj,
+					enum al_mod_serdes_group_mode *serdes_group_mode)
+{
+	struct al_mod_serdes_regs __iomem	*regs_base = obj->regs_base;
+	enum al_mod_serdes_group_mode lane_mode[AL_SRDS_NUM_LANES];
+	uint32_t reg;
+	unsigned int serdes_10g_speed;
+	int i;
+
+	for (i = 0; i < AL_SRDS_NUM_LANES; i++) {
+		reg = al_mod_reg_read32(&regs_base->lane[i].ictl_multi);
+		serdes_10g_speed = reg & SERDES_HSSP_SPEED_MASK;
+
+		switch (serdes_10g_speed) {
+		case SERDES_HSSP_SPEED_10G:
+			lane_mode[i] = AL_SRDS_CFG_KR;
+			break;
+		case SERDES_HSSP_SPEED_1G:
+			lane_mode[i] = AL_SRDS_CFG_SGMII;
+			break;
+		case SERDES_HSSP_SPEED_2_5G:
+			lane_mode[i] = AL_SRDS_CFG_SGMII_2_5G;
+			break;
+		default:
+			al_mod_err("%s: Unable to determine the serdes_group_mode of lane %d (read 0x%x)\n",
+				__func__, i, serdes_10g_speed);
+			return -EIO;
+		}
+
+		if ((i > 0) && (lane_mode[i] != lane_mode[i-1])) {
+			al_mod_err("%s: Inconsistent speed configuration between different lanes of the serdes\n",
+				__func__);
+			return -EIO;
+		}
+	}
+
+	*serdes_group_mode = lane_mode[0];
+	al_mod_dbg("%s: serdes_group_mode is %d\n", __func__, *serdes_group_mode);
+
+
+	return 0;
+}
+
+/******************************************************************************/
+/******************************************************************************/
+int al_mod_serdes_hssp_handle_init(
+	void __iomem			*serdes_regs_base,
+	struct al_mod_serdes_grp_obj	*obj)
+{
+	al_mod_dbg(
+		"%s(%p, %p)\n",
+		__func__,
+		serdes_regs_base,
+		obj);
+
+	al_mod_memset(obj, 0, sizeof(struct al_mod_serdes_grp_obj));
+
+	obj->regs_base = (struct al_mod_serdes_regs *)serdes_regs_base;
+	obj->type_get = al_mod_serdes_hssp_type_get;
+	obj->reg_read = al_mod_serdes_reg_read;
+	obj->reg_write = al_mod_serdes_reg_write;
+	obj->bist_overrides_enable = AL_SRDS_ADV_SRVC(al_mod_serdes_bist_overrides_enable);
+	obj->bist_overrides_disable = AL_SRDS_ADV_SRVC(al_mod_serdes_bist_overrides_disable);
+	obj->rx_rate_change = AL_SRDS_ADV_SRVC(al_mod_serdes_rx_rate_change);
+	obj->rx_rate_change_sw_flow_en = AL_SRDS_ADV_SRVC(al_mod_serdes_lane_rx_rate_change_sw_flow_en);
+	obj->lane_rx_soft_reset =
+		AL_SRDS_ADV_SRVC(al_mod_serdes_lane_rx_soft_reset);
+	obj->lane_ready =
+		AL_SRDS_ADV_SRVC(al_mod_serdes_lane_ready);
+	obj->rx_rate_change_sw_flow_dis =
+		AL_SRDS_ADV_SRVC(al_mod_serdes_lane_rx_rate_change_sw_flow_dis);
+	obj->pcie_rate_override_is_enabled =
+		AL_SRDS_ADV_SRVC(al_mod_serdes_lane_pcie_rate_override_is_enabled);
+	obj->pcie_rate_override_enable_set =
+		AL_SRDS_ADV_SRVC(al_mod_serdes_lane_pcie_rate_override_enable_set);
+	obj->pcie_rate_get = AL_SRDS_ADV_SRVC(al_mod_serdes_lane_pcie_rate_get);
+	obj->pcie_rate_set = AL_SRDS_ADV_SRVC(al_mod_serdes_lane_pcie_rate_set);
+	obj->group_pm_set = AL_SRDS_ADV_SRVC(al_mod_serdes_group_pm_set);
+	obj->lane_pm_set = AL_SRDS_ADV_SRVC(al_mod_serdes_lane_pm_set);
+	obj->pma_hard_reset_group = AL_SRDS_ADV_SRVC(al_mod_serdes_pma_hard_reset_group);
+	obj->pma_hard_reset_lane = AL_SRDS_ADV_SRVC(al_mod_serdes_pma_hard_reset_lane);
+	obj->loopback_control = AL_SRDS_ADV_SRVC(al_mod_serdes_loopback_control);
+	obj->bist_pattern_select = AL_SRDS_ADV_SRVC(al_mod_serdes_bist_pattern_select);
+	obj->bist_tx_enable = AL_SRDS_ADV_SRVC(al_mod_serdes_bist_tx_enable);
+	obj->bist_tx_err_inject = AL_SRDS_ADV_SRVC(al_mod_serdes_bist_tx_err_inject);
+	obj->bist_rx_enable = AL_SRDS_ADV_SRVC(al_mod_serdes_bist_rx_enable);
+	obj->bist_rx_status = AL_SRDS_ADV_SRVC(al_mod_serdes_bist_rx_status);
+	obj->tx_deemph_preset = AL_SRDS_ADV_SRVC(al_mod_serdes_tx_deemph_preset);
+	obj->tx_deemph_inc = AL_SRDS_ADV_SRVC(al_mod_serdes_tx_deemph_inc);
+	obj->tx_deemph_dec = AL_SRDS_ADV_SRVC(al_mod_serdes_tx_deemph_dec);
+	obj->eye_measure_run = AL_SRDS_ADV_SRVC(al_mod_serdes_eye_measure_run);
+	obj->eye_diag_pre_sample = AL_SRDS_ADV_SRVC(al_mod_serdes_eye_diag_pre_sample);
+	obj->eye_diag_start_sample = AL_SRDS_ADV_SRVC(al_mod_serdes_eye_diag_start_sample);
+	obj->eye_diag_poll_sample = AL_SRDS_ADV_SRVC(al_mod_serdes_eye_diag_poll_sample);
+	obj->eye_diag_stop_sample = AL_SRDS_ADV_SRVC(al_mod_serdes_eye_diag_stop_sample);
+	obj->eye_diag_post_sample = AL_SRDS_ADV_SRVC(al_mod_serdes_eye_diag_post_sample);
+	obj->eye_diag_sample = AL_SRDS_ADV_SRVC(al_mod_serdes_eye_diag_sample);
+	obj->signal_is_detected = AL_SRDS_ADV_SRVC(al_mod_serdes_signal_is_detected);
+	obj->tx_advanced_params_set = AL_SRDS_ADV_SRVC(al_mod_serdes_tx_advanced_params_set);
+	obj->tx_advanced_params_get = AL_SRDS_ADV_SRVC(al_mod_serdes_tx_advanced_params_get);
+	obj->rx_advanced_params_set = AL_SRDS_ADV_SRVC(al_mod_serdes_rx_advanced_params_set);
+	obj->rx_advanced_params_get = AL_SRDS_ADV_SRVC(al_mod_serdes_rx_advanced_params_get);
+	obj->mode_set_sgmii = AL_SRDS_ADV_ETH_SRVC(al_mod_serdes_mode_set_sgmii);
+	obj->mode_set_kr = AL_SRDS_ADV_ETH_SRVC(al_mod_serdes_mode_set_kr);
+	obj->rx_equalization_reset = AL_SRDS_ADV_SRVC(al_mod_serdes_rx_equalization_reset);
+	obj->rx_equalization = AL_SRDS_ADV_SRVC(al_mod_serdes_rx_equalization);
+	obj->calc_eye_size = AL_SRDS_ADV_SRVC(al_mod_serdes_calc_eye_size);
+	obj->sris_config = AL_SRDS_ADV_SRVC(al_mod_serdes_sris_config);
+	obj->dcgain_set = AL_SRDS_ADV_SRVC(al_mod_serdes_dcgain_set);
+	obj->udelay_cb = AL_SRDS_ADV_SRVC(al_mod_serdes_hssp_udelay);
+	obj->msleep_cb = AL_SRDS_ADV_SRVC(al_mod_serdes_hssp_msleep);
+	obj->serdes_mode_class_get = AL_SRDS_ADV_SRVC(al_mod_serdes_hssp_mode_class_get);
+	obj->serdes_mode_get = AL_SRDS_ADV_SRVC(al_mod_serdes_hssp_serdes_mode_get);
+
+	return 0;
+}
