+
+int al_sbus_write_masked(
+	const struct al_sbus_obj	*obj,
+	unsigned int			receiver_addr,
+	unsigned int			data_addr,
+	unsigned int			data_mask,
+	unsigned int			data,
+	al_bool				wait_vaild)
+{
+	unsigned int mutex_user_idx = al_sbus_slave_addr_to_mutex_user_idx(receiver_addr);
+	int err;
+
+	al_assert(obj);
+	al_assert(obj->regs);
+	al_assert((data & data_mask) == data);
+
+	/* Lock SBUS master */
+	al_sbus_mutex_lock(obj, mutex_user_idx);
+
+	err = al_sbus_cmd_issue(obj, AL_SBUS_CMD_READ, receiver_addr, data_addr, 0, AL_TRUE);
+	if (err)
+		return err;
+
+#if AL_SBUS_USE_CORE
+	data |= al_reg_read32(&obj->regs->sbus.rcv) & (~data_mask);
+#else
+	data |= al_reg_read32(&obj->regs->sbus.spare_rcv) & (~data_mask);
+#endif
+	err = al_sbus_cmd_issue(
+		obj, AL_SBUS_CMD_WRITE, receiver_addr, data_addr, data, wait_vaild);
+
+	/* Unlock SBUS master */
+	al_sbus_mutex_unlock(obj, mutex_user_idx);
+
+	return err;
+}
