+/******************************************************************************/
+static int al_mod_serdes_reg_write(
+	struct al_mod_serdes_grp_obj	*obj,
+	enum al_mod_serdes_reg_page		page,
+	enum al_mod_serdes_reg_type		type,
+	uint16_t			offset,
+	uint8_t				data)
+{
+	int status = 0;
+
+	al_mod_dbg(
+		"%s(%p, %d, %d, %u, %u)\n",
+		__func__,
+		obj,
+		page,
+		type,
+		offset,
+		data);
+
+	al_mod_assert(obj);
+	al_mod_assert(((int)page) >= AL_SRDS_REG_PAGE_0_LANE_0);
+	al_mod_assert(((int)page) <= AL_SRDS_REG_PAGE_0123_LANES_0123);
+	al_mod_assert(((int)type) >= AL_SRDS_REG_TYPE_PMA);
+	al_mod_assert(((int)type) <= AL_SRDS_REG_TYPE_PCS);
+
+	al_mod_serdes_grp_reg_write(
+		obj,
+		page,
+		type,
+		offset,
+		data);
+
+	return status;
+}
