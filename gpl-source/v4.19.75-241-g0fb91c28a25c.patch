+/** Calculate OK rx/tx octets - octets_ok = octets - 18 * frames_ok- 4 * vlan_ok */
+static inline void mac_stats_net_rx_tx_ok(struct al_mod_eth_mac_v4_regs *mac_regs_base,
+	struct al_mod_eth_mac_stats *stats,
+	uint64_t *rx_ok, uint64_t *tx_ok)
+{
+	struct al_mod_eth_mac_50g_stats_v4 *stat_regs = NULL;
+	uint64_t reg;
+
+	reg = al_mod_eth_50g_mac_reg_read(mac_regs_base,
+		(uintptr_t) &stat_regs->rx.if_octets_l);
+	reg |= ((uint64_t)(al_mod_eth_50g_mac_reg_read(mac_regs_base,
+		(uintptr_t) &stat_regs->rx.if_octets_h)) << 32);
+	reg -= 18 * stats->frames_rxed_ok;
+	reg -= 4 * stats->vlan_rxed_ok;
+	*rx_ok = reg;
+
+	reg = al_mod_eth_50g_mac_reg_read(mac_regs_base,
+		(uintptr_t) &stat_regs->tx.if_octets_l);
+	reg |= ((uint64_t)(al_mod_eth_50g_mac_reg_read(mac_regs_base,
+		(uintptr_t) &stat_regs->tx.if_octets_h)) << 32);
+	reg -= 18 * stats->frames_txed_ok;
+	reg -= 4 * stats->vlan_txed_ok;
+	*tx_ok = reg;
+}
+
+static inline void mac_stats_net_rx_tx_ok_100g(struct al_mod_eth_mac_v4_regs *mac_regs_base,
+	struct al_mod_eth_mac_stats *stats,
+	uint64_t *rx_ok, uint64_t *tx_ok)
+{
+	struct al_mod_eth_mac_100g_stats_v4 *stat_regs_100G = NULL;
+	uint64_t reg;
+
+	reg = al_mod_eth_100g_mac_reg_read64(mac_regs_base,
+		(uintptr_t) &stat_regs_100G->if_in_octets_l);
+	reg -= 18 * stats->frames_rxed_ok;
+	reg -= 4 * stats->vlan_rxed_ok;
+	*rx_ok = reg;
+
+	reg = al_mod_eth_100g_mac_reg_read64(mac_regs_base,
+		(uintptr_t) &stat_regs_100G->if_out_octets_l);
+	reg -= 18 * stats->frames_txed_ok;
+	reg -= 4 * stats->vlan_txed_ok;
+	*tx_ok = reg;
+}
