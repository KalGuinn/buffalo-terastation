+#define AL_SSM_CRYPTO_RAID_BASE			AL_SSM_RAID_BASE(0)
+
+/* SB SSM RAID Sub Windows */
+#define AL_SSM_RAID_UDMA_BASE(udma_idx)		AL_SSM_UDMA_BASE(1, udma_idx)
