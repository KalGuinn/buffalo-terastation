+	*is_locked = !al_mod_serdes_avg_signal_loss_sticky_get(obj, AL_TRUE);
+	*err_cnt = al_mod_serdes_avg_bist_aux_err_get(obj);
+	*err_cnt_overflow = ((*err_cnt) == 0xffffffff);
