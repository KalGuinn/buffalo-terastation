+DDR_STATIC int _al_ddr_phy_ac_bist(
+	struct al_ddr_cfg		*ddr_cfg __attribute__((unused)),
+	struct al_ddr_bist_err_status	*bist_err_status __attribute__((unused)),
+	enum al_ddr_bist_pat		pat __attribute__((unused)))
+{
+	al_err("%s - Not supported for ALPINE_V3.\n", __func__);
+	return -EINVAL;
+}
+
+/*******************************************************************************
+ ******************************************************************************/
+DDR_STATIC int _al_ddr_phy_datx_bist(
+	struct al_ddr_cfg		*ddr_cfg,
+	struct al_ddr_bist_params	*params,
+	struct al_ddr_bist_err_status	*bist_err_status)
+{
+	int i;
+	int err = 0;
+	uint32_t reg_val;
+
+	STRUCT_PHY_REGS __iomem *phy_regs = PHY_REGS(ddr_cfg->ddr_phy_regs_base);
+
+	uint32_t mode;
+	uint32_t pattern;
+
+	mode =
+		(params->mode == AL_DDR_BIST_MODE_LOOPBACK) ?
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BMODE_LOOPBACK :
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BMODE_DRAM;
+
+	pattern =
+		(params->pat == AL_DDR_BIST_PATTERN_WALK_0) ?
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BDPAT_WALKING_0 :
+		(params->pat == AL_DDR_BIST_PATTERN_WALK_1) ?
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BDPAT_WALKING_1 :
+		(params->pat == AL_DDR_BIST_PATTERN_LFSR) ?
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BDPAT_LFSR :
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BDPAT_USER;
+
+	/**
+	* Init BIST mode of operation
+	*/
+
+	/* BISTUDPR */
+	al_reg_write32_masked(
+		&phy_regs->bistudpr,
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTUDPR_BUDP0_MASK |
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTUDPR_BUDP1_MASK,
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTUDPR_BUDP0(
+			params->user_pat_even) |
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTUDPR_BUDP1(
+			params->user_pat_odd));
+
+	/* BISTWCR */
+	al_reg_write32_masked(
+		&phy_regs->bistwcr,
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTWCR_BWCNT_MASK,
+		(params->wc <<
+		 ALPINE_V3_DWC_DDR_PHY_REGS_BISTWCR_BWCNT_SHIFT));
+
+	/* BISTAR0 */
+	al_reg_write32_masked(
+		&phy_regs->bistar[0],
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR0_BCOL_MASK |
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR0_BBANK_MASK,
+		(params->col_min <<
+		 ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR0_BCOL_SHIFT) |
+		(params->bank_min <<
+		 ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR0_BBANK_SHIFT));
+
+	/* BISTAR1 */
+	al_reg_write32_masked(
+		&phy_regs->bistar[1],
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR1_BRANK_MASK |
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR1_BMRANK_MASK |
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR1_BAINC_MASK,
+		(params->rank_min <<
+		 ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR1_BRANK_SHIFT) |
+		(params->rank_max <<
+		 ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR1_BMRANK_SHIFT) |
+		(params->inc <<
+		 ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR1_BAINC_SHIFT));
+
+	/* BISTAR2 */
+	al_reg_write32_masked(
+		&phy_regs->bistar[2],
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR2_BMCOL_MASK |
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR2_BMBANK_MASK,
+		(params->col_max <<
+		 ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR2_BMCOL_SHIFT) |
+		(params->bank_max <<
+		 ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR2_BMBANK_SHIFT));
+
+	/* BISTAR3 */
+	al_reg_write32_masked(
+		&phy_regs->bistar[3],
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR3_BROW_MASK,
+		(params->row_min <<
+		 ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR3_BROW_SHIFT));
+	/* BISTAR4 */
+	al_reg_write32_masked(
+		&phy_regs->bistar[4],
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR4_BMROW_MASK,
+		(params->row_max <<
+		 ALPINE_V3_DWC_DDR_PHY_REGS_BISTAR4_BMROW_SHIFT));
+
+	/* Run DATX8 BIST */
+	for (i = 0; i < AL_DDR_PHY_NUM_BYTE_LANES; i++) {
+		if (params->all_lanes_active && (i != 0))
+			break;
+		if (!params->active_byte_lanes[i] && !params->all_lanes_active)
+			continue;
+
+		/* Reinitialize LFSR seed each iteration */
+		al_reg_write32(
+			&phy_regs->bistlsr,
+			BIST_LFSR_RESET_VAL);
+
+		/* Reset status */
+		al_reg_write32_masked(
+			&phy_regs->bistrr,
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BINST_MASK,
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BINST_RESET);
+
+		/* Run BIST */
+		al_reg_write32_masked(
+			&phy_regs->bistrr,
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BINST_MASK |
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BMODE |
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BINF |
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_NFAIL_MASK |
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BSONF |
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BDXEN |
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BACEN |
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BDPAT_MASK |
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BDXSEL_MASK,
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BINST_RUN |
+			mode |
+			(params->inf ? ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BINF : 0) |
+			(params->sonf ? ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BSONF : 0) |
+			(0 << ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_NFAIL_SHIFT) |
+			ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BDXEN |
+			pattern |
+			(params->all_lanes_active ?
+				ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BDXSEL_MASK :
+				(i << ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BDXSEL_SHIFT)));
+
+		al_data_memory_barrier();
+
+		/* Read BISTGSR for BIST done */
+		if (params->inf)
+			while (1) {
+				reg_val = al_reg_read32(&phy_regs->bistgsr);
+				if (params->sonf &&
+					((reg_val & ALPINE_V3_DWC_DDR_PHY_REGS_BISTGSR_BDONE) ==
+					 ALPINE_V3_DWC_DDR_PHY_REGS_BISTGSR_BDONE)) {
+					al_dbg(
+						"%s:%d: infinte bist run - failed "
+						"(byte lane %d)!\n",
+						__func__,
+						__LINE__,
+						i);
+					break;
+				}
+				if (!params->sonf && (reg_val &
+					(ALPINE_V3_DWC_DDR_PHY_REGS_BISTGSR_BACERR |
+					 ALPINE_V3_DWC_DDR_PHY_REGS_BISTGSR_BDXERR_MASK))) {
+					al_dbg(
+						"%s:%d: infinte bist run - failed "
+						"(byte lane %d)!\n",
+						__func__,
+						__LINE__,
+						i);
+				}
+				al_udelay(1);
+			}
+		else
+			err = al_ddr_phy_wait_for_bist_done(ddr_cfg, bist_err_status);
+		if (err) {
+			if (bist_err_status)
+				bist_err_status->lane_err = i;
+			al_dbg(
+				"%s:%d: al_ddr_phy_wait_for_bist_done failed "
+				"(byte lane %d)!\n",
+				__func__,
+				__LINE__,
+				i);
+			break;
+		}
+	}
+
+	/* stop BIST */
+	al_reg_write32_masked(
+		&phy_regs->bistrr,
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BINST_MASK,
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BINST_STOP);
+
+	al_data_memory_barrier();
+
+	/* Waiting BIST to stop */
+	err = al_ddr_phy_wait_for_bist_done(ddr_cfg, bist_err_status);
+	if (err)
+		al_dbg(
+			"%s:%d: al_ddr_phy_wait_for_bist_done failed\n",
+			__func__,
+			__LINE__);
+
+	al_reg_write32_masked(
+		&phy_regs->bistrr,
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BINST_MASK,
+		ALPINE_V3_DWC_DDR_PHY_REGS_BISTRR_BINST_NOP);
+
+
+	return err;
+}
