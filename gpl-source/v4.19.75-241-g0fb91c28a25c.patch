+	((idx) == 1) ? AL_PCIE_1_ECAM_BASE :	\
+	((idx) == 2) ? AL_PCIE_2_ECAM_BASE :	\
+	((idx) == 3) ? AL_PCIE_3_ECAM_BASE :	\
+	((idx) == 4) ? AL_PCIE_4_ECAM_BASE :	\
