+#define AL_ETH_V4_MAC_IOFIC_GROUP_B_CMAC_TX_UNDERFLOW_SB_SYNC_EDGE			AL_BIT(5)
+#define AL_ETH_V4_MAC_IOFIC_GROUP_B_CMAC_RX_OVERFLOW_SB_SYNC_EDGE			AL_BIT(6)
