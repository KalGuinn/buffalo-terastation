+#define AL_PCIE_SIZE(idx)	(\
+	((idx) == 0) ? AL_PCIE_0_SIZE :	\
+	((idx) == 1) ? AL_PCIE_1_SIZE :	\
+	((idx) == 2) ? AL_PCIE_2_SIZE :	\
+	((idx) == 3) ? AL_PCIE_3_SIZE :	\
+	((idx) == 4) ? AL_PCIE_4_SIZE :	\
+	((idx) == 5) ? AL_PCIE_5_SIZE :	\
+	((idx) == 6) ? AL_PCIE_6_SIZE :	\
+	((idx) == 7) ? AL_PCIE_7_SIZE :	\
+	0)
+
+#define AL_CORESIGHT_BASE	0xf4000000UL
