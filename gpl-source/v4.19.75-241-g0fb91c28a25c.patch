+int al_sbus_rom_download(
+	const struct al_sbus_obj	*obj)
+{
+	unsigned int mutex_user_idx = al_sbus_slave_addr_to_mutex_user_idx(AL_SBUS_ADDR_SBUS_CTRLR);
+	unsigned int timeout;
+	int err = 0;
+
+	al_assert(obj);
+	al_assert(obj->regs);
+
+	/* Lock SBUS master */
+	al_sbus_mutex_lock(obj, mutex_user_idx);
+
+	/* Download enable */
+	al_reg_write32_masked(&obj->regs->rom.ctrl, SBM_ROM_CTRL_ENABLE, SBM_ROM_CTRL_ENABLE);
+	/* Wait for download to start */
+	for (timeout = ROM_DL_START_TO_USEC; timeout; timeout--) {
+		if (al_reg_read32(&obj->regs->rom.ctrl) & SBM_ROM_CTRL_OUT_EN)
+			break;
+		al_udelay(1);
+	}
+	if (!timeout) {
+		al_err("%s: timeout waiting for download to begin!\n", __func__);
+		err = -ETIME;
+		goto done;
+	}
+	/* Wait for download to complete */
+	for (timeout = ROM_DL_DONE_TO_USEC; timeout; timeout--) {
+		if (!(al_reg_read32(&obj->regs->rom.ctrl) & SBM_ROM_CTRL_OUT_EN))
+			break;
+		al_udelay(1);
+	}
+	if (!timeout) {
+		al_err("%s: timeout waiting for download to complete!\n", __func__);
+		err = -ETIME;
+		goto done;
+	}
+
+done:
+	/* Unlock SBUS master */
+	al_sbus_mutex_unlock(obj, mutex_user_idx);
+
+	return err;
+}
+
+void al_sbus_lock(
+	const struct al_sbus_obj	*obj,
