+		(union al_ddr_ctrl_regs __iomem *)
+		ddr_cfg->ddr_ctrl_regs_base;
+
+	al_reg_write32_masked(&ctrl_regs->alpine_v3.umctl2_regs.crcparctl0,
+			DWC_DDR_UMCTL2_REGS_CRCPARCTL0_DFI_ALERT_ERR_CNT_CLR,
+			DWC_DDR_UMCTL2_REGS_CRCPARCTL0_DFI_ALERT_ERR_CNT_CLR);
+}
