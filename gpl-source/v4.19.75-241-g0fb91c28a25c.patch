+int al_sbus_master_fw_init(
+	const struct al_sbus_obj	*sbus,
+	const uint32_t			*fw,
+	unsigned int			fw_size)
+{
+	unsigned int receiver_addr = 0xfd;
+	unsigned int i;
+
+	al_assert(sbus);
+
+	if (!fw) {
+#if (AL_SBUS_MASTER_EXTERNAL_FW == 0)
+		al_assert(!fw_size);
+		fw = al_serdes_avg_fw_sbus_master;
+		fw_size = AL_ARR_SIZE(al_serdes_avg_fw_sbus_master);
+#else
+		al_err("%s: FW not provided!\n", __func__);
+		return -EINVAL;
+#endif
+	} else {
+		al_assert(fw_size);
+	}
+
+	/* Assert Spico reset */
+	al_sbus_write(sbus, receiver_addr, 0x01, AL_BIT(6) | AL_BIT(7), 1);
+	/* Deassert Spico reset, but keep it disabled */
+	al_sbus_write(sbus, receiver_addr, 0x01, AL_BIT(6) | 0, 1);
+	/* Assert IMEM override */
+	al_sbus_write(sbus, receiver_addr, 0x01, AL_BIT(6) | AL_BIT(9), 1);
+
+	al_sbus_lock(sbus, receiver_addr);
+
+	/*  Note: A delayed version of the write-enable signal is used to write data */
+	/*	into rom after address and data are set up.  This allows loading one */
+	/*	new word for each sbus write. */
+	for (i = 0; i < fw_size; i++) {
+		unsigned int k = (i % fw_size);
+		unsigned int sbus_data;
+
+		if (!(i % (1024 / sizeof(uint32_t))))
+			al_info("FW DL %u/%u\n", (unsigned int)(i * sizeof(uint32_t)),
+				(unsigned int)(sizeof(uint32_t) * fw_size));
+		sbus_data = (3 << 30) | swap32_from_le(fw[k]);
+
+		al_dbg("Sbus burst data is %x\n", sbus_data);
+		al_sbus_write_no_lock(sbus, receiver_addr, 0x14, sbus_data, 1);
+	}
+
+	al_sbus_unlock(sbus, receiver_addr);
+
+	/*
+	 * Pad with 0's - required for Verilog simulations, but may be bypassed when loading
+	 * firmware onto chip.
+	 */
+	al_sbus_write(sbus, receiver_addr, 0x14, 0xc000, 1);
+	al_sbus_write(sbus, receiver_addr, 0x14, 0xc000, 1);
+	al_sbus_write(sbus, receiver_addr, 0x14, 0xc000, 1);
+
+	/* IMEM override off */
+	al_sbus_write(sbus, receiver_addr, 0x01, AL_BIT(6) | 0, 1);
+	/* Turn ECC on */
+	al_sbus_write(sbus, receiver_addr, 0x16, 0x000c0000, 1);
+	/* Turn SPICO Enable on */
+	al_sbus_write(sbus, receiver_addr, 0x01, AL_BIT(6) | AL_BIT(8), 1);
+
+	return 0;
+}
+
+void al_sbus_master_fw_revision_print(
+	const struct al_sbus_obj	*sbus)
+{
+	unsigned int status;
+	unsigned int rev;
+	unsigned int bld;
+	unsigned int crc;
+	int err;
+
+	err = al_sbus_master_interrupt(sbus, SBUS_MASTER_INT_REV_GET_REG_NUM, 0, &status, &rev);
+	if (err || (status != 1))
+		rev = 0;
+	err = al_sbus_master_interrupt(sbus, SBUS_MASTER_INT_BLD_GET_REG_NUM, 0, &status, &bld);
+	if (err || (status != 1))
+		bld = 0;
+	err = al_sbus_master_interrupt(sbus, SBUS_MASTER_INT_CRC_CHECK_REG_NUM, 0, &status, &crc);
+	if (err || (status != 1))
+		crc = SBUS_MASTER_INT_CRC_CHECK_VAL_NA;
+
+	al_print("SBUS master FW rev %02x bld %02x crc %s\n", rev, bld,
+		crc == SBUS_MASTER_INT_CRC_CHECK_VAL_VALID ? "Ok" :
+		(crc == SBUS_MASTER_INT_CRC_CHECK_VAL_FAIL ? "Failed" : "N/A"));
+}
+
+int al_sbus_master_interrupt(
+	const struct al_sbus_obj	*sbus,
+	unsigned int			code,
+	unsigned int			data,
+	unsigned int			*res_status,
+	unsigned int			*res_data)
+{
+	unsigned int receiver_addr = 0xfd;
+	unsigned int reg_val;
+	int err;
+
+	al_assert(sbus);
+	al_assert(res_status);
+	al_assert(res_data);
+
+	al_sbus_write(sbus, receiver_addr, 0x02, (data << 16) | code, 1);
+	err = al_sbus_read(sbus, receiver_addr, 0x07, &reg_val);
+	if (err)
+		return err;
+	al_sbus_write(sbus, receiver_addr, 0x07, reg_val | 1, 1);
+	al_sbus_write(sbus, receiver_addr, 0x07, reg_val, 1);
+
+	do {
+		err = al_sbus_read(sbus, receiver_addr, 0x08, &reg_val);
+		if (err)
+			return err;
+	} while ((reg_val & AL_BIT(15)) && (!(reg_val & 0x7fff)));
+
+	*res_status = reg_val & 0x7fff;
+	*res_data = reg_val >> 16;
+
+	return 0;
+}
