+void al_mod_udma_regs_print(struct al_mod_udma *udma, unsigned int mask)
+{
+	uint32_t i;
+
+	if (!udma)
+		return;
+
+	if (udma->type == UDMA_TX) {
+		if (mask & AL_UDMA_DEBUG_AXI)
+			al_mod_udma_regs_m2s_axi_print(udma);
+		if (mask & AL_UDMA_DEBUG_GENERAL)
+			al_mod_udma_regs_m2s_general_print(udma);
+		if (mask & AL_UDMA_DEBUG_READ)
+			al_mod_udma_regs_m2s_rd_print(udma);
+		if (mask & AL_UDMA_DEBUG_DWRR)
+			al_mod_udma_regs_m2s_dwrr_print(udma);
+		if (mask & AL_UDMA_DEBUG_RATE_LIMITER)
+			al_mod_udma_regs_m2s_rate_limiter_print(udma);
+		if (mask & AL_UDMA_DEBUG_STREAM_RATE_LIMITER)
+			al_mod_udma_regs_m2s_stream_rate_limiter_print(udma);
+		if (mask & AL_UDMA_DEBUG_COMP)
+			al_mod_udma_regs_m2s_comp_print(udma);
+		if (mask & AL_UDMA_DEBUG_STAT)
+			al_mod_udma_regs_m2s_stat_print(udma);
+		if (mask & AL_UDMA_DEBUG_FEATURE)
+			al_mod_udma_regs_m2s_feature_print(udma);
+		for (i = 0; i < udma->num_of_queues; i++) {
+			if (mask & AL_UDMA_DEBUG_QUEUE(i))
+				al_mod_udma_regs_m2s_q_print(udma, i);
+		}
+	} else {
+		if (mask & AL_UDMA_DEBUG_AXI)
+			al_mod_udma_regs_s2m_axi_print(udma);
+		if (mask & AL_UDMA_DEBUG_GENERAL)
+			al_mod_udma_regs_s2m_general_print(udma);
+		if (mask & AL_UDMA_DEBUG_READ)
+			al_mod_udma_regs_s2m_rd_print(udma);
+		if (mask & AL_UDMA_DEBUG_WRITE)
+			al_mod_udma_regs_s2m_wr_print(udma);
+		if (mask & AL_UDMA_DEBUG_COMP)
+			al_mod_udma_regs_s2m_comp_print(udma);
+		if (mask & AL_UDMA_DEBUG_STAT)
+			al_mod_udma_regs_s2m_stat_print(udma);
+		if (mask & AL_UDMA_DEBUG_FEATURE)
+			al_mod_udma_regs_s2m_feature_print(udma);
+		for (i = 0; i < udma->num_of_queues; i++) {
+			if (mask & AL_UDMA_DEBUG_QUEUE(i))
+				al_mod_udma_regs_s2m_q_print(udma, i);
+		}
+	}
+}
