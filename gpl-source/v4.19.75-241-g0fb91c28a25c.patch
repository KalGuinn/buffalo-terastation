+/******************************************************************************/
+int al_nand_dev_is_ready(
+	struct al_nand_ctrl_obj	*obj)
+{
+	int is_ready;
+	uint32_t reg_val;
+
+	al_assert(obj);
+
+	reg_val = al_reg_read32(&obj->regs_base->rdy_busy_status_reg);
+
+	if (0 == (reg_val & (1 << obj->current_dev_index)))
+		is_ready = 0;
+	else
+		is_ready = 1;
+
+	return is_ready;
+}
