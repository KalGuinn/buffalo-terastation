-static void buffalo_firmware_cmdline_process(void)
-{
-	int i;
-
-	if ( cmdline_done == 1 ) return;
-	for (i = 0; i < ARRAY_SIZE(cmdline_opts); i ++) {
-		char *p, *pe;
-
-		if (!isalpha(cmdline_opts[i].value[0])) {
-			memset(cmdline_opts[i].value, 0, CMDLINE_VALSIZE);
-			p = strstr(saved_command_line, cmdline_opts[i].key);
-			if (p != NULL) {
-				p += strlen(cmdline_opts[i].key);
-				pe = strstr(p, " ");
-
-				if ((pe != NULL) && ((pe - p) < CMDLINE_VALSIZE)){
-					strncpy(cmdline_opts[i].value, p, pe - p);
-				}
-				else {
-					strncpy(cmdline_opts[i].value, p, CMDLINE_VALSIZE);
-				}
-			}
-			else {
-				sprintf(cmdline_opts[i].value, "%s",
-					cmdline_opts[i].default_val);
-			}
-		}
-	}
-	cmdline_done = 1;
-	return;
-}
