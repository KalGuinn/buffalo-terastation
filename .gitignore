# ===========================================
# Buffalo TeraStation - Git Ignore Rules
# Strategy: track text/config only, no binaries
# ===========================================

# --- Firmware archives ---
*.zip
*.dmg
*.dmg.zip

# --- Firmware images ---
*.img
*.bin
*.bin.enc

# --- Other binaries ---
*.exe
*.ko
*.tar.gz

# --- Extracted firmware directories (huge) ---
firmware/win298/
firmware/win308/
firmware/rootfs/

# --- Extracted kernel source (893MB+) ---
gpl-source/linux-4.19.75/

# --- Working kernel source and build output ---
kernel/
out/

# --- macOS ---
.DS_Store

# --- Claude Code ---
.claude/settings.local.json
.claude/worktrees/
notes/claude_setup_recommendations.md
notes/action_plan_harness_improvements.md

# --- Local archives (firmware ZIPs go in firmware/archives/, not tracked) ---
firmware/archives/

# --- Local working artifacts ---
*.log
__pycache__/
*.pyc
venv/
node_modules/
.env
.env.*

# ===========================================
# Explicit allowances (override ignores above)
# ===========================================

# Device tree source and blobs (small, 36-44KB)
!*.dts
!*.dtsi
!*.dtb

# Documentation
!*.md

# Scripts
!*.sh

# Patches
!*.patch

# Specific firmware metadata files
!firmware/checksums.sha256
!firmware/download.sh
!firmware/README.md

# Project files
!CLAUDE.md
!Makefile
!.devcontainer/
