						tx {
							override = "disabled";
						};
					};
				};

				group1 {
					interface = "sata";
					ref-clock = "100Mhz";
					active-lanes = <0x00 0x01 0x02 0x03>;
					inv-tx-lanes;
					inv-rx-lanes;
					ssc = "disabled";

					lane_0_params {

						rx {
							override = "enabled";
							dcgain = <0x00>;
							dfe_3db_freq = <0x07>;
							dfe_gain = <0x00>;
							dfe_1st_tap_ctrl = <0x00>;
							dfe_2nd_tap_ctrl = <0x08>;
							dfe_3rd_tap_ctrl = <0x00>;
							dfe_4th_tap_ctrl = <0x08>;
							low_freq_agc_gain = <0x07>;
							high_freq_agc_boost = <0x00>;
							precal_code_sel = <0x00>;
						};

						tx {
							override = "enabled";
							amp = <0x01>;
							total_driver_units = <0x13>;
							post_emph = <0x02>;
							pre_emph = <0x00>;
							slew_rate = <0x00>;
						};

						rx@820D {
							nas-pid = <0x2051>;
							status = "disabled";
							override = "enabled";
							dcgain = <0x00>;
							dfe_3db_freq = <0x05>;
							dfe_gain = <0x00>;
							dfe_1st_tap_ctrl = <0x00>;
							dfe_2nd_tap_ctrl = <0x08>;
							dfe_3rd_tap_ctrl = <0x00>;
							dfe_4th_tap_ctrl = <0x08>;
							low_freq_agc_gain = <0x05>;
							high_freq_agc_boost = <0x00>;
							precal_code_sel = <0x00>;
						};

						tx@820D {
							nas-pid = <0x2051>;
							status = "disabled";
							override = "enabled";
							amp = <0x05>;
							total_driver_units = <0x13>;
							post_emph = <0x03>;
							pre_emph = <0x00>;
							slew_rate = <0x00>;
						};

						rx@620D {
							nas-pid = <0x2050>;
							status = "disabled";
							override = "enabled";
							dcgain = <0x00>;
							dfe_3db_freq = <0x07>;
							dfe_gain = <0x00>;
							dfe_1st_tap_ctrl = <0x00>;
							dfe_2nd_tap_ctrl = <0x08>;
							dfe_3rd_tap_ctrl = <0x00>;
							dfe_4th_tap_ctrl = <0x08>;
							low_freq_agc_gain = <0x05>;
							high_freq_agc_boost = <0x00>;
							precal_code_sel = <0x00>;
