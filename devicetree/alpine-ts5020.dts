/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "annapurna-labs,alpine";
	clock-ranges;
	version = "1.0";
	model = [42 55 46 46 41 4c 4f 20 54 53 35 30 32 30 ef bc 88 54 53 35 4b 32 41 4c 56 32 2d 41 41 ef bc 89 42 6f 61 72 64 00];

	chosen {
	};

	aliases {
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	psci {
		compatible = "arm,psci-0.2", "arm,psci";
		method = "smc";
		cpu_on = <0x84000003>;
		cpu_off = <0x84000002>;
		cpu_suspend = <0x84000001>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		pcie_core_cfg_mem_reserved {
			reg = <0x00 0x00 0x00 0x100000>;
			no-map;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x03>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			i-cache-size = <0xc000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			next-level-cache = <0x04>;
			linux,phandle = <0x05>;
			phandle = <0x05>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x03>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			i-cache-size = <0xc000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			next-level-cache = <0x04>;
			linux,phandle = <0x06>;
			phandle = <0x06>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x03>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			i-cache-size = <0xc000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			next-level-cache = <0x04>;
			linux,phandle = <0x07>;
			phandle = <0x07>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x03>;
			enable-method = "psci";
			cpu-idle-states = <0x03>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			i-cache-size = <0xc000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			next-level-cache = <0x04>;
			linux,phandle = <0x08>;
			phandle = <0x08>;
		};

		cache@0 {
			compatible = "cache";
			cache-size = <0x200000>;
			cache-line-size = <0x40>;
			cache-sets = <0x800>;
			cache-level = <0x02>;
			linux,phandle = <0x04>;
			phandle = <0x04>;
		};

		idle-states {

			cpu-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x0a>;
				exit-latency-us = <0x0a>;
				min-residency-us = <0x3e8>;
				linux,phandle = <0x03>;
				phandle = <0x03>;
			};
		};
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		interrupt-parent = <0x01>;
		ranges;

		arch-timer {
			compatible = "arm,armv8-timer";
			interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
			clock-frequency = <0x2faf080>;
		};

		gic_main {
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x03>;
			#size-cells = <0x00>;
			#address-cells = <0x00>;
			interrupt-controller;
			reg = <0x00 0xf0200000 0x00 0x10000 0x00 0xf0280000 0x00 0x200000 0x00 0xf0100000 0x00 0x2000 0x00 0xf0110000 0x00 0x2000 0x00 0xf0120000 0x00 0x2000>;
			interrupts = <0x01 0x09 0xf04>;
			linux,phandle = <0x01>;
			phandle = <0x01>;
		};

		ccu {
			compatible = "annapurna-labs,al-ccu";
			reg = <0x00 0xf0090000 0x00 0x10000>;
			io_coherency = <0x01>;
		};

		msix {
			compatible = "annapurna-labs,alpine-msix", "al,alpine-msix";
			reg = <0x00 0xfbe00000 0x00 0x100000>;
			interrupts = <0x00 0xa0 0x01 0x00 0x13f 0x01>;
			interrupt-controller;
			msi-controller;
			al,msi-base-spi = <0xa1>;
			al,msi-num-spis = <0x9e>;
			interrupt-parent = <0x01>;
			linux,phandle = <0x02>;
			phandle = <0x02>;
		};

		pmu {
			compatible = "arm,armv8-pmuv3";
			interrupts = <0x00 0x68 0x04 0x00 0x69 0x04 0x00 0x6a 0x04 0x00 0x6b 0x04>;
			interrupt-affinity = <0x05 0x06 0x07 0x08>;
		};

		nb_service {
			compatible = "annapurna-labs,al-nb-service", "al,alpine-sysfabric-service", "syscon";
			reg = <0x00 0xf0070000 0x00 0x10000>;
			interrupts = <0x00 0x60 0x04 0x00 0x61 0x04 0x00 0x62 0x04 0x00 0x63 0x04>;
		};

		al-l1-edac {
			compatible = "amazon,al-l1-edac";
		};

		al-l2-edac-cluster0 {
			compatible = "amazon,al-l2-edac";
			l2-cache = <0x04>;
		};

		pbs {
			compatible = "annapurna-labs,al-pbs";
			reg = <0x00 0xfd8a8000 0x00 0x1000>;
			interrupts = <0x00 0x00 0x04>;
		};

		tdm {
			compatible = "annapurna-labs,al-tdm";
			reg = <0x00 0xf2300000 0x00 0x11000>;
		};

		timer0 {
			compatible = "arm,sp804", "arm,primecell";
			reg = <0x00 0xfd890000 0x00 0x1000>;
			interrupts = <0x00 0x09 0x04>;
			clocks = <0x09>;
			clock-names = "sbclk";
			status = "disabled";
		};

		timer1 {
			compatible = "arm,sp804", "arm,primecell";
			reg = <0x00 0xfd891000 0x00 0x1000>;
			interrupts = <0x00 0x0a 0x04>;
			clocks = <0x09>;
			clock-names = "sbclk";
			status = "disabled";
		};

		timer2 {
			compatible = "arm,sp804", "arm,primecell";
			reg = <0x00 0xfd892000 0x00 0x1000>;
			interrupts = <0x00 0x0b 0x04>;
			clocks = <0x09>;
			clock-names = "sbclk";
			status = "disabled";
		};

		timer3 {
			compatible = "arm,sp804", "arm,primecell";
			reg = <0x00 0xfd893000 0x00 0x1000>;
			interrupts = <0x00 0x0c 0x04>;
			clocks = <0x09>;
			clock-names = "sbclk";
			status = "disabled";
		};

		wdt0 {
			compatible = "arm,sp805", "arm,primecell";
			reg = <0x00 0xfd88c000 0x00 0x1000>;
			interrupts = <0x00 0x0d 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			linux,phandle = <0x0c>;
			phandle = <0x0c>;
		};

		wdt1 {
			compatible = "arm,sp805", "arm,primecell";
			reg = <0x00 0xfd88d000 0x00 0x1000>;
			interrupts = <0x00 0x0e 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			status = "disabled";
		};

		wdt2 {
			compatible = "arm,sp805", "arm,primecell";
			reg = <0x00 0xfd88e000 0x00 0x1000>;
			interrupts = <0x00 0x0f 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			status = "disabled";
		};

		wdt3 {
			compatible = "arm,sp805", "arm,primecell";
			reg = <0x00 0xfd88f000 0x00 0x1000>;
			interrupts = <0x00 0x10 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			status = "disabled";
		};

		i2c-pld {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "snps,designware-i2c";
			reg = <0x00 0xfd880000 0x00 0x1000>;
			interrupts = <0x00 0x15 0x04>;
			clocks = <0x09>;
			clock-frequency = <0x186a0>;
			i2c-ss-scl-hcnt-raw = <0x855>;
			i2c-ss-scl-lcnt-raw = <0xb0b>;
			i2c-fs-scl-hcnt-raw = <0x19d>;
			i2c-fs-scl-lcnt-raw = <0x320>;
			i2c-hs-scl-hcnt-raw = <0xf3>;
			i2c-hs-scl-lcnt-raw = <0x198>;

			eeprom@57 {
				compatible = "24c64";
				reg = <0x57>;
			};

			rtc@32 {
				compatible = "epson,rx8010";
				reg = <0x32>;
			};
		};

		i2c-gen {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "snps,designware-i2c";
			reg = <0x00 0xfd894000 0x00 0x1000>;
			interrupts = <0x00 0x08 0x04>;
			clocks = <0x09>;
			clock-frequency = <0x186a0>;
			i2c-ss-scl-hcnt-raw = <0x855>;
			i2c-ss-scl-lcnt-raw = <0xb0b>;
			i2c-fs-scl-hcnt-raw = <0x19d>;
			i2c-fs-scl-lcnt-raw = <0x320>;
			i2c-hs-scl-hcnt-raw = <0xf3>;
			i2c-hs-scl-lcnt-raw = <0x198>;
			status = "disabled";
		};

		gpio0 {
			#gpio-cells = <0x02>;
			compatible = "arm,pl061", "arm,primecell";
			gpio-controller;
			reg = <0x00 0xfd887000 0x00 0x1000>;
			interrupts = <0x00 0x02 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			baseidx = <0x1f8>;
		};

		gpio1 {
			#gpio-cells = <0x02>;
			compatible = "arm,pl061", "arm,primecell";
			gpio-controller;
			reg = <0x00 0xfd888000 0x00 0x1000>;
			interrupts = <0x00 0x03 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			baseidx = <0x1f0>;
		};

		gpio2 {
			#gpio-cells = <0x02>;
			compatible = "arm,pl061", "arm,primecell";
			gpio-controller;
			reg = <0x00 0xfd889000 0x00 0x1000>;
			interrupts = <0x00 0x04 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			baseidx = <0x1e8>;
			linux,phandle = <0x14>;
			phandle = <0x14>;
		};

		gpio3 {
			#gpio-cells = <0x02>;
			compatible = "arm,pl061", "arm,primecell";
			gpio-controller;
			reg = <0x00 0xfd88a000 0x00 0x1000>;
			interrupts = <0x00 0x05 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			baseidx = <0x1e0>;
			linux,phandle = <0x15>;
			phandle = <0x15>;
		};

		gpio4 {
			#gpio-cells = <0x02>;
			compatible = "arm,pl061", "arm,primecell";
			gpio-controller;
			reg = <0x00 0xfd88b000 0x00 0x1000>;
			interrupts = <0x00 0x06 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			baseidx = <0x1d8>;
		};

		gpio5 {
			#gpio-cells = <0x02>;
			compatible = "arm,pl061", "arm,primecell";
			gpio-controller;
			reg = <0x00 0xfd897000 0x00 0x1000>;
			interrupts = <0x00 0x07 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			baseidx = <0x1d0>;
		};

		sgpo {
			#gpio-cells = <0x02>;
			compatible = "annapurna-labs,alpine-sgpo";
			gpio-controller;
			reg = <0x00 0xfd8b4000 0x00 0x5000>;
			baseidx = <0x30>;
		};

		uart0 {
			compatible = "ns16550a";
			device_type = "serial";
			reg = <0x00 0xfd883000 0x00 0x1000>;
			clock-frequency = <0x00>;
			interrupts = <0x00 0x11 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
		};

		uart1 {
			compatible = "ns16550a";
			device_type = "serial";
			reg = <0x00 0xfd884000 0x00 0x1000>;
			clock-frequency = <0x00>;
			interrupts = <0x00 0x12 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
		};

		uart2 {
			compatible = "ns16550a";
			device_type = "serial";
			reg = <0x00 0xfd885000 0x00 0x1000>;
			clock-frequency = <0x00>;
			interrupts = <0x00 0x13 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			status = "disabled";
		};

		uart3 {
			compatible = "ns16550a";
			device_type = "serial";
			reg = <0x00 0xfd886000 0x00 0x1000>;
			clock-frequency = <0x00>;
			interrupts = <0x00 0x14 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			status = "disabled";
		};

		interrupt-controller@0xf0070000 {
			compatible = "amazon,al-system-fabric";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			reg = <0x00 0xf0070000 0x00 0x10000>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x60 0x04>;
			linux,phandle = <0x0a>;
			phandle = <0x0a>;
		};

		al_mc_edac {
			compatible = "amazon,al-mc-edac";
			reg = <0x00 0xf0080000 0x00 0x10000>;
			interrupt-parent = <0x0a>;
			interrupt-names = "ue";
			interrupts = <0x14 0x04>;
		};

		interrupt-controller@0xf0070094 {
			compatible = "amazon,al-system-error";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			reg = <0x00 0xf0070094 0x00 0x08>;
			interrupt-parent = <0x0a>;
			interrupts = <0x17 0x04>;
			linux,phandle = <0x0b>;
			phandle = <0x0b>;
		};

		fifo_full_port_0_error {
			compatible = "amazon,al-irq-event-handler-info";
			interrupt-parent = <0x0b>;
			interrupts = <0x10 0x04>;
		};

		fifo_full_port_1_error {
			compatible = "amazon,al-irq-event-handler-info";
			interrupt-parent = <0x0b>;
			interrupts = <0x11 0x04>;
		};

		read_latch_timeout_port_1_error {
			compatible = "amazon,al-irq-event-handler-info";
			interrupt-parent = <0x0b>;
			interrupts = <0x01 0x04>;
		};

		read_latch_timeout_port_0_error {
			compatible = "amazon,al-irq-event-handler-info";
			interrupt-parent = <0x0b>;
			interrupts = <0x00 0x04>;
		};

		al_pos {
			compatible = "amazon,al-pos";
			reg = <0x00 0xf0070084 0x00 0x08>;
			interrupt-parent = <0x0b>;
			interrupts = <0x08 0x04>;
		};

		eth0 {
			reg = <0x00 0xfc000000 0x00 0x1000 0x00 0xfc018000 0x00 0x1000 0x00 0xfc005000 0x00 0x10000>;
			interrupts = <0x00 0x3d 0x04>;
		};

		eth1 {
			reg = <0x00 0xfc100000 0x00 0x1000>;
			interrupts = <0x00 0x3e 0x04>;
		};

		eth2 {
			reg = <0x00 0xfc200000 0x00 0x1000 0x00 0xfc218000 0x00 0x1000 0x00 0xfc205000 0x00 0x10000>;
			interrupts = <0x00 0x3f 0x04>;
		};

		eth3 {
			reg = <0x00 0xfc300000 0x00 0x1000>;
			interrupts = <0x00 0x40 0x04>;
		};

		reboot {
			compatible = "annapurna-labs,alpine-reboot";
			wdt-parent = <0x0c>;
		};

		pcie-internal {
			compatible = "annapurna-labs,alpine-internal-pcie";
			device_type = "pci";
			#size-cells = <0x02>;
			#address-cells = <0x03>;
			#interrupt-cells = <0x01>;
			reg = <0x00 0xfbc00000 0x00 0x100000 0x00 0xfc300000 0x00 0x5080>;
			reg-names = "ecam", "unit-adapter-eth-port3";
			interrupt-parent = <0x01>;
			interrupt-map-mask = <0xf800 0x00 0x00 0x07>;
			interrupt-map = <0x4000 0x00 0x00 0x01 0x01 0x00 0x35 0x04 0x4800 0x00 0x00 0x01 0x01 0x00 0x36 0x04>;
			msi-parent = <0x02>;
			ranges = <0x2000000 0x00 0xfe000000 0x00 0xfe000000 0x00 0x1000000>;
			bus-range = <0x00 0x00>;
		};

		iofic_pcie_external0 {
			#interrupt-cells = <0x01>;
			compatible = "al,alpine-iofic";
			reg = <0x00 0xfd803000 0x00 0x1000>;
			interrupt-controller;
			interrupts-in = <0x08>;
			interrupts = <0x00 0x2f 0x04>;
			interrupt-parent = <0x01>;
			linux,phandle = <0x0d>;
			phandle = <0x0d>;
		};

		pcie-external0 {
			compatible = "annapurna-labs,alpine-external-pcie";
			reg = <0x00 0xfd800000 0x00 0x20000>;
			device_type = "pci";
			#size-cells = <0x02>;
			#address-cells = <0x03>;
			#interrupt-cells = <0x01>;
			reg-names = "ecam";
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-map = <0x00 0x00 0x00 0x01 0x0d 0x07 0x00 0x00 0x00 0x02 0x0d 0x06 0x00 0x00 0x00 0x03 0x0d 0x05 0x00 0x00 0x00 0x04 0x0d 0x04>;
			msi-parent = <0x02>;
			cfg-space-offset = <0x10000>;
			ranges = <0x00 0x00 0xfb600000 0x00 0xfb600000 0x00 0x100000 0x1000000 0x00 0x10000 0x00 0xc0000000 0x00 0x10000 0x2000000 0x00 0xc0010000 0x00 0xc0010000 0x00 0x7ff0000>;
			bus-range = <0x00 0xff>;
		};

		iofic_pcie_external1 {
			#interrupt-cells = <0x01>;
			compatible = "al,alpine-iofic";
			reg = <0x00 0xfd821400 0x00 0x1000>;
			interrupt-controller;
			interrupts-in = <0x08>;
			interrupts = <0x00 0x30 0x04>;
			interrupt-parent = <0x01>;
			linux,phandle = <0x0e>;
			phandle = <0x0e>;
		};

		pcie-external1 {
			compatible = "annapurna-labs,alpine-external-pcie";
			reg = <0x00 0xfd820000 0x00 0x20000>;
			device_type = "pci";
			#size-cells = <0x02>;
			#address-cells = <0x03>;
			#interrupt-cells = <0x01>;
			reg-names = "ecam";
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-map = <0x00 0x00 0x00 0x01 0x0e 0x07 0x00 0x00 0x00 0x02 0x0e 0x06 0x00 0x00 0x00 0x03 0x0e 0x05 0x00 0x00 0x00 0x04 0x0e 0x04>;
			msi-parent = <0x02>;
			cfg-space-offset = <0x2000>;
			ranges = <0x00 0x00 0xfb700000 0x00 0xfb700000 0x00 0x100000 0x1000000 0x00 0x20000 0x00 0xc8000000 0x00 0x10000 0x2000000 0x00 0xc8010000 0x00 0xc8010000 0x00 0x7ff0000>;
			bus-range = <0x00 0xff>;
		};

		iofic_pcie_external2 {
			#interrupt-cells = <0x01>;
			compatible = "al,alpine-iofic";
			reg = <0x00 0xfd841400 0x00 0x1000>;
			interrupt-controller;
			interrupts-in = <0x08>;
			interrupts = <0x00 0x31 0x04>;
			interrupt-parent = <0x01>;
			linux,phandle = <0x0f>;
			phandle = <0x0f>;
		};

		pcie-external2 {
			compatible = "annapurna-labs,alpine-external-pcie";
			reg = <0x00 0xfd840000 0x00 0x20000>;
			device_type = "pci";
			#size-cells = <0x02>;
			#address-cells = <0x03>;
			#interrupt-cells = <0x01>;
			reg-names = "ecam";
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
