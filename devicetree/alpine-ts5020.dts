							phy_rout_pu_1 = <0x0b>;
							phy_rout_pd_1 = <0x0d>;
							phy_pu_odt_1 = <0x07>;
							host_init_vref = <0x28>;
							vrefdq = <0x19>;
						};
					};

					dimm0 {
						status = "enabled";
						on-board = <0x00>;

						spd {
							i2c-addr = <0x54>;
							offset = <0x00>;
