						tx@620D {
							nas-pid = <0x2050>;
							status = "disabled";
							override = "enabled";
							amp = <0x03>;
							total_driver_units = <0x13>;
							post_emph = <0x02>;
							pre_emph = <0x00>;
							slew_rate = <0x00>;
						};

						rx@DIS {
							nas-pid = <0x2048 0x2049 0x2052>;
							status = "disabled";
							override = "disabled";
						};

						tx@DIS {
							nas-pid = <0x2048 0x2049 0x2052>;
							status = "disabled";
							override = "disabled";
