/*
 * Device Tree Source for Buffalo TeraStation TS5020
 * Based on Annapurna Labs Alpine V2 SoC
 *
 * Reconstructed from:
 *   - alpine-v2.dtsi (upstream)
 *   - buffalo_ts5020_defconfig
 *   - Annapurna Labs SDK patch (v4.19.75-241-g0fb91c28a25c.patch)
 *   - Buffalo platform patch (linux-4.19.75_buffalo.patch)
 *   - micon_v3 driver source
 *
 * STATUS: DRAFT - addresses/IRQs marked TODO need verification
 *         from running hardware or U-Boot environment.
 */

/dts-v1/;

#include "alpine-v2.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Buffalo TeraStation TS5020";
	compatible = "buffalo,ts5020", "al,alpine-v2";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		/* TODO: Actual memory size - likely 4GB or 8GB ECC DDR4 */
		reg = <0x0 0x00000000 0x0 0x80000000>;  /* 2GB placeholder */
	};

	/*
	 * Buffalo Microcontroller (Micon V3)
	 * Connected via UART1 (/dev/ttyS1) at 115200 baud
	 * Handles: power off, reboot, beep, status LEDs
	 * Protocol: ESC init, command, CR delimiter, echo-back, OK/NG response
	 *
	 * Not a DT device - driven by kernel module opening /dev/ttyS1
	 */

	gpio-keys {
		compatible = "gpio-keys";
		/* TODO: Determine actual GPIO numbers from board */

		/* Power button - likely directly wired or via micon */
		/*
		power-button {
			label = "Power Button";
			linux,code = <116>;
			gpios = <&gpio0 TODO GPIO_ACTIVE_LOW>;
		};
		*/
	};

	gpio-leds {
		compatible = "gpio-leds";
		/* TODO: Determine actual GPIO pin assignments
		 *
		 * TS5020 typically has:
		 *   - Power LED (white/orange)
		 *   - Info/Error LED (orange)
		 *   - Per-disk activity LEDs
		 *   - LAN LEDs (on PHY/switch typically)
		 *
		 * Many LEDs may be controlled via micon or PCA953x GPIO expander
		 */
	};
};

/* ====== UART ====== */

/* Console UART */
&uart0 {
	status = "okay";
};

/* Micon V3 microcontroller UART - 115200 8N1 */
&uart1 {
	status = "okay";
};

/* Additional UARTs - enable if needed */
/* &uart2 { status = "okay"; }; */
/* &uart3 { status = "okay"; }; */

/* ====== SoC io-fabric additions ====== */
&soc {

	/* ====== I2C ====== */

	i2c0: i2c@fd880000 {
		compatible = "snps,designware-i2c";
		reg = <0x0 0xfd880000 0x0 0x1000>;
		/* TODO: interrupt number */
		interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>; /* TODO */
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		/* I2C mux - PCA9548 or similar */
		i2c_mux: i2c-mux@70 {
			compatible = "nxp,pca9548";
			reg = <0x70>;  /* TODO: verify address */
			#address-cells = <1>;
			#size-cells = <0>;

			i2c@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;

				/* RTC - Epson RX8010SJ (primary per README) */
				rtc@32 {
					compatible = "epson,rx8010";
					reg = <0x32>;
				};
			};

			i2c@1 {
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;

				/* Temperature sensor - LM75 */
				temp_sensor: lm75@48 {
					compatible = "national,lm75";
					reg = <0x48>;  /* TODO: verify */
				};
			};

			i2c@2 {
				reg = <2>;
				#address-cells = <1>;
				#size-cells = <0>;

				/* EEPROM - board configuration */
				eeprom@50 {
					compatible = "atmel,24c256";
					reg = <0x50>;  /* TODO: verify size/addr */
				};
			};

			i2c@3 {
				reg = <3>;
				#address-cells = <1>;
				#size-cells = <0>;

				/* GPIO expander - PCA9555 for LEDs/buttons */
				gpio_exp: gpio@20 {
					compatible = "nxp,pca9555";
					reg = <0x20>;  /* TODO: verify */
					gpio-controller;
					#gpio-cells = <2>;
					interrupt-controller;
					#interrupt-cells = <2>;
				};
			};

			i2c@4 {
				reg = <4>;
				#address-cells = <1>;
				#size-cells = <0>;

				/* TPM - Infineon SLB9635/SLB9645 */
				tpm@20 {
					compatible = "infineon,slb9645tt";
					reg = <0x20>;  /* TODO: verify */
				};
			};
		};
	};

	/* General purpose I2C (PBS + 0x14000) */
	i2c1: i2c@fd894000 {
		compatible = "snps,designware-i2c";
		reg = <0x0 0xfd894000 0x0 0x1000>;
		/* TODO: interrupt number */
		interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>; /* TODO */
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
	};

	/* ====== SPI ====== */

	spi0: spi@fd882000 {
		compatible = "snps,dw-apb-ssi";
		reg = <0x0 0xfd882000 0x0 0x1000>;
		/* TODO: interrupt, clocks */
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		/* SPI NOR boot flash */
		flash@0 {
			compatible = "jedec,spi-nor";
			reg = <0>;
			/* TODO: spi-max-frequency */
			spi-max-frequency = <25000000>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;
				/* TODO: partition layout from mtdparts or U-Boot env */
			};
		};
	};

	/* ====== GPIO ====== */

	gpio0: gpio@fd890000 {
		compatible = "snps,dw-apb-gpio";
		reg = <0x0 0xfd890000 0x0 0x1000>;  /* TODO: verify */
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		porta: gpio-port@0 {
			compatible = "snps,dw-apb-gpio-port";
			reg = <0>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			/* TODO: ngpios, interrupts */
		};
	};

	/* ====== Watchdog ====== */

	watchdog@fd890000 {
		compatible = "arm,sp805", "arm,primecell";
		/* TODO: actual WDT register address
		 * Formula: AL_WD_BASE(idx) = PBS + WD_offset
		 */
		reg = <0x0 0xfd890000 0x0 0x1000>;  /* TODO: verify */
		/* TODO: interrupt */
		clocks = <&sbclk>;
		clock-names = "apb_pclk";
		status = "okay";
	};

	/* ====== Thermal ====== */

	thermal_sensor: thermal@fd8a0000 {
		/* TODO: actual register address from HAL
		 * al_hal_thermal_sensor.c uses a handle-based init
		 */
		compatible = "amazon,alpine-v2-thermal";  /* TODO: verify compat */
		reg = <0x0 0xfd8a0000 0x0 0x1000>;  /* TODO */
		status = "okay";
	};

	/* ====== SRAM ====== */

	sram@fd8c0000 {
		compatible = "mmio-sram";
		reg = <0x0 0xfd8c0000 0x0 0x10000>;  /* PBS + 0x40000 */
	};

	/* ====== NB Service (reboot) ====== */

	nb_service: syscon@f0070000 {
		compatible = "syscon", "simple-mfd";
		reg = <0x0 0xf0070000 0x0 0x10000>;

		reboot {
			compatible = "syscon-reboot";
			/* TODO: offset and value */
		};
	};

};

/* ====== PCI internal: SATA, Ethernet, SSM (Crypto/RAID) ====== */
/*
 * On Alpine V2, SATA, Ethernet, and SSM (crypto/RAID DMA) are
 * all on the internal PCIe bus. They appear as PCI devices and
 * are matched by PCI vendor/device ID, not DT compatible strings.
 *
 * Key PCI devices:
 *   1c36:0031 - AHCI SATA controller
 *   1c36:xxxx - AL Ethernet (NET_AL_ETH)
 *   1c36:xxxx - SSM crypto/RAID engine
 *
 * The internal PCI host bridge is already in the DTSI at 0xfbc00000.
 * The SATA interrupt mapping in the DTSI maps:
 *   device 8 (SATA0) -> GIC SPI 53
 *   device 9 (SATA1) -> GIC SPI 54
 *
 * Additional PCIe devices (external slots):
 *   - Realtek R8125 2.5GbE NIC (PCI device, CONFIG_R8125=y)
 */

/* ====== NAND flash ====== */
/*
 * AL NAND controller - CONFIG_MTD_NAND_AL=y
 * TODO: Register base address not determined.
 * Likely in PBS address space. The HAL uses al_nand_init() with
 * a register base pointer.
 *
 * nand: nand@XXXXXXXX {
 *     compatible = "annapurna-labs,al-nand";
 *     reg = <0x0 0xXXXXXXXX 0x0 0x1000>;
 *     status = "okay";
 * };
 */
